---
import PlatformPage from "@/components/cine/PlatformPage.astro"
import {
  getPlatformPages,
  isPlatformsHub,
  platformSlug,
  type PlatformPage as Page,
} from "@/lib/plataformas"

export async function getStaticPaths() {
  const pages = await getPlatformPages("en")
  return pages
    .filter((page) => !isPlatformsHub(page))
    .map((page) => ({ params: { slug: platformSlug(page) }, props: { page } }))
}

const { page } = Astro.props as { page: Page }
---

<PlatformPage page={page} />
