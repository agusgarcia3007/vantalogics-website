---
import SolutionPage from "@/components/site/SolutionPage.astro"
import { SOLUTIONS } from "@/data/solutions"

export function getStaticPaths() {
  return SOLUTIONS.map((solution) => ({
    params: { slug: solution.slug.en },
    props: { solution },
  }))
}

const { solution } = Astro.props
---

<SolutionPage lang="en" solution={solution} />
