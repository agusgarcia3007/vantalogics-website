---
import Frame from "@/components/site/Frame.astro"
import SectionTitle from "@/components/site/SectionTitle.astro"
import { useTranslations, type Lang } from "@/i18n"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang).faq
---

<Frame id="faq" labelledby="faq-titulo">
  <div
    class="grid gap-x-[clamp(32px,5vw,72px)] gap-y-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1fr)]"
  >
    <SectionTitle
      id="faq-titulo"
      label={t.label}
      muted={t.titleMuted}
      bright={t.titleBright}
    />

    <div>
      {
        t.entries.map((entry, i) => (
          <details
            id={`faq-${lang}-${i + 1}`}
            name={`faq-${lang}`}
            class="faq group border-b border-hairline first:border-t"
            data-reveal
            style={`--reveal-delay: ${i * 50}ms;`}
          >
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-[18px] [&::-webkit-details-marker]:hidden">
              <h3 class="max-w-[42ch] font-untitled text-[17px] leading-snug text-bone transition-opacity duration-(--duration-state) ease-(--ease-opx) group-hover:opacity-70">
                {entry.question}
              </h3>
              <span class="relative mt-[6px] size-[14px] shrink-0" aria-hidden="true">
                <span class="absolute top-1/2 left-0 h-px w-[14px] -translate-y-1/2 bg-ash" />
                <span class="absolute top-1/2 left-0 h-px w-[14px] -translate-y-1/2 rotate-90 bg-ash transition-transform duration-(--duration-state) ease-(--ease-opx) group-open:rotate-0" />
              </span>
            </summary>

            <div class="faq-panel pb-[22px]">
              <p class="copy max-w-[64ch] text-ash">{entry.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</Frame>

<style>
  @media (prefers-reduced-motion: no-preference) {
    details[open] .faq-panel {
      animation: faq-in 300ms cubic-bezier(0.455, 0.03, 0.515, 0.955) both;
    }
  }

  @keyframes faq-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
