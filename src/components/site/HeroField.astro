---
// El campo de puntos del hero.
//
// Lo que se sirve es una hoja de puntos en CSS: cero bytes de JavaScript,
// igual que el resto del sitio, y es lo único que ven quienes tienen WebGL
// deshabilitado, pidieron menos movimiento o navegan con el teclado. El módulo
// de WebGL —que es el mismo dibujo, pero reaccionando al cursor— entra después
// del primer pintado y sólo si hay puntero fino y hay con qué dibujarlo.
//
// El lienzo no recibe eventos: la escucha del puntero la hace el contenedor,
// que es el que define el área. Así los enlaces y el texto de encima siguen
// siendo lo que recibe los clics.
---

<div
  class="paper-grid pointer-events-none absolute inset-0 overflow-hidden [mask-image:radial-gradient(120%_100%_at_50%_35%,black_45%,transparent_100%)] data-ready:bg-none"
  data-hero-field
  aria-hidden="true"
>
  <canvas
    class="size-full opacity-0 transition-opacity duration-700 ease-paper"
    data-hero-canvas></canvas>
</div>

<script>
  const host = document.querySelector<HTMLElement>("[data-hero-field]")
  const canvas = host?.querySelector<HTMLCanvasElement>("[data-hero-canvas]")

  const fine = window.matchMedia("(pointer: fine)").matches
  const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches

  if (host && canvas && fine && !calm) {
    const start = () => {
      import("@/lib/hero-field")
        .then(({ createHeroField }) => {
          const field = createHeroField({ canvas, host })
          // El canvas aparece con un fundido y recién ahí se apaga la grilla de
          // CSS: si se apagara antes, el papel parpadearía en blanco.
          canvas.classList.remove("opacity-0")
          host.dataset.ready = ""
          window.addEventListener("pagehide", () => field.dispose(), {
            once: true,
          })
        })
        .catch(() => {
          /* Sin WebGL o sin red: se queda la grilla de CSS, que ya está. */
        })
    }

    // Después del primer pintado. El hero tiene que ser texto antes que efecto.
    if ("requestIdleCallback" in window) {
      requestIdleCallback(start, { timeout: 1200 })
    } else {
      setTimeout(start, 200)
    }
  }
</script>
