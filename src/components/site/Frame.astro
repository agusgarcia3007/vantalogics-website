---
interface Props {
  id?: string
  /** Sin la regla superior: sólo para el primer bloque bajo el encabezado. */
  flush?: boolean
  class?: string
  labelledby?: string
}

const { id, flush = false, class: className = "", labelledby } = Astro.props

// El marco de la página.
//
// Toda la landing vive dentro de una misma columna de 1180px con dos hairlines
// verticales que la recorren de arriba a abajo, y cada sección cierra con una
// regla horizontal que va exactamente de un hairline al otro. Es lo que
// convierte una pila de secciones sueltas en un documento: el ojo tiene un
// borde contra el cual medir todo lo demás, y el fondo a sangre queda como
// margen de la página en vez de como vacío.
---

<section
  id={id}
  aria-labelledby={labelledby}
  class:list={[
    "mx-auto w-full max-w-[1180px] scroll-mt-4 border-x border-hairline",
    className,
  ]}
>
  <div
    class:list={[
      "px-[clamp(20px,4vw,56px)] py-[clamp(56px,7.5vw,104px)]",
      !flush && "border-t border-hairline",
    ]}
  >
    <slot />
  </div>
</section>
