---
interface Props {
  id?: string
  flush?: boolean
  class?: string
  labelledby?: string
}

const { id, flush = false, class: className = "", labelledby } = Astro.props
---

<section
  id={id}
  aria-labelledby={labelledby}
  class:list={["shell scroll-mt-[calc(var(--header-h)+16px)]", className]}
>
  <div
    class:list={[
      "py-[clamp(56px,7.5vw,104px)]",
      !flush && "border-t border-iron",
    ]}
  >
    <slot />
  </div>
</section>
