---
import Frame from "@/components/site/Frame.astro"
import SectionTitle from "@/components/site/SectionTitle.astro"
import { useTranslations, type Lang } from "@/i18n"
import { CASES } from "@/data/cases"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang).cases

// La sección de casos.
//
// Se imprime sola desde `src/data/cases.ts` y no existe mientras no haya
// ninguno publicado: una grilla de «próximamente» le cuesta credibilidad a una
// agencia más de lo que le cuesta no tener la sección. En desarrollo sí
// aparece un recordatorio, para que quede a la vista que el bloque existe y
// está esperando contenido.
const cases = CASES
const showPlaceholder = cases.length === 0 && import.meta.env.DEV
---

{
  (cases.length > 0 || showPlaceholder) && (
    <Frame id="casos" labelledby="casos-titulo">
      <div class="grid gap-x-[clamp(32px,5vw,80px)] gap-y-8 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1fr)]">
        <SectionTitle
          id="casos-titulo"
          index="03"
          label={t.label}
          muted={t.titleMuted}
          bright={t.titleBright}
        />
        <p
          class="copy max-w-[52ch] self-end text-ash"
          data-reveal
          style="--reveal-delay: 100ms;"
        >
          {t.intro}
        </p>
      </div>

      {showPlaceholder && (
        <p class="mt-12 border border-dashed border-pen p-6 font-mono text-caption text-pen-ink">
          Sólo en desarrollo: no hay casos cargados. Agregá el primero en
          <code> src/data/cases.ts</code> y esta sección aparece en producción.
        </p>
      )}

      <div class="mt-[clamp(44px,5vw,72px)] flex flex-col">
        {cases.map((item, i) => (
          <article
            class="grid gap-x-[clamp(24px,4vw,64px)] gap-y-8 border-t border-hairline py-[clamp(32px,4vw,56px)] last:border-b lg:grid-cols-[minmax(0,1fr)_minmax(0,0.75fr)]"
            data-reveal
            style={`--reveal-delay: ${i * 80}ms;`}
          >
            <div>
              <p class="label-mono text-faint">{item.client[lang]}</p>

              <h3 class="display-sm mt-4 max-w-[24ch] text-bone">
                {item.headline[lang]}
              </h3>

              <div class="mt-7 grid gap-x-10 gap-y-6 sm:grid-cols-2">
                <div>
                  <p class="label-mono-sm text-faint">{t.contextLabel}</p>
                  <p class="copy mt-3 max-w-[40ch] text-[15px] text-ash">
                    {item.context[lang]}
                  </p>
                </div>
                <div>
                  <p class="label-mono-sm text-faint">{t.workLabel}</p>
                  <p class="copy mt-3 max-w-[40ch] text-[15px] text-ash">
                    {item.work[lang]}
                  </p>
                </div>
              </div>

              {item.stack.length > 0 && (
                <p class="mt-7 flex flex-wrap items-center gap-x-3 gap-y-2">
                  <span class="label-mono-sm text-faint">{t.stackLabel}</span>
                  {item.stack.map((tool) => (
                    <span class="border border-hairline px-[9px] py-[3px] font-mono text-micro text-ash">
                      {tool}
                    </span>
                  ))}
                </p>
              )}
            </div>

            {/* Las cifras, en la columna de la derecha y en serif grande: es
                lo único del sitio que se imprime a escala de titular sin ser
                un titular, porque es lo único que el lector vino a buscar. */}
            <dl class="flex flex-col justify-center gap-6 border-s border-hairline ps-[clamp(20px,2.5vw,36px)]">
              <dt class="sr-only">{t.resultLabel}</dt>
              {item.results.map((result) => (
                <dd>
                  <span
                    class="block font-display text-[clamp(2.25rem,3.6vw,3rem)] leading-none text-pen-ink"
                    data-numeral
                  >
                    {result.value}
                  </span>
                  <span class="mt-2 block copy text-[15px] text-ash">
                    {result.label[lang]}
                  </span>
                </dd>
              ))}
            </dl>
          </article>
        ))}
      </div>
    </Frame>
  )
}
