---
import Layout from "@/layouts/main.astro"
import Chrome from "@/components/cine/Chrome.astro"
import Foot from "@/components/cine/Foot.astro"
import LinkCard from "@/components/cine/LinkCard.astro"
import NextStep from "@/components/cine/NextStep.astro"
import { LANGS, localizePath, useTranslations, type Lang } from "@/i18n"
import {
  solutionPath,
  solutionsIndexPath,
  type Solution,
} from "@/data/solutions"
import { casePath, casesFor, type UseCase } from "@/data/use-cases"

interface Props {
  lang: Lang
  solution: Solution
  useCase: UseCase
}

const SITE = "https://vantalogics.com"
const { lang, solution, useCase } = Astro.props
const t = useTranslations(lang)

const path = casePath(lang, solution, useCase)
const pageUrl = new URL(path, SITE).href
const sectorPath = solutionPath(lang, solution)
const indexPath = solutionsIndexPath(lang)

/** Los otros casos del mismo sector. El enlace lateral del silo. */
const siblings = casesFor(solution).filter(
  (other) => other.slug.es !== useCase.slug.es
)

const service = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${pageUrl}#service`,
  name: useCase.title[lang],
  description: useCase.answer[lang],
  serviceType: useCase.title[lang],
  provider: { "@id": `${SITE}/#organization` },
  audience: { "@type": "BusinessAudience", name: solution.sector[lang] },
  inLanguage: lang,
  url: pageUrl,
  /**
   * `isPartOf` apuntando a la página de sector.
   *
   * Es la declaración que convierte ocho páginas sueltas en dos silos. Sin
   * ella, un motor de respuesta que llega por «agente de whatsapp para real
   * estate developers» no tiene forma de saber que existe una página más
   * general del mismo autor sobre el mismo rubro.
   */
  isPartOf: { "@id": `${new URL(sectorPath, SITE).href}#service` },
}

const steps = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${pageUrl}#pasos`,
  name: t.solutions.stepsLabel,
  itemListOrder: "https://schema.org/ItemListOrderAscending",
  itemListElement: useCase.steps.map((step, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: step.title[lang],
    description: step.detail[lang],
  })),
}

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Vantalogics",
      item: new URL(localizePath(lang), SITE).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: t.solutions.breadcrumb,
      item: new URL(indexPath, SITE).href,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: solution.sector[lang],
      item: new URL(sectorPath, SITE).href,
    },
    {
      "@type": "ListItem",
      position: 4,
      name: useCase.title[lang],
      item: pageUrl,
    },
  ],
}

const faqPage = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${pageUrl}#faq`,
  inLanguage: lang,
  mainEntity: useCase.faq.map((entry) => ({
    "@type": "Question",
    name: entry.question[lang],
    acceptedAnswer: { "@type": "Answer", text: entry.answer[lang] },
  })),
}

const lists = [
  {
    id: "medicion",
    label: t.solutions.measuresLabel,
    items: useCase.measures[lang],
  },
  {
    id: "requisitos",
    label: t.solutions.requiresLabel,
    items: useCase.requires[lang],
  },
  {
    id: "cuando-no",
    label: t.solutions.notThisLabel,
    items: useCase.notThis[lang],
  },
]
---

<Layout
  lang={lang}
  path={path}
  title={`${useCase.title[lang]} — Vantalogics`}
  description={useCase.description[lang]}
  alternates={Object.fromEntries(
    LANGS.map((code) => [code, casePath(code, solution, useCase)])
  )}
  jsonLd={[service, steps, breadcrumb, faqPage]}
  floating={false}
>
  <Chrome lang={lang}>
    <main class="doc-page" id="contenido">
      <div class="shell">
        <nav class="crumbs appear appear--soft" aria-label="Breadcrumb">
          <a href={localizePath(lang)}>Vantalogics</a>
          <span aria-hidden="true">/</span>
          <a href={indexPath}>{t.solutions.breadcrumb}</a>
          <span aria-hidden="true">/</span>
          <a href={sectorPath}>{solution.sector[lang]}</a>
        </nav>

        <div class="doc-head">
          <span class="appear appear--scale eyebrow" style="--d:0.2s">
            {solution.sector[lang]}
          </span>
          <h1 class="appear appear--soft" style="--d:0.3s">
            {useCase.title[lang]}
          </h1>
          {
            useCase.intro[lang].map((paragraph) => (
              <p class="appear appear--soft" style="--d:0.42s">
                {paragraph}
              </p>
            ))
          }
        </div>
      </div>
    </main>

    <div class="below" slot="after">
      <section class="section">
        <div class="shell">
          <div class="answer reveal">
            <p class="answer-label">{t.blog.answerLabel}</p>
            <p class="answer-body">{useCase.answer[lang]}</p>
          </div>
        </div>
      </section>

      <section class="section" aria-labelledby="pasos">
        <div class="shell">
          <div class="section-head reveal">
            <h2 id="pasos">{t.solutions.stepsLabel}</h2>
          </div>
          <div class="steps">
            {
              useCase.steps.map((step, index) => (
                <div class="step reveal" style={`--i:${index}`}>
                  <span class="step-n">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <div>
                    <h3>{step.title[lang]}</h3>
                    <p>{step.detail[lang]}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      {
        lists.map((list) => (
          <section class="section" aria-labelledby={list.id}>
            <div class="shell">
              <div class="section-head reveal">
                <h2 id={list.id}>{list.label}</h2>
              </div>
              <div class="components reveal">
                <ul>
                  {list.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            </div>
          </section>
        ))
      }

      <section class="section" aria-labelledby="preguntas">
        <div class="shell">
          <div class="section-head reveal">
            <h2 id="preguntas">{t.blog.faqLabel}</h2>
          </div>
          <dl class="faq">
            {
              useCase.faq.map((entry, index) => (
                <div class="faq-item reveal" style={`--i:${index}`}>
                  <dt>{entry.question[lang]}</dt>
                  <dd>{entry.answer[lang]}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      {
        siblings.length > 0 && (
          <section class="section" aria-labelledby="otros-casos">
            <div class="shell">
              <div class="section-head reveal">
                <h2 id="otros-casos">{t.solutions.useCasesLabel}</h2>
              </div>
              <div class="posts">
                {siblings.map((other, index) => (
                  <LinkCard
                    href={casePath(lang, solution, other)}
                    title={other.title[lang]}
                    description={other.description[lang]}
                    featured={siblings.length % 2 === 1 && index === 0}
                    index={index}
                  />
                ))}
              </div>
            </div>
          </section>
        )
      }

      <NextStep
        lang={lang}
        back={{ href: sectorPath, label: t.solutions.backToSector }}
      />

      <Foot lang={lang} />
    </div>
  </Chrome>
</Layout>
