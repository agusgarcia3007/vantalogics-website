---
import Layout from "@/layouts/main.astro"
import SiteHeader from "@/components/site/SiteHeader.astro"
import SiteFooter from "@/components/site/SiteFooter.astro"
import CallToAction from "@/components/site/CallToAction.astro"
import Frame from "@/components/site/Frame.astro"
import Cta from "@/components/site/Cta.astro"
import { LANGS, localizePath, useTranslations, type Lang } from "@/i18n"
import {
  solutionPath,
  solutionsIndexPath,
  type Solution,
} from "@/data/solutions"
import { casePath, casesFor, type UseCase } from "@/data/use-cases"
import { SCHEDULE_URL } from "@/site"

interface Props {
  lang: Lang
  solution: Solution
  useCase: UseCase
}

const SITE = "https://vantalogics.com"
const { lang, solution, useCase } = Astro.props
const t = useTranslations(lang)

const path = casePath(lang, solution, useCase)
const pageUrl = new URL(path, SITE).href
const sectorPath = solutionPath(lang, solution)
const indexPath = solutionsIndexPath(lang)

/** Los otros casos del mismo sector. El enlace lateral del silo. */
const siblings = casesFor(solution).filter(
  (other) => other.slug.es !== useCase.slug.es
)

const service = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${pageUrl}#service`,
  name: useCase.title[lang],
  description: useCase.answer[lang],
  serviceType: useCase.title[lang],
  provider: { "@id": `${SITE}/#organization` },
  audience: { "@type": "BusinessAudience", name: solution.sector[lang] },
  inLanguage: lang,
  url: pageUrl,
  /**
   * `isPartOf` apuntando a la página de sector.
   *
   * Es la declaración que convierte ocho páginas sueltas en dos silos. Sin
   * ella, un motor de respuesta que llega por «agente de whatsapp para
   * inmobiliarias» no tiene forma de saber que existe una página más general
   * del mismo autor sobre el mismo rubro.
   */
  isPartOf: { "@id": `${new URL(sectorPath, SITE).href}#service` },
}

const steps = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${pageUrl}#pasos`,
  name: t.solutions.stepsLabel,
  itemListOrder: "https://schema.org/ItemListOrderAscending",
  itemListElement: useCase.steps.map((step, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: step.title[lang],
    description: step.detail[lang],
  })),
}

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Vantalogics",
      item: new URL(localizePath(lang), SITE).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: t.solutions.breadcrumb,
      item: new URL(indexPath, SITE).href,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: solution.sector[lang],
      item: new URL(sectorPath, SITE).href,
    },
    {
      "@type": "ListItem",
      position: 4,
      name: useCase.title[lang],
      item: pageUrl,
    },
  ],
}

const faqPage = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${pageUrl}#faq`,
  inLanguage: lang,
  mainEntity: useCase.faq.map((entry) => ({
    "@type": "Question",
    name: entry.question[lang],
    acceptedAnswer: { "@type": "Answer", text: entry.answer[lang] },
  })),
}

// Los dos bloques de lista comparten tratamiento, como en la página de sector.
const lists = [
  { label: t.solutions.measuresLabel, items: useCase.measures[lang] },
  { label: t.solutions.requiresLabel, items: useCase.requires[lang] },
]
---

<Layout
  lang={lang}
  path={path}
  title={`${useCase.title[lang]} — Vantalogics`}
  description={useCase.description[lang]}
  alternates={Object.fromEntries(
    LANGS.map((code) => [code, casePath(code, solution, useCase)])
  )}
  jsonLd={[service, steps, breadcrumb, faqPage]}
>
  <SiteHeader lang={lang} />

  <main id="contenido">
    <Frame flush>
      <nav aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-2">
          <li>
            <a
              href={localizePath(lang)}
              class="label-untitled text-ash transition-colors duration-(--duration-state) ease-(--ease-opx) hover:text-bone"
            >
              Vantalogics
            </a>
          </li>
          <li class="label-untitled text-muted-ash" aria-hidden="true">/</li>
          <li>
            <a
              href={indexPath}
              class="label-untitled text-ash transition-colors duration-(--duration-state) ease-(--ease-opx) hover:text-bone"
            >
              {t.solutions.breadcrumb}
            </a>
          </li>
          <li class="label-untitled text-muted-ash" aria-hidden="true">/</li>
          <li>
            <a
              href={sectorPath}
              class="label-untitled text-ash transition-colors duration-(--duration-state) ease-(--ease-opx) hover:text-bone"
            >
              {solution.sector[lang]}
            </a>
          </li>
        </ol>
      </nav>

      <h1
        class="mt-[clamp(32px,5vw,64px)] max-w-[20ch] display-lg text-balance text-bone"
      >
        {useCase.title[lang]}
      </h1>

      <div class="mt-[30px] flex max-w-[62ch] flex-col gap-5">
        {
          useCase.intro[lang].map((paragraph) => (
            <p class="copy text-ash">{paragraph}</p>
          ))
        }
      </div>
    </Frame>

    <Frame>
      <div
        class="max-w-[62ch] border-l border-hairline ps-[clamp(20px,2.5vw,32px)]"
        data-reveal
      >
        <p class="label-untitled text-muted-ash">{t.blog.answerLabel}</p>
        <p class="mt-4 text-[clamp(18px,1.7vw,21px)] leading-[1.55] text-bone">
          {useCase.answer[lang]}
        </p>
      </div>
    </Frame>

    <Frame labelledby="pasos">
      <h2 id="pasos" class="max-w-[20ch] display-section text-bone" data-reveal>
        {t.solutions.stepsLabel}
      </h2>

      <ol class="mt-[clamp(28px,3.5vw,48px)] flex max-w-[68ch] flex-col">
        {
          useCase.steps.map((step, index) => (
            <li
              class="flex gap-5 border-t border-hairline py-7 first:border-t-0 first:pt-0"
              data-reveal
              style={`--reveal-delay: ${index * 60}ms;`}
            >
              <span class="shrink-0 label-untitled text-muted-ash">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div>
                <h3 class="text-[clamp(18px,1.7vw,21px)] leading-[1.3] text-bone">
                  {step.title[lang]}
                </h3>
                <p class="mt-3 max-w-[52ch] copy text-ash">
                  {step.detail[lang]}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </Frame>

    <Frame>
      <div
        class="grid gap-x-[clamp(32px,5vw,72px)] gap-y-[clamp(40px,5vw,64px)] md:grid-cols-2"
      >
        {
          lists.map((list) => (
            <div data-reveal>
              <h2 class="label-untitled text-muted-ash">{list.label}</h2>
              <ul class="mt-5 flex flex-col gap-3">
                {list.items.map((item) => (
                  <li class="flex gap-3 copy text-ash">
                    <span aria-hidden="true" class="text-muted-ash">
                      —
                    </span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </Frame>

    <!-- Cuándo no conviene. Mismo criterio que en la página de sector: es la
         sección que sólo puede escribir alguien que hizo el trabajo, y es lo
         que separa una página programática de una granja de contenido. -->
    <Frame labelledby="cuando-no">
      <h2
        id="cuando-no"
        class="max-w-[20ch] display-section text-bone"
        data-reveal
      >
        {t.solutions.notThisLabel}
      </h2>
      <ul class="mt-[clamp(28px,3.5vw,48px)] flex max-w-[62ch] flex-col">
        {
          useCase.notThis[lang].map((item) => (
            <li class="border-t border-hairline py-6 copy text-ash first:border-t-0 first:pt-0">
              {item}
            </li>
          ))
        }
      </ul>
    </Frame>

    <Frame labelledby="faq-caso">
      <h2
        id="faq-caso"
        class="max-w-[20ch] display-section text-bone"
        data-reveal
      >
        {t.blog.faqLabel}
      </h2>
      <dl class="mt-[clamp(28px,3.5vw,48px)] flex max-w-[68ch] flex-col">
        {
          useCase.faq.map((entry) => (
            <div class="border-t border-hairline py-7 first:border-t-0 first:pt-0">
              <dt class="text-[clamp(17px,1.5vw,19px)] leading-[1.4] text-bone">
                {entry.question[lang]}
              </dt>
              <dd class="mt-3 copy text-ash">{entry.answer[lang]}</dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-[clamp(32px,4vw,56px)] flex flex-wrap gap-3">
        <Cta
          href={SCHEDULE_URL}
          variant="pill-solid"
          size="pill-lg"
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.blog.ctaButton}
        </Cta>
        <Cta href={sectorPath} variant="pill-quiet" size="pill-lg">
          {t.solutions.backToSector}
        </Cta>
      </div>
    </Frame>

    {
      siblings.length > 0 && (
        <Frame labelledby="otros-casos">
          <h2
            id="otros-casos"
            class="max-w-[24ch] display-section text-bone"
            data-reveal
          >
            {t.solutions.useCasesLabel}
          </h2>
          <ul class="mt-[clamp(28px,3.5vw,48px)] grid gap-x-[clamp(32px,5vw,72px)] md:grid-cols-2">
            {siblings.map((other, index) => (
              <li
                class="group relative border-t border-hairline py-7 md:[&:nth-child(-n+2)]:border-t-0 md:[&:nth-child(-n+2)]:pt-0"
                data-reveal
                style={`--reveal-delay: ${index * 50}ms;`}
              >
                <h3 class="text-[clamp(18px,1.7vw,21px)] leading-[1.3] text-bone">
                  <a
                    href={casePath(lang, solution, other)}
                    class="transition-opacity duration-(--duration-state) ease-(--ease-opx) group-hover:opacity-70 before:absolute before:inset-0 before:content-['']"
                  >
                    {other.title[lang]}
                  </a>
                </h3>
                <p class="mt-3 max-w-[44ch] copy text-ash">
                  {other.description[lang]}
                </p>
              </li>
            ))}
          </ul>
        </Frame>
      )
    }

    <CallToAction lang={lang} />
  </main>

  <SiteFooter lang={lang} />
</Layout>
