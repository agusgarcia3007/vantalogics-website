---
import Layout from "@/layouts/main.astro"
import Chrome from "@/components/cine/Chrome.astro"
import Foot from "@/components/cine/Foot.astro"
import LinkCard from "@/components/cine/LinkCard.astro"
import NextStep from "@/components/cine/NextStep.astro"
import { LANGS, localizePath, useTranslations, type Lang } from "@/i18n"
import {
  FOCUS_SOLUTIONS,
  solutionPath,
  solutionsIndexPath,
} from "@/data/solutions"
import { casePath, casesFor } from "@/data/use-cases"
import {
  CASES,
  CASES_INDEX,
  casesIndexPath,
  formatTotalStudents,
} from "@/data/cases"
import { getPlatformPages, platformPath } from "@/lib/plataformas"

interface Props {
  lang: Lang
}

const SITE = "https://vantalogics.com"
const { lang } = Astro.props
const t = useTranslations(lang)

const path = solutionsIndexPath(lang)
const pageUrl = new URL(path, SITE).href

const platformPages = await getPlatformPages(lang)
const casesPath = casesIndexPath(lang)
const casesCopy = lang === "es" || lang === "en" ? CASES_INDEX[lang] : null

const listed = [
  ...FOCUS_SOLUTIONS.flatMap((solution) => [
    { name: solution.title[lang], path: solutionPath(lang, solution) },
    ...casesFor(solution).map((useCase) => ({
      name: useCase.title[lang],
      path: casePath(lang, solution, useCase),
    })),
  ]),
  ...platformPages.map((page) => ({
    name: page.data.title,
    path: platformPath(page),
  })),
  ...(casesPath && casesCopy
    ? [{ name: casesCopy.title, path: casesPath }]
    : []),
]

const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${pageUrl}#list`,
  name: t.solutions.indexTitle,
  itemListElement: listed.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.name,
    url: new URL(item.path, SITE).href,
  })),
}

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Vantalogics",
      item: new URL(localizePath(lang), SITE).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: t.solutions.breadcrumb,
      item: pageUrl,
    },
  ],
}
---

<Layout
  lang={lang}
  path={path}
  title={`${t.solutions.indexTitle} — Vantalogics`}
  description={t.solutions.indexDescription}
  alternates={Object.fromEntries(
    LANGS.map((code) => [code, solutionsIndexPath(code)])
  )}
  jsonLd={[itemList, breadcrumb]}
  floating={false}
>
  <Chrome lang={lang}>
    <main class="doc-page" id="contenido">
      <div class="shell">
        <nav class="crumbs appear appear--soft" aria-label="Breadcrumb">
          <a href={localizePath(lang)}>Vantalogics</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{t.solutions.breadcrumb}</span>
        </nav>

        <div class="doc-head">
          <span class="appear appear--scale eyebrow" style="--d:0.2s">
            {t.solutions.focusLabel}
          </span>
          <h1 class="appear appear--soft" style="--d:0.3s">
            {t.solutions.indexTitle}
          </h1>
          <p class="appear appear--soft" style="--d:0.42s">
            {t.solutions.indexIntro}
          </p>
          <p class="appear appear--soft" style="--d:0.5s">
            {t.solutions.indexScope}
          </p>
        </div>
      </div>
    </main>

    <div class="below" slot="after">
      {
        FOCUS_SOLUTIONS.map((solution) => (
          <section class="section">
            <div class="shell">
              <div class="posts">
                <LinkCard
                  href={solutionPath(lang, solution)}
                  eyebrow={solution.sector[lang]}
                  title={solution.title[lang]}
                  description={solution.description[lang]}
                  featured
                />
                {casesFor(solution).map((useCase, index) => (
                  <LinkCard
                    href={casePath(lang, solution, useCase)}
                    title={useCase.title[lang]}
                    description={useCase.description[lang]}
                    index={index + 1}
                  />
                ))}
              </div>
            </div>
          </section>
        ))
      }

      {
        platformPages.length > 0 && (
          <section class="section">
            <div class="shell">
              <div class="section-head reveal">
                <span class="eyebrow">{t.solutions.platformEyebrow}</span>
                <h2>{t.solutions.platformTitle}</h2>
              </div>
              <div class="posts">
                {platformPages.map((page, index) => (
                  <LinkCard
                    href={platformPath(page)}
                    title={page.data.title}
                    description={page.data.description}
                    featured={index === 0}
                    index={index}
                  />
                ))}
                {casesPath && casesCopy && (
                  <LinkCard
                    href={casesPath}
                    title={casesCopy.title}
                    description={casesCopy.description(
                      CASES.length,
                      formatTotalStudents(lang)
                    )}
                    index={platformPages.length}
                  />
                )}
              </div>
            </div>
          </section>
        )
      }

      <NextStep lang={lang} />

      <Foot lang={lang} />
    </div>
  </Chrome>
</Layout>
