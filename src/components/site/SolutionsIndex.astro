---
import Layout from "@/layouts/main.astro"
import SiteHeader from "@/components/site/SiteHeader.astro"
import SiteFooter from "@/components/site/SiteFooter.astro"
import CallToAction from "@/components/site/CallToAction.astro"
import Frame from "@/components/site/Frame.astro"
import Cta from "@/components/site/Cta.astro"
import PostCard from "@/components/blog/PostCard.astro"
import { LANGS, localizePath, useTranslations, type Lang } from "@/i18n"
import { EDTECH, solutionPath, solutionsIndexPath } from "@/data/solutions"
import { casePath, casesFor } from "@/data/use-cases"
import { getPostsByIndustry } from "@/lib/blog"

interface Props {
  lang: Lang
}

const SITE = "https://vantalogics.com"
const { lang } = Astro.props
const t = useTranslations(lang)

const path = solutionsIndexPath(lang)
const pageUrl = new URL(path, SITE).href
const sectorPath = solutionPath(lang, EDTECH)
const useCases = casesFor(EDTECH)
const posts = await getPostsByIndustry(lang, EDTECH.slug.es)
const alternates = Object.fromEntries(
  LANGS.map((code) => [code, solutionsIndexPath(code)])
) as Record<Lang, string>

// El índice del sector.
//
// Con una sola vertical, esta página no es una lista de rubros: es la puerta
// de entrada al silo. Responde la consulta de investigación —«cómo se integra
// IA en una plataforma educativa»— y desde ahí baja a las cuatro
// implementaciones, que es donde está la intención de compra.
const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${pageUrl}#list`,
  name: t.solutions.useCasesLabel,
  itemListElement: useCases.map((useCase, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: useCase.title[lang],
    url: new URL(casePath(lang, EDTECH, useCase), SITE).href,
  })),
}

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Vantalogics",
      item: new URL(localizePath(lang), SITE).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: t.solutions.breadcrumb,
      item: pageUrl,
    },
  ],
}
---

<Layout
  lang={lang}
  path={path}
  title={`${t.solutions.indexTitle} — Vantalogics`}
  description={t.solutions.indexDescription}
  alternates={alternates}
  jsonLd={[itemList, breadcrumb]}
>
  <SiteHeader lang={lang} alternates={alternates} />

  <main id="contenido">
    <Frame flush>
      <nav aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-2">
          <li>
            <a
              href={localizePath(lang)}
              class="label-mono-sm text-ash transition-colors duration-(--duration-state) ease-paper hover:text-bone"
            >
              Vantalogics
            </a>
          </li>
          <li class="label-mono-sm text-faint" aria-hidden="true">/</li>
          <li class="label-mono-sm text-faint" aria-current="page">
            {t.solutions.breadcrumb}
          </li>
        </ol>
      </nav>

      <h1
        class="mt-[clamp(32px,5vw,64px)] max-w-[18ch] display-lg text-balance text-bone"
      >
        {t.solutions.indexTitle}
      </h1>

      <p class="copy-lead mt-8 max-w-[58ch] text-ash">
        {t.solutions.indexIntro}
      </p>

      <div class="mt-10 flex flex-wrap gap-3">
        <Cta href={sectorPath} variant="solid" size="lg">
          {t.solutions.backToSector}
        </Cta>
      </div>
    </Frame>

    <Frame labelledby="implementaciones" class="bg-canvas">
      <h2 id="implementaciones" class="display-section max-w-[24ch] text-bone" data-reveal>
        {t.solutions.useCasesLabel}
      </h2>

      <p class="copy mt-6 max-w-[62ch] text-ash" data-reveal>
        {t.solutions.useCasesIntro}
      </p>

      <ul class="mt-[clamp(36px,4.5vw,64px)] flex flex-col">
        {
          useCases.map((useCase, index) => (
            <li
              class="use-case group relative grid gap-x-[clamp(24px,4vw,64px)] gap-y-3 border-t border-hairline py-[clamp(24px,3vw,36px)] last:border-b md:grid-cols-[auto_minmax(0,1fr)]"
              data-reveal
              style={`--reveal-delay: ${index * 60}ms;`}
            >
              <span class="label-mono-sm pt-[7px] text-pen-ink md:w-10" data-numeral>
                {String(index + 1).padStart(2, "0")}
              </span>

              <div>
                <h3 class="display-sm max-w-[28ch] text-bone">
                  <a
                    href={casePath(lang, EDTECH, useCase)}
                    class="transition-colors duration-(--duration-state) ease-paper group-hover:text-pen-ink before:absolute before:inset-0 before:content-['']"
                  >
                    {useCase.title[lang]}
                  </a>
                </h3>
                <p class="copy mt-3 max-w-[56ch] text-[15px] text-ash">
                  {useCase.description[lang]}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </Frame>

    {
      posts.length > 0 && (
        <Frame labelledby="notas-sector">
          <h2
            id="notas-sector"
            class="display-section max-w-[24ch] text-bone"
            data-reveal
          >
            {t.solutions.othersLabel}
          </h2>
          <div class="mt-[clamp(28px,3.5vw,48px)] flex flex-col">
            {posts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </Frame>
      )
    }

    <CallToAction lang={lang} />
  </main>

  <SiteFooter lang={lang} />
</Layout>

<style>
  .use-case {
    transition: background-color var(--duration-state) var(--ease-paper);
  }

  @media (hover: hover) {
    .use-case:hover {
      background-color: var(--color-surface);
    }
  }
</style>
