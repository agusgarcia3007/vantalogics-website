---
import { META_PIXEL_ID } from "@/site"

const pixelId = META_PIXEL_ID

const snippet = `!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version="2.0";n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,"script","https://connect.facebook.net/en_US/fbevents.js");
fbq("init",${JSON.stringify(pixelId)});
fbq("track","PageView");
document.addEventListener("click",function(event){var link=event.target.closest&&event.target.closest("a[href]");if(!link)return;var href=link.href;if(href.indexOf("https://cal.com/")===0)fbq("track","Schedule");else if(href.indexOf("https://wa.me/")===0||href.indexOf("mailto:")===0)fbq("track","Contact")});`
---

{
  pixelId && (
    <>
      <script is:inline set:html={snippet} />
      <noscript>
        <img
          height="1"
          width="1"
          style="display:none"
          alt=""
          src={`https://www.facebook.com/tr?id=${pixelId}&ev=PageView&noscript=1`}
        />
      </noscript>
    </>
  )
}
