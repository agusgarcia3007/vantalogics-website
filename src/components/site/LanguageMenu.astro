---
import { HugeiconsIcon } from "@hugeicons/react"
import { ArrowDown01Icon, Tick02Icon } from "@hugeicons/core-free-icons"

import {
  dictionaries,
  PUBLIC_LANGS,
  localizePath,
  useTranslations,
  type Lang,
} from "@/i18n"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
---

<details class="group relative" data-lang-menu>
  <summary
    class="flex h-9 cursor-pointer list-none items-center gap-[6px] rounded-full px-3 eyebrow text-ash transition-colors duration-(--duration-state) ease-(--ease-out) group-open:bg-iron group-open:text-bone hover:bg-iron hover:text-bone [&::-webkit-details-marker]:hidden"
    aria-label={t.language.label}
  >
    <span aria-hidden="true">{lang.toUpperCase()}</span>
    <HugeiconsIcon
      icon={ArrowDown01Icon}
      size={13}
      strokeWidth={1.5}
      className="shrink-0 transition-transform duration-(--duration-state) ease-(--ease-opx) group-open:rotate-180"
    />
  </summary>

  <div
    class="absolute end-0 top-[calc(100%+8px)] z-50 min-w-[180px] origin-top-right rounded-[8px] border border-iron bg-graphite p-1"
  >
    <ul class="flex flex-col">
      {
        PUBLIC_LANGS.map((code) => (
          <li>
            <a
              href={localizePath(code)}
              hreflang={code}
              lang={code}
              aria-current={code === lang ? "true" : undefined}
              class="flex items-center justify-between gap-5 rounded-[6px] px-3 py-2 label-untitled text-ash transition-colors duration-(--duration-state) ease-(--ease-out) hover:bg-iron hover:text-bone aria-[current]:text-bone"
            >
              <span>{dictionaries[code].language.name}</span>
              {code === lang ? (
                <HugeiconsIcon
                  icon={Tick02Icon}
                  size={14}
                  strokeWidth={1.5}
                  className="shrink-0 text-soft-indigo"
                />
              ) : (
                <span class="eyebrow text-mist" aria-hidden="true">
                  {code.toUpperCase()}
                </span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</details>

<script is:inline>
  ;(() => {
    const menu = document.querySelector("[data-lang-menu]")
    if (!menu) return

    document.addEventListener("click", (event) => {
      if (!menu.open || menu.contains(event.target)) return
      menu.open = false
    })

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !menu.open) return
      menu.open = false
      menu.querySelector("summary").focus()
    })
  })()
</script>
