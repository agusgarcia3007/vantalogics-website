---
import { HugeiconsIcon } from "@hugeicons/react"
import { Cancel01Icon, Menu08Icon } from "@hugeicons/core-free-icons"

import Cta from "@/components/site/Cta.astro"
import LanguageMenu from "@/components/site/LanguageMenu.astro"
import Wordmark from "@/components/site/Wordmark.astro"
import { CASES } from "@/data/cases"
import { localizePath, navHref, useTranslations, type Lang } from "@/i18n"
import { SCHEDULE_URL } from "@/site"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)

// «Casos» sólo aparece cuando hay casos publicables (ver src/data/cases.ts).
const items = t.nav.items.filter(
  (item) => item.section !== "cases" || CASES.length > 0
)
---

<!-- Encabezado (design.md › Navigation Pill + Nav CTA Group). Transparente
     sobre el hero; al scrollear toma el canvas translúcido y una regla. -->
<header
  class="site-header sticky top-0 z-40 h-(--header-h) w-full border-b border-transparent transition-[background-color,border-color] duration-300 ease-(--ease-out) data-scrolled:border-iron data-scrolled:bg-carbon/75 data-scrolled:backdrop-blur-xl"
  data-header
>
  <div class="shell flex h-full items-center justify-between gap-6">
    <a
      href={localizePath(lang)}
      class="shrink-0 text-bone transition-opacity duration-(--duration-state) ease-(--ease-out) hover:opacity-70"
      aria-label={t.a11y.home}
    >
      <Wordmark alt={t.a11y.logoAlt} />
    </a>

    <nav aria-label={t.a11y.mainNav} class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          items.map((item) => (
            <li>
              <a
                href={navHref(lang, item.href)}
                class="block rounded-full px-[14px] py-2 label-untitled text-ash transition-colors duration-(--duration-state) ease-(--ease-out) hover:bg-iron hover:text-bone"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <LanguageMenu lang={lang} />

      <Cta
        href={SCHEDULE_URL}
        variant="pill-solid"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden min-h-9 py-[7px] sm:inline-flex"
      >
        {t.nav.cta}
      </Cta>

      <button
        type="button"
        class="grid size-10 shrink-0 place-items-center rounded-[8px] text-bone transition-colors hover:bg-iron lg:hidden"
        aria-expanded="false"
        aria-controls="menu-movil"
        data-menu-toggle
        data-label-menu={t.nav.menu}
        data-label-close={t.nav.close}
        aria-label={t.nav.menu}
      >
        <span data-menu-icon="open" class="grid place-items-center">
          <HugeiconsIcon icon={Menu08Icon} size={22} strokeWidth={1.5} />
        </span>
        <span data-menu-icon="close" class="hidden place-items-center">
          <HugeiconsIcon icon={Cancel01Icon} size={22} strokeWidth={1.5} />
        </span>
      </button>
    </div>
  </div>

  <div
    id="menu-movil"
    class="fixed inset-x-0 top-(--header-h) bottom-0 hidden overflow-y-auto border-t border-iron bg-carbon lg:hidden"
    data-menu
  >
    <nav aria-label={t.a11y.mobileNav} class="shell flex flex-col pt-4 pb-10">
      {
        items.map((item, i) => (
          <a
            href={navHref(lang, item.href)}
            class="menu-link flex items-baseline gap-4 border-b border-iron py-5 text-[28px] leading-tight font-medium tracking-[-0.8px] text-bone"
            style={`--i: ${i};`}
            data-menu-link
          >
            <span class="mono-sm text-mist">
              {String(i + 1).padStart(2, "0")}
            </span>
            {item.label}
          </a>
        ))
      }
      <Cta
        href={SCHEDULE_URL}
        variant="pill-solid"
        size="pill-lg"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 w-full"
        data-menu-link
      >
        {t.nav.cta}
      </Cta>
      <p class="mt-8 eyebrow text-mist">{t.nav.tagline}</p>
    </nav>
  </div>
</header>

<script is:inline>
  ;(() => {
    const toggle = document.querySelector("[data-menu-toggle]")
    const menu = document.querySelector("[data-menu]")
    const header = document.querySelector("[data-header]")

    if (toggle && menu) {
      const openIcon = toggle.querySelector('[data-menu-icon="open"]')
      const closeIcon = toggle.querySelector('[data-menu-icon="close"]')

      const setOpen = (isOpen) => {
        menu.classList.toggle("hidden", !isOpen)
        document.documentElement.style.overflow = isOpen ? "hidden" : ""
        toggle.setAttribute("aria-expanded", String(isOpen))
        toggle.setAttribute(
          "aria-label",
          isOpen ? toggle.dataset.labelClose : toggle.dataset.labelMenu
        )
        openIcon.classList.toggle("hidden", isOpen)
        openIcon.classList.toggle("grid", !isOpen)
        closeIcon.classList.toggle("hidden", !isOpen)
        closeIcon.classList.toggle("grid", isOpen)
        if (isOpen) header?.setAttribute("data-scrolled", "")
        else if (window.scrollY <= 8) header?.removeAttribute("data-scrolled")
      }

      toggle.addEventListener("click", () => {
        setOpen(toggle.getAttribute("aria-expanded") !== "true")
      })

      menu.querySelectorAll("[data-menu-link]").forEach((link) => {
        link.addEventListener("click", () => setOpen(false))
      })

      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return
        if (toggle.getAttribute("aria-expanded") !== "true") return
        setOpen(false)
        toggle.focus()
      })

      window
        .matchMedia("(min-width: 1024px)")
        .addEventListener("change", (e) => {
          if (e.matches) setOpen(false)
        })
    }

    if (header) {
      const syncScrolled = () => {
        if (toggle?.getAttribute("aria-expanded") === "true") return
        if (window.scrollY > 8) header.setAttribute("data-scrolled", "")
        else header.removeAttribute("data-scrolled")
      }
      syncScrolled()
      window.addEventListener("scroll", syncScrolled, { passive: true })
    }
  })()
</script>

<style>
  .menu-link {
    animation: menu-in 0.5s var(--ease-out) both;
    animation-delay: calc(var(--i) * 40ms);
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
</style>
