---
import { HugeiconsIcon } from "@hugeicons/react"
import { Moon02Icon, Sun03Icon } from "@hugeicons/core-free-icons"

import Cta from "@/components/site/Cta.astro"
import Wordmark from "@/components/site/Wordmark.astro"
import { localizePath, otherLang, useTranslations, type Lang } from "@/i18n"
import { SCHEDULE_URL } from "@/site"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
const alt = otherLang(lang)
---

<header
  class="mx-auto w-full max-w-[1180px] border-x border-hairline px-[clamp(20px,4vw,56px)]"
>
  <div class="flex h-16 items-center justify-between gap-6 md:h-[72px]">
    <a
      href="#inicio"
      class="text-bone transition-opacity duration-(--duration-state) ease-(--ease-opx) hover:opacity-70"
      aria-label={t.a11y.home}
    >
      <Wordmark alt={t.a11y.logoAlt} />
    </a>

    <div class="flex items-center gap-5 lg:gap-8">
      <nav aria-label={t.a11y.mainNav} class="hidden items-center gap-7 lg:flex">
        {
          t.nav.items.map((item) => (
            <a
              href={item.href}
              class="label-untitled text-ash transition-colors duration-(--duration-state) ease-(--ease-opx) hover:text-bone"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <!-- Selector de idioma: un enlace a la ruta prerenderizada del otro
           idioma. Sin JavaScript, sin cookies, sin redirecciones. -->
      <a
        href={localizePath(alt)}
        hreflang={alt}
        lang={alt}
        class="label-untitled text-ash transition-colors duration-(--duration-state) ease-(--ease-opx) hover:text-bone"
        aria-label={t.language.switchTo}
      >
        <span aria-hidden="true">{alt.toUpperCase()}</span>
      </a>

      <!-- Los dos temas a la vista, no un botón que se alterna: se ve dónde
           estás parado y adónde podés ir sin tener que interpretar un glifo
           solo. El activo se marca con aria-pressed —el estado real del
           control, y de paso el que estiliza Tailwind— y lo escribe el script
           inline de abajo, que corre en el parseo: no hay parpadeo. -->
      <div
        class="flex shrink-0 items-center gap-[2px] rounded-pill border border-hairline p-[2px]"
        role="group"
        aria-label={t.theme.label}
      >
        <button
          type="button"
          class="grid size-[28px] place-items-center rounded-pill text-ash transition-colors duration-(--duration-state) ease-(--ease-opx) hover:text-bone aria-pressed:bg-bone aria-pressed:text-canvas"
          data-set-theme="light"
          aria-label={t.theme.toLight}
        >
          <HugeiconsIcon icon={Sun03Icon} size={16} strokeWidth={1.5} />
        </button>
        <button
          type="button"
          class="grid size-[28px] place-items-center rounded-pill text-ash transition-colors duration-(--duration-state) ease-(--ease-opx) hover:text-bone aria-pressed:bg-bone aria-pressed:text-canvas"
          data-set-theme="dark"
          aria-label={t.theme.toDark}
        >
          <HugeiconsIcon icon={Moon02Icon} size={16} strokeWidth={1.5} />
        </button>
      </div>

      <Cta
        href={SCHEDULE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex"
      >
        {t.nav.cta}
      </Cta>

      <button
        type="button"
        class="label-untitled text-bone lg:hidden"
        aria-expanded="false"
        aria-controls="menu-movil"
        data-menu-toggle
        data-label-menu={t.nav.menu}
        data-label-close={t.nav.close}
      >
        <span data-menu-label>{t.nav.menu}</span>
      </button>
    </div>
  </div>

  <div id="menu-movil" class="hidden border-t border-hairline pb-8 lg:hidden" data-menu>
    <nav aria-label={t.a11y.mobileNav} class="flex flex-col">
      {
        t.nav.items.map((item) => (
          <a
            href={item.href}
            class="font-untitled text-[22px] leading-tight text-bone transition-opacity duration-(--duration-state) ease-(--ease-opx) hover:opacity-60"
            data-menu-link
          >
            {item.label}
          </a>
        ))
      }
      <Cta
        href={SCHEDULE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 self-start sm:hidden"
        data-menu-link
      >
        {t.nav.cta}
      </Cta>
    </nav>
  </div>
</header>

<script is:inline>
  ;(() => {
    const toggle = document.querySelector("[data-menu-toggle]")
    const menu = document.querySelector("[data-menu]")
    const label = document.querySelector("[data-menu-label]")

    if (toggle && menu && label) {
      const setOpen = (isOpen) => {
        menu.classList.toggle("hidden", !isOpen)
        toggle.setAttribute("aria-expanded", String(isOpen))
        label.textContent = isOpen
          ? toggle.dataset.labelClose
          : toggle.dataset.labelMenu
      }

      toggle.addEventListener("click", () => {
        setOpen(toggle.getAttribute("aria-expanded") !== "true")
      })

      menu.querySelectorAll("[data-menu-link]").forEach((link) => {
        link.addEventListener("click", () => setOpen(false))
      })

      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return
        if (toggle.getAttribute("aria-expanded") !== "true") return
        setOpen(false)
        toggle.focus()
      })

      window
        .matchMedia("(min-width: 1024px)")
        .addEventListener("change", (e) => {
          if (e.matches) setOpen(false)
        })
    }

    // Tema: oscuro por defecto, elección persistida.
    const root = document.documentElement
    const options = document.querySelectorAll("[data-set-theme]")

    const sync = () => {
      const current =
        root.getAttribute("data-theme") === "light" ? "light" : "dark"
      options.forEach((option) => {
        option.setAttribute(
          "aria-pressed",
          String(option.dataset.setTheme === current)
        )
      })
    }

    sync()

    options.forEach((option) => {
      option.addEventListener("click", () => {
        const next = option.dataset.setTheme
        if (next === "light") {
          root.setAttribute("data-theme", "light")
        } else {
          root.removeAttribute("data-theme")
        }
        try {
          localStorage.setItem("vl-theme", next)
        } catch {
          /* almacenamiento bloqueado */
        }
        sync()
      })
    })
  })()
</script>

