---
import { HugeiconsIcon } from "@hugeicons/react"
import {
  Cancel01Icon,
  Menu08Icon,
  Moon02Icon,
  Sun03Icon,
} from "@hugeicons/core-free-icons"

import Cta from "@/components/site/Cta.astro"
import LanguageMenu from "@/components/site/LanguageMenu.astro"
import Wordmark from "@/components/site/Wordmark.astro"
import { localizePath, navHref, useTranslations, type Lang } from "@/i18n"
import { SCHEDULE_URL } from "@/site"

interface Props {
  lang: Lang
  alternates?: Partial<Record<Lang, string>>
}

const { lang, alternates } = Astro.props
const t = useTranslations(lang)
---

<!-- El encabezado.
     Queda pegado arriba —el CTA es la acción principal del sitio y no tiene
     por qué desaparecer— pero contra el hero no dibuja nada: el fondo y la
     regla inferior aparecen recién cuando hay contenido pasando por debajo. -->
<header
  class="sticky top-0 z-40 mx-auto w-full max-w-[1240px] border-x border-hairline transition-colors duration-(--duration-state) ease-paper data-scrolled:border-b data-scrolled:bg-surface/92 data-scrolled:backdrop-blur-md"
  data-header
>
  <div
    class="flex items-center justify-between gap-8 px-[clamp(20px,4vw,72px)] py-[18px] lg:py-5"
  >
    <div class="flex items-center gap-12">
      <a
        href={localizePath(lang)}
        class="shrink-0 text-bone transition-opacity duration-(--duration-state) ease-paper hover:opacity-70"
        aria-label={t.a11y.home}
      >
        <Wordmark alt={t.a11y.logoAlt} />
      </a>

      <nav aria-label={t.a11y.mainNav} class="hidden items-center gap-8 lg:flex">
        {
          t.nav.items.map((item) => (
            <a
              href={navHref(lang, item.href)}
              class="nav-link py-2 label-mono text-ash transition-colors duration-(--duration-state) ease-paper hover:text-bone"
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="flex items-center gap-4 lg:gap-6">
      <!-- Idioma y tema son utilidades, no navegación: van juntos y separados
           del CTA por una regla vertical, para que se lean como un grupo. -->
      <div class="flex items-center gap-3">
        <LanguageMenu lang={lang} alternates={alternates} />

        <!-- Los dos temas a la vista, no un botón que se alterna: se ve dónde
             estás parado y adónde podés ir sin interpretar un glifo solo. El
             activo se marca con aria-pressed —el estado real del control— y lo
             escribe el script de abajo, que corre en el parseo. -->
        <div
          class="flex shrink-0 items-center gap-[2px] border border-hairline p-[3px]"
          role="group"
          aria-label={t.theme.label}
        >
          <button
            type="button"
            class="grid size-[26px] place-items-center text-ash transition-colors duration-(--duration-state) ease-paper hover:text-bone aria-pressed:bg-bone aria-pressed:text-canvas"
            data-set-theme="light"
            aria-label={t.theme.toLight}
          >
            <HugeiconsIcon icon={Sun03Icon} size={14} strokeWidth={1.6} />
          </button>
          <button
            type="button"
            class="grid size-[26px] place-items-center text-ash transition-colors duration-(--duration-state) ease-paper hover:text-bone aria-pressed:bg-bone aria-pressed:text-canvas"
            data-set-theme="dark"
            aria-label={t.theme.toDark}
          >
            <HugeiconsIcon icon={Moon02Icon} size={14} strokeWidth={1.6} />
          </button>
        </div>
      </div>

      <span class="hidden h-6 w-px bg-hairline sm:block" aria-hidden="true"
      ></span>

      <Cta
        href={SCHEDULE_URL}
        variant="solid"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex"
      >
        {t.nav.cta}
      </Cta>

      <button
        type="button"
        class="relative -me-1 grid size-9 shrink-0 place-items-center text-bone lg:hidden"
        aria-expanded="false"
        aria-controls="menu-movil"
        data-menu-toggle
        data-label-menu={t.nav.menu}
        data-label-close={t.nav.close}
        aria-label={t.nav.menu}
      >
        <span data-menu-icon="open" class="grid place-items-center">
          <HugeiconsIcon icon={Menu08Icon} size={22} strokeWidth={1.5} />
        </span>
        <span data-menu-icon="close" class="hidden place-items-center">
          <HugeiconsIcon icon={Cancel01Icon} size={22} strokeWidth={1.5} />
        </span>
      </button>
    </div>
  </div>

  <div
    id="menu-movil"
    class="hidden border-t border-hairline bg-surface px-[clamp(20px,4vw,72px)] pt-2 pb-8 lg:hidden"
    data-menu
  >
    <nav aria-label={t.a11y.mobileNav} class="flex flex-col">
      {
        t.nav.items.map((item) => (
          <a
            href={navHref(lang, item.href)}
            class="border-b border-hairline py-4 font-display text-[21px] leading-tight text-bone transition-colors duration-(--duration-state) ease-paper hover:text-pen-ink"
            data-menu-link
          >
            {item.label}
          </a>
        ))
      }
      <Cta
        href={SCHEDULE_URL}
        variant="solid"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-7 self-start sm:hidden"
        data-menu-link
      >
        {t.nav.cta}
      </Cta>
    </nav>
  </div>
</header>

<style>
  /* El enlace del menú se subraya con el lápiz: el trazo nace en el borde por
     el que empieza a leerse la línea y crece al pasar. */
  .nav-link {
    position: relative;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    bottom: 0;
    height: 2px;
    width: 100%;
    transform: scaleX(0);
    transform-origin: inline-start;
    background: var(--color-pen);
    transition: transform var(--duration-state) var(--ease-paper);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
  }
</style>

<script is:inline>
  ;(() => {
    const toggle = document.querySelector("[data-menu-toggle]")
    const menu = document.querySelector("[data-menu]")

    if (toggle && menu) {
      const openIcon = toggle.querySelector('[data-menu-icon="open"]')
      const closeIcon = toggle.querySelector('[data-menu-icon="close"]')

      const setOpen = (isOpen) => {
        menu.classList.toggle("hidden", !isOpen)
        toggle.setAttribute("aria-expanded", String(isOpen))
        toggle.setAttribute(
          "aria-label",
          isOpen ? toggle.dataset.labelClose : toggle.dataset.labelMenu
        )
        openIcon.classList.toggle("hidden", isOpen)
        openIcon.classList.toggle("grid", !isOpen)
        closeIcon.classList.toggle("hidden", !isOpen)
        closeIcon.classList.toggle("grid", isOpen)
      }

      toggle.addEventListener("click", () => {
        setOpen(toggle.getAttribute("aria-expanded") !== "true")
      })

      menu.querySelectorAll("[data-menu-link]").forEach((link) => {
        link.addEventListener("click", () => setOpen(false))
      })

      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return
        if (toggle.getAttribute("aria-expanded") !== "true") return
        setOpen(false)
        toggle.focus()
      })

      window
        .matchMedia("(min-width: 1024px)")
        .addEventListener("change", (e) => {
          if (e.matches) setOpen(false)
        })
    }

    // El fondo y la regla aparecen sólo cuando hay contenido pasando debajo.
    const header = document.querySelector("[data-header]")
    if (header) {
      const syncScrolled = () => {
        if (window.scrollY > 8) {
          header.setAttribute("data-scrolled", "")
        } else {
          header.removeAttribute("data-scrolled")
        }
      }
      syncScrolled()
      window.addEventListener("scroll", syncScrolled, { passive: true })
    }

    // Tema: el papel es el estado natural y la elección se recuerda.
    const root = document.documentElement
    const options = document.querySelectorAll("[data-set-theme]")

    const sync = () => {
      const current =
        root.getAttribute("data-theme") === "dark" ? "dark" : "light"
      options.forEach((option) => {
        option.setAttribute(
          "aria-pressed",
          String(option.dataset.setTheme === current)
        )
      })
    }

    sync()

    options.forEach((option) => {
      option.addEventListener("click", () => {
        const next = option.dataset.setTheme
        if (next === "dark") {
          root.setAttribute("data-theme", "dark")
        } else {
          root.removeAttribute("data-theme")
        }
        try {
          localStorage.setItem("vl-theme", next)
        } catch {
          /* almacenamiento bloqueado */
        }
        sync()
      })
    })
  })()
</script>
