---
import { HugeiconsIcon } from "@hugeicons/react"
import { BubbleChatIcon } from "@hugeicons/core-free-icons"

import { useTranslations, type Lang } from "@/i18n"
import { AGENT_HOST, TURNSTILE_SITEKEY } from "@/site"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
---

<!-- El disparador del agente. Es HTML: no cuesta un byte de JavaScript, igual
     que el resto del sitio. React, el sheet y el cliente del agente entran con
     el primer clic y no antes.

     Mismo pill que WhatsApp y apilado debajo: en una pila flotante el lugar
     de abajo es el que la mano encuentra primero, y el agente es la invitación
     principal —WhatsApp queda arriba, a un dedo de distancia. El sistema es
     monocromo (design.md), de modo que la jerarquía la da la posición, no el
     color. -->
<button
  type="button"
  data-agent-open
  data-agent-lang={lang}
  data-agent-host={AGENT_HOST}
  data-agent-sitekey={TURNSTILE_SITEKEY}
  aria-label={t.agent.open}
  aria-haspopup="dialog"
  class="group fixed right-[max(20px,env(safe-area-inset-right))] bottom-[max(20px,env(safe-area-inset-bottom))] z-50 flex items-center gap-0 rounded-pill border border-hairline bg-canvas/90 p-[13px] label-untitled text-bone backdrop-blur-sm transition-colors duration-(--duration-state) ease-(--ease-opx) hover:border-bone focus-visible:border-bone focus-visible:outline-none"
>
  <!-- Burbuja de chat: mismo trazo que el resto de los glifos del sistema, así
       no compite con el de WhatsApp apilado justo arriba. -->
  <HugeiconsIcon
    icon={BubbleChatIcon}
    size={22}
    strokeWidth={1.5}
    className="shrink-0"
    aria-hidden="true"
  />

  <!-- La invitación va escrita: alguien que no sabe qué es un agente no la
       descubre pasando el mouse por un círculo. En pantallas angostas, donde
       el pill le comería el ancho al contenido, el rótulo sigue naciendo en
       cero y sólo aparece con intención (hover/foco). -->
  <span
    class="max-w-0 overflow-hidden whitespace-nowrap opacity-0 transition-[max-width,opacity,margin] duration-(--duration-geometry) ease-(--ease-opx) group-hover:ml-[11px] group-hover:max-w-[30ch] group-hover:opacity-100 group-focus-visible:ml-[11px] group-focus-visible:max-w-[30ch] group-focus-visible:opacity-100 sm:ml-[11px] sm:max-w-[30ch] sm:opacity-100"
  >
    {t.agent.open}
  </span>
</button>

<script>
  /**
   * En desarrollo, React se monta fuera de una isla de Astro, así que nadie
   * inyecta el preámbulo de React Refresh y el plugin aborta con "can't detect
   * preamble". Lo instalamos nosotros. En producción no existe Fast Refresh y
   * la rama entera desaparece del bundle.
   */
  async function installRefreshPreamble() {
    if (!import.meta.env.DEV) return
    // El especificador va en una variable a propósito: es un módulo virtual de
    // Vite que sólo existe en desarrollo y TypeScript no puede resolverlo.
    const specifier = "/@react-refresh"
    const runtime = (await import(/* @vite-ignore */ specifier)) as {
      injectIntoGlobalHook(window: Window): void
    }
    runtime.injectIntoGlobalHook(window)
    // @ts-expect-error — globales que espera el plugin en desarrollo
    window.$RefreshReg$ = () => {}
    // @ts-expect-error — idem
    window.$RefreshSig$ = () => (type: unknown) => type
    // @ts-expect-error — idem
    window.__vite_plugin_react_preamble_installed__ = true
  }

  // Carga bajo demanda. El primer clic trae el módulo del agente; los
  // siguientes sólo emiten el evento de apertura, que el panel ya escucha.
  //
  // Escuchan todos los disparadores de la página —el flotante y los botones
  // de las secciones—, no sólo este: el que abre el panel es siempre el mismo
  // código, y la configuración (host, sitekey, idioma) sigue viviendo acá.
  const trigger = document.querySelector("[data-agent-open]")
  const triggers = document.querySelectorAll(
    "[data-agent-open], [data-agent-open-secondary]"
  )
  let loading: Promise<unknown> | null = null

  triggers.forEach((node) => {
    node.addEventListener("click", () => {
      if (loading) {
        window.dispatchEvent(new CustomEvent("vl:agent-open"))
        return
      }

      trigger?.setAttribute("data-agent-loading", "")
      loading = installRefreshPreamble()
        .then(() => import("@/components/agent/mount"))
        .finally(() => trigger?.removeAttribute("data-agent-loading"))
    })
  })
</script>

<style>
  [data-agent-loading] {
    opacity: 0.6;
  }
</style>
