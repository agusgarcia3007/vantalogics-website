---
import { HugeiconsIcon } from "@hugeicons/react"
import { BubbleChatIcon } from "@hugeicons/core-free-icons"

import { useTranslations, type Lang } from "@/i18n"
import { AGENT_HOST, TURNSTILE_SITEKEY } from "@/site"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
---

<button
  type="button"
  data-agent-open
  data-agent-lang={lang}
  data-agent-host={AGENT_HOST}
  data-agent-sitekey={TURNSTILE_SITEKEY}
  aria-label={t.agent.open}
  aria-haspopup="dialog"
  class="group fixed end-[max(20px,env(safe-area-inset-right))] bottom-[max(20px,env(safe-area-inset-bottom))] z-50 flex items-center gap-0 rounded-pill border border-hairline bg-canvas/90 p-[13px] label-untitled text-bone backdrop-blur-sm transition-colors duration-(--duration-state) ease-(--ease-opx) hover:border-bone focus-visible:border-bone focus-visible:outline-none rtl:end-[max(20px,env(safe-area-inset-left))]"
>
  <HugeiconsIcon
    icon={BubbleChatIcon}
    size={22}
    strokeWidth={1.5}
    className="shrink-0"
    aria-hidden="true"
  />

  <span
    class="max-w-0 overflow-hidden whitespace-nowrap opacity-0 transition-[max-width,opacity,margin] duration-(--duration-geometry) ease-(--ease-opx) group-hover:ms-[11px] group-hover:max-w-[30ch] group-hover:opacity-100 group-focus-visible:ms-[11px] group-focus-visible:max-w-[30ch] group-focus-visible:opacity-100 sm:ms-[11px] sm:max-w-[30ch] sm:opacity-100"
  >
    {t.agent.open}
  </span>
</button>

<script>
  import { installRefreshPreamble } from "@/lib/react-preamble"

  const trigger = document.querySelector("[data-agent-open]")
  const triggers = document.querySelectorAll(
    "[data-agent-open], [data-agent-open-secondary]"
  )
  let loading: Promise<unknown> | null = null

  triggers.forEach((node) => {
    node.addEventListener("click", () => {
      if (loading) {
        window.dispatchEvent(new CustomEvent("vl:agent-open"))
        return
      }

      trigger?.setAttribute("data-agent-loading", "")
      loading = installRefreshPreamble()
        .then(() => import("@/components/agent/mount"))
        .finally(() => trigger?.removeAttribute("data-agent-loading"))
    })
  })
</script>

<style>
  [data-agent-loading] {
    opacity: 0.6;
  }
</style>
