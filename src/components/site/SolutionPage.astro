---
import Layout from "@/layouts/main.astro"
import Chrome from "@/components/cine/Chrome.astro"
import Foot from "@/components/cine/Foot.astro"
import LinkCard from "@/components/cine/LinkCard.astro"
import NextStep from "@/components/cine/NextStep.astro"
import { LANGS, localizePath, useTranslations, type Lang } from "@/i18n"
import {
  solutionPath,
  solutionsIndexPath,
  type Solution,
} from "@/data/solutions"
import { casePath, casesFor } from "@/data/use-cases"
import { getPostsByIndustry } from "@/lib/blog"
import PostCard from "@/components/blog/PostCard.astro"

interface Props {
  lang: Lang
  solution: Solution
}

const SITE = "https://vantalogics.com"
const { lang, solution } = Astro.props
const t = useTranslations(lang)

const path = solutionPath(lang, solution)
const pageUrl = new URL(path, SITE).href
const indexPath = solutionsIndexPath(lang)

const useCases = casesFor(solution)

const posts = await getPostsByIndustry(lang, solution.slug.es)

const service = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${pageUrl}#service`,
  name: solution.title[lang],
  description: solution.answer[lang],
  serviceType: solution.title[lang],
  provider: { "@id": `${SITE}/#organization` },
  audience: { "@type": "BusinessAudience", name: solution.sector[lang] },
  areaServed: [
    { "@type": "Place", name: "Latin America" },
    { "@type": "Country", name: "Spain" },
    { "@type": "Country", name: "United States" },
  ],
  inLanguage: lang,
  url: pageUrl,
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: t.solutions.processesLabel,
    itemListElement: solution.processes.map((process) => ({
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: process.title[lang],
        description: process.detail[lang],
      },
    })),
  },
  ...(useCases.length
    ? {
        hasPart: useCases.map((useCase) => ({
          "@type": "Service",
          "@id": `${new URL(casePath(lang, solution, useCase), SITE).href}#service`,
          name: useCase.title[lang],
          description: useCase.answer[lang],
          url: new URL(casePath(lang, solution, useCase), SITE).href,
        })),
      }
    : {}),
}

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Vantalogics",
      item: new URL(localizePath(lang), SITE).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: t.solutions.breadcrumb,
      item: new URL(indexPath, SITE).href,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: solution.sector[lang],
      item: pageUrl,
    },
  ],
}

const faqPage = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${pageUrl}#faq`,
  inLanguage: lang,
  mainEntity: solution.faq.map((entry) => ({
    "@type": "Question",
    name: entry.question[lang],
    acceptedAnswer: { "@type": "Answer", text: entry.answer[lang] },
  })),
}

const lists = [
  {
    id: "integraciones",
    label: t.solutions.stackLabel,
    items: solution.stack[lang],
  },
  {
    id: "aprobacion",
    label: t.solutions.humanLabel,
    items: solution.human[lang],
  },
  {
    id: "cuando-no",
    label: t.solutions.notThisLabel,
    items: solution.notThis[lang],
  },
]
---

<Layout
  lang={lang}
  path={path}
  title={`${solution.title[lang]} — Vantalogics`}
  description={solution.description[lang]}
  alternates={Object.fromEntries(
    LANGS.map((code) => [code, solutionPath(code, solution)])
  )}
  jsonLd={[service, breadcrumb, faqPage]}
  floating={false}
>
  <Chrome lang={lang}>
    <main class="doc-page" id="contenido">
      <div class="shell">
        <nav class="crumbs appear appear--soft" aria-label="Breadcrumb">
          <a href={localizePath(lang)}>Vantalogics</a>
          <span aria-hidden="true">/</span>
          <a href={indexPath}>{t.solutions.breadcrumb}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{solution.sector[lang]}</span>
        </nav>

        <div class="doc-head">
          <span class="appear appear--scale eyebrow" style="--d:0.2s">
            {solution.sector[lang]}
          </span>
          <h1 class="appear appear--soft" style="--d:0.3s">
            {solution.title[lang]}
          </h1>
          {
            solution.intro[lang].map((paragraph) => (
              <p class="appear appear--soft" style="--d:0.42s">
                {paragraph}
              </p>
            ))
          }
        </div>
      </div>
    </main>

    <div class="below" slot="after">
      <section class="section">
        <div class="shell">
          <div class="answer reveal">
            <p class="answer-label">{t.blog.answerLabel}</p>
            <p class="answer-body">{solution.answer[lang]}</p>
          </div>
        </div>
      </section>

      <section class="section" aria-labelledby="procesos">
        <div class="shell">
          <div class="section-head reveal">
            <h2 id="procesos">{t.solutions.processesLabel}</h2>
          </div>
          <div class="steps">
            {
              solution.processes.map((process, index) => (
                <div class="step reveal" style={`--i:${index}`}>
                  <span class="step-n">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <div>
                    <h3>{process.title[lang]}</h3>
                    <p>{process.detail[lang]}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      {
        useCases.length > 0 && (
          <section class="section" aria-labelledby="casos-de-uso">
            <div class="shell">
              <div class="section-head reveal">
                <h2 id="casos-de-uso">{t.solutions.useCasesLabel}</h2>
                <p>{t.solutions.useCasesIntro}</p>
              </div>
              <div class="posts">
                {useCases.map((useCase, index) => (
                  <LinkCard
                    href={casePath(lang, solution, useCase)}
                    title={useCase.title[lang]}
                    description={useCase.description[lang]}
                    index={index}
                  />
                ))}
              </div>
            </div>
          </section>
        )
      }

      <section class="section" aria-labelledby="empezar">
        <div class="shell">
          <div class="section-head reveal">
            <h2 id="empezar">{t.solutions.startLabel}</h2>
          </div>
          <div class="steps">
            {
              solution.start[lang].map((step, index) => (
                <div class="step reveal" style={`--i:${index}`}>
                  <span class="step-n">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <p>{step}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      {
        lists.map((list) => (
          <section class="section" aria-labelledby={list.id}>
            <div class="shell">
              <div class="section-head reveal">
                <h2 id={list.id}>{list.label}</h2>
              </div>
              <div class="components reveal">
                <ul>
                  {list.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            </div>
          </section>
        ))
      }

      <section class="section" aria-labelledby="preguntas">
        <div class="shell">
          <div class="section-head reveal">
            <h2 id="preguntas">{t.blog.faqLabel}</h2>
          </div>
          <dl class="faq">
            {
              solution.faq.map((entry, index) => (
                <div class="faq-item reveal" style={`--i:${index}`}>
                  <dt>{entry.question[lang]}</dt>
                  <dd>{entry.answer[lang]}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      {
        posts.length > 0 && (
          <section class="section" aria-labelledby="notas-sector">
            <div class="shell">
              <div class="section-head reveal">
                <h2 id="notas-sector">{t.solutions.notesLabel}</h2>
              </div>
              <div class="posts">
                {posts.map((post, index) => (
                  <PostCard post={post} index={index} />
                ))}
              </div>
            </div>
          </section>
        )
      }

      <NextStep
        lang={lang}
        back={{ href: indexPath, label: t.solutions.breadcrumb }}
      />

      <Foot lang={lang} />
    </div>
  </Chrome>
</Layout>
