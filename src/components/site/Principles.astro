---
import Frame from "@/components/site/Frame.astro"
import SectionTitle from "@/components/site/SectionTitle.astro"
import { useTranslations, type Lang } from "@/i18n"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang).principles
---

<Frame id="compromisos" labelledby="compromisos-titulo">
  <div
    class="grid gap-x-[clamp(32px,5vw,80px)] gap-y-8 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1fr)]"
  >
    <SectionTitle
      id="compromisos-titulo"
      index="06"
      label={t.label}
      muted={t.titleMuted}
      bright={t.titleBright}
    />
    <p
      class="copy max-w-[52ch] self-end text-ash"
      data-reveal
      style="--reveal-delay: 100ms;"
    >
      {t.intro}
    </p>
  </div>

  <!-- Cuatro compromisos, sin cifra de adorno al lado: no hay número que
       mostrar y poner uno sería volver al problema que esta sección resuelve.
       Lo que sostiene el bloque es la regla, el número al margen y el texto. -->
  <ul
    class="mt-[clamp(48px,6vw,80px)] grid gap-x-[clamp(24px,4vw,64px)] gap-y-12 sm:grid-cols-2"
  >
    {
      t.items.map((item, i) => (
        <li
          class="border-t border-hairline pt-7"
          data-reveal
          style={`--reveal-delay: ${i * 90}ms;`}
        >
          <p class="label-mono-sm text-faint" data-numeral>
            {String(i + 1).padStart(2, "0")}
          </p>
          <h3 class="display-sm mt-4 max-w-[22ch] text-bone">{item.title}</h3>
          <p class="copy mt-4 max-w-[46ch] text-[15px] text-ash">{item.body}</p>
        </li>
      ))
    }
  </ul>
</Frame>
