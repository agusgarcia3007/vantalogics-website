---
import Frame from "@/components/site/Frame.astro"
import SectionTitle from "@/components/site/SectionTitle.astro"
import { useTranslations, type Lang } from "@/i18n"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang).guarantees
---

<Frame id="garantias" labelledby="garantias-titulo">
  <div
    class="grid gap-x-[clamp(32px,5vw,72px)] gap-y-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1fr)]"
  >
    <SectionTitle
      id="garantias-titulo"
      label={t.label}
      muted={t.titleMuted}
      bright={t.titleBright}
    />
    <p
      class="copy max-w-[54ch] self-end text-ash"
      data-reveal
      style="--reveal-delay: 100ms;"
    >
      {t.intro}
    </p>
  </div>

  <!-- Cuatro compromisos, sin cifra grande al lado. La sección anterior abría
       con una métrica en escala hero; acá no hay número que mostrar y poner uno
       de adorno sería volver al problema. Lo que sostiene el bloque es la
       hairline y el texto. -->
  <ul
    class="mt-[clamp(48px,6vw,80px)] grid gap-x-[clamp(24px,3vw,40px)] gap-y-10 sm:grid-cols-2"
  >
    {
      t.items.map((item, i) => (
        <li
          class="border-t border-hairline pt-6"
          data-reveal
          style={`--reveal-delay: ${i * 90}ms;`}
        >
          <h3 class="font-untitled text-[20px] leading-snug text-bone">
            {item.title}
          </h3>
          <p class="copy mt-4 max-w-[46ch] text-ash">{item.body}</p>
        </li>
      ))
    }
  </ul>
</Frame>
