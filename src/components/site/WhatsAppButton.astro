---
import { HugeiconsIcon } from "@hugeicons/react"
import { WhatsappIcon } from "@hugeicons/core-free-icons"

import { useTranslations, type Lang } from "@/i18n"
import { whatsappUrl } from "@/site"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
const href = whatsappUrl(t.whatsapp.prefill)
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  aria-label={t.whatsapp.aria}
  data-whatsapp
  class="group fixed end-[max(20px,env(safe-area-inset-right))] bottom-[calc(max(20px,env(safe-area-inset-bottom))+60px)] z-50 flex items-center gap-0 rounded-pill border border-hairline bg-canvas/90 p-[13px] label-untitled text-bone backdrop-blur-sm transition-colors duration-(--duration-state) ease-(--ease-opx) hover:border-bone focus-visible:border-bone focus-visible:outline-none rtl:end-[max(20px,env(safe-area-inset-left))]"
>
  <HugeiconsIcon
    icon={WhatsappIcon}
    size={22}
    strokeWidth={1.5}
    className="shrink-0"
    aria-hidden="true"
  />

  <span
    class="max-w-0 overflow-hidden whitespace-nowrap opacity-0 transition-[max-width,opacity,margin] duration-(--duration-geometry) ease-(--ease-opx) group-hover:ms-[11px] group-hover:max-w-[22ch] group-hover:opacity-100 group-focus-visible:ms-[11px] group-focus-visible:max-w-[22ch] group-focus-visible:opacity-100"
  >
    {t.whatsapp.label}
  </span>
</a>

<style>
  @media (prefers-reduced-motion: reduce) {
    [data-whatsapp] span {
      transition: none;
    }
  }
</style>
