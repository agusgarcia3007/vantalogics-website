---
import { HugeiconsIcon } from "@hugeicons/react"
import { WhatsappIcon } from "@hugeicons/core-free-icons"

import { useTranslations, type Lang } from "@/i18n"
import { whatsappUrl } from "@/site"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
const href = whatsappUrl(t.whatsapp.prefill)
---

<!-- Contacto flotante. El sistema es monocromo (design.md: no color), así que
     el botón usa el mismo pill de contorno que el resto de la interfaz: el
     glifo de WhatsApp identifica el canal sin traer el verde de la marca.
     El rótulo se despliega en hover/foco desde ancho cero para no competir con
     el contenido. -->
<a
  href={href}
  target="_blank"
  rel="noopener"
  aria-label={t.whatsapp.aria}
  data-whatsapp
  class="group label-untitled fixed right-[max(20px,env(safe-area-inset-right))] bottom-[calc(max(20px,env(safe-area-inset-bottom))+60px)] z-50 flex items-center gap-0 rounded-pill border border-hairline bg-canvas/90 p-[13px] text-bone backdrop-blur-sm transition-colors duration-(--duration-state) ease-(--ease-opx) hover:border-bone focus-visible:border-bone focus-visible:outline-none"
>
  <HugeiconsIcon
    icon={WhatsappIcon}
    size={22}
    strokeWidth={1.5}
    className="shrink-0"
    aria-hidden="true"
  />

  <!-- El rótulo nace en 0px y crece: sólo aparece con intención (hover/foco).
       Con reduced motion la transición se apaga desde global.css. -->
  <span
    class="max-w-0 overflow-hidden whitespace-nowrap opacity-0 transition-[max-width,opacity,margin] duration-(--duration-geometry) ease-(--ease-opx) group-hover:ml-[11px] group-hover:max-w-[22ch] group-hover:opacity-100 group-focus-visible:ml-[11px] group-focus-visible:max-w-[22ch] group-focus-visible:opacity-100"
  >
    {t.whatsapp.label}
  </span>
</a>

<style>
  @media (prefers-reduced-motion: reduce) {
    [data-whatsapp] span {
      transition: none;
    }
  }
</style>
