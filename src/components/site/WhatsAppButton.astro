---
import { useTranslations, type Lang } from "@/i18n"
import { whatsappUrl } from "@/site"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
const href = whatsappUrl(t.whatsapp.prefill)
---

<!-- Contacto flotante. El sistema es monocromo (design.md: no color), así que
     el botón usa el mismo pill de contorno que el resto de la interfaz: el
     glifo de WhatsApp identifica el canal sin traer el verde de la marca.
     El rótulo se despliega en hover/foco desde ancho cero para no competir con
     el contenido. -->
<a
  href={href}
  target="_blank"
  rel="noopener"
  aria-label={t.whatsapp.aria}
  data-whatsapp
  class="group label-untitled fixed right-[max(20px,env(safe-area-inset-right))] bottom-[max(20px,env(safe-area-inset-bottom))] z-50 flex items-center gap-0 rounded-pill border border-hairline bg-canvas/90 p-[13px] text-bone backdrop-blur-sm transition-colors duration-(--duration-state) ease-(--ease-opx) hover:border-bone focus-visible:border-bone focus-visible:outline-none"
>
  <svg
    viewBox="0 0 24 24"
    class="h-[22px] w-[22px] shrink-0 fill-current"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.97L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2Zm0 18.02h-.01c-1.5 0-2.98-.4-4.27-1.17l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.36c0-4.54 3.7-8.23 8.24-8.23 2.2 0 4.26.86 5.82 2.41a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.14 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.7-.81-.23-.08-.4-.12-.56.13-.17.25-.66.81-.81.98-.15.17-.3.19-.55.06-.25-.12-1.05-.39-2-1.23a7.5 7.5 0 0 1-1.38-1.72c-.15-.25-.02-.39.1-.51.12-.12.25-.3.37-.45.12-.15.17-.25.25-.42.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.41-.56-.42h-.47c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.08 0 1.22.89 2.4 1.01 2.57.12.17 1.73 2.65 4.2 3.71.59.25 1.04.4 1.4.52.6.19 1.13.16 1.56.1.47-.07 1.47-.6 1.68-1.19.2-.58.2-1.08.14-1.19-.06-.1-.23-.17-.48-.29Z"
    ></path>
  </svg>

  <!-- El rótulo nace en 0px y crece: sólo aparece con intención (hover/foco).
       Con reduced motion la transición se apaga desde global.css. -->
  <span
    class="max-w-0 overflow-hidden whitespace-nowrap opacity-0 transition-[max-width,opacity,margin] duration-(--duration-geometry) ease-(--ease-opx) group-hover:ml-[11px] group-hover:max-w-[22ch] group-hover:opacity-100 group-focus-visible:ml-[11px] group-focus-visible:max-w-[22ch] group-focus-visible:opacity-100"
  >
    {t.whatsapp.label}
  </span>
</a>

<style>
  @media (prefers-reduced-motion: reduce) {
    [data-whatsapp] span {
      transition: none;
    }
  }
</style>
