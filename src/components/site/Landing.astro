---
import Layout from "@/layouts/main.astro"
import SiteHeader from "@/components/site/SiteHeader.astro"
import Hero from "@/components/site/Hero.astro"
import Tools from "@/components/site/Tools.astro"
import Problem from "@/components/site/Problem.astro"
import Services from "@/components/site/Services.astro"
import Industries from "@/components/site/Industries.astro"
import AgentDemo from "@/components/site/AgentDemo.astro"
import Process from "@/components/site/Process.astro"
import Proof from "@/components/site/Proof.astro"
import Faq from "@/components/site/Faq.astro"
import CallToAction from "@/components/site/CallToAction.astro"
import SiteFooter from "@/components/site/SiteFooter.astro"
import {
  LANGS,
  localizePath,
  ogImage,
  useTranslations,
  type Lang,
} from "@/i18n"
import { GITHUB_URL, INSTAGRAM_URL } from "@/site"
import { FOCUS_SOLUTIONS, solutionPath } from "@/data/solutions"

interface Props {
  lang: Lang
}

const SITE = "https://vantalogics.com"
const { lang } = Astro.props
const t = useTranslations(lang)
const pageUrl = new URL(localizePath(lang), SITE).href

const KNOWS_ABOUT: Record<Lang, string[]> = {
  es: [
    "Automatización de procesos empresariales",
    "Agentes de IA",
    "Evaluación de modelos de lenguaje",
    "Observabilidad de sistemas de IA",
    "Retrieval Augmented Generation",
    "Integración de IA en producto",
  ],
  en: [
    "Business process automation",
    "AI agents",
    "Large language model evaluation",
    "AI systems observability",
    "Retrieval Augmented Generation",
    "AI product integration",
  ],
  ar: [
    "أتمتة العمليات في الشركات",
    "وكلاء الذكاء الاصطناعي",
    "تقييم النماذج اللغوية الكبيرة",
    "مراقبة أنظمة الذكاء الاصطناعي",
    "التوليد المعزَّز بالاسترجاع",
    "دمج الذكاء الاصطناعي في المنتجات",
  ],
}

/**
 * Datos estructurados. Sólo hechos declarables sobre la empresa y su oferta:
 * no se incluyen Review ni AggregateRating, que exigen reseñas reales y
 * verificables para ser válidos ante Google y los motores de respuesta.
 */
const organization = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${SITE}/#organization`,
  name: "Vantalogics",
  url: SITE,
  logo: `${SITE}/logo-va@2x.png`,
  image: `${SITE}${ogImage(lang)}`,
  description: t.meta.description,
  email: "hello@vantalogics.com",
  telephone: "+541178296140",
  slogan: t.hero.title,
  sameAs: [GITHUB_URL, INSTAGRAM_URL],
  /**
   * `knowsAbout` va en el idioma de la página: es el texto que un motor de
   * respuesta cita cuando resume a la empresa, y una lista en español dentro
   * de la página árabe se cita en español.
   */
  knowsAbout: KNOWS_ABOUT[lang],
  areaServed: [
    { "@type": "Place", name: "Latin America" },
    { "@type": "Country", name: "Spain" },
    { "@type": "Country", name: "United States" },
    { "@type": "Country", name: "United Arab Emirates" },
    { "@type": "Place", name: "Gulf Cooperation Council" },
  ],
  availableLanguage: LANGS,
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: t.services.titleBright,
    itemListElement: t.services.items.map((service) => ({
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: service.title,
        description: service.summary,
      },
    })),
  },
}

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE}/#website`,
  url: SITE,
  name: "Vantalogics",
  inLanguage: lang,
  description: t.meta.description,
  publisher: { "@id": `${SITE}/#organization` },
}

const webPage = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: t.meta.title,
  description: t.meta.description,
  inLanguage: lang,
  isPartOf: { "@id": `${SITE}/#website` },
  about: { "@id": `${SITE}/#organization` },
}

/**
 * Las industrias foco, como lista enlazada desde la portada.
 *
 * `ItemList` y no cuatro `Service` sueltos: lo que se declara acá es que la
 * portada es el índice de esas dos páginas, que es la relación que hace que un
 * motor de respuesta las trate como el contenido canónico de la empresa sobre
 * cada rubro en vez de como dos páginas más del sitio.
 */
const industriesList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${pageUrl}#industrias`,
  name: t.industries.label,
  description: t.industries.body,
  itemListElement: FOCUS_SOLUTIONS.map((solution, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: solution.title[lang],
    description: solution.answer[lang],
    url: new URL(solutionPath(lang, solution), SITE).href,
  })),
}

const faqPage = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${pageUrl}#faq`,
  inLanguage: lang,
  mainEntity: t.faq.entries.map((entry) => ({
    "@type": "Question",
    name: entry.question,
    acceptedAnswer: { "@type": "Answer", text: entry.answer },
  })),
}
---

<Layout
  lang={lang}
  jsonLd={[organization, website, webPage, industriesList, faqPage]}
>
  <SiteHeader lang={lang} />

  <main id="contenido">
    <Hero lang={lang} />
    <Tools lang={lang} />
    <Problem lang={lang} />
    <Services lang={lang} />
    <Industries lang={lang} />
    <AgentDemo lang={lang} />
    <Process lang={lang} />
    <Proof lang={lang} />
    <Faq lang={lang} />
    <CallToAction lang={lang} />
  </main>

  <SiteFooter lang={lang} />
</Layout>
