---
import Layout from "@/layouts/main.astro"
import SiteHeader from "@/components/site/SiteHeader.astro"
import Hero from "@/components/site/Hero.astro"
import Signals from "@/components/site/Signals.astro"
import Thesis from "@/components/site/Thesis.astro"
import Capabilities from "@/components/site/Capabilities.astro"
import Cases from "@/components/site/Cases.astro"
import AgentDemo from "@/components/site/AgentDemo.astro"
import Process from "@/components/site/Process.astro"
import Principles from "@/components/site/Principles.astro"
import Insights from "@/components/site/Insights.astro"
import Faq from "@/components/site/Faq.astro"
import CallToAction from "@/components/site/CallToAction.astro"
import SiteFooter from "@/components/site/SiteFooter.astro"
import {
  LANGS,
  localizePath,
  ogImage,
  useTranslations,
  type Lang,
} from "@/i18n"
import { GITHUB_URL, INSTAGRAM_URL } from "@/site"
import { EDTECH, solutionPath } from "@/data/solutions"
import { casePath, casesFor } from "@/data/use-cases"

interface Props {
  lang: Lang
}

const SITE = "https://vantalogics.com"
const { lang } = Astro.props
const t = useTranslations(lang)
const pageUrl = new URL(localizePath(lang), SITE).href

const KNOWS_ABOUT: Record<Lang, string[]> = {
  es: [
    "Tutores de IA para plataformas educativas",
    "Corrección asistida con rúbrica",
    "Retrieval Augmented Generation sobre contenido educativo",
    "Evaluación de modelos de lenguaje",
    "Observabilidad y costo de sistemas de IA",
    "Integración de IA en producto EdTech",
  ],
  en: [
    "AI tutors for learning platforms",
    "Rubric-based assisted grading",
    "Retrieval Augmented Generation over educational content",
    "Large language model evaluation",
    "AI systems observability and cost control",
    "AI product integration for EdTech",
  ],
}

/**
 * Datos estructurados. Sólo hechos declarables sobre la empresa y su oferta:
 * no se incluyen Review ni AggregateRating, que exigen reseñas reales y
 * verificables para ser válidos ante Google y los motores de respuesta.
 */
const organization = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${SITE}/#organization`,
  name: "Vantalogics",
  url: SITE,
  logo: `${SITE}/logo-va@2x.png`,
  image: `${SITE}${ogImage(lang)}`,
  description: t.meta.description,
  email: "hello@vantalogics.com",
  telephone: "+541178296140",
  slogan: `${t.hero.title} ${t.hero.titleMark}`,
  sameAs: [GITHUB_URL, INSTAGRAM_URL],
  /**
   * `knowsAbout` va en el idioma de la página: es el texto que un motor de
   * respuesta cita cuando resume a la empresa, y una lista en español dentro
   * de la página en inglés se cita en español.
   */
  knowsAbout: KNOWS_ABOUT[lang],
  /** La especialización, declarada como dato y no sólo como texto. */
  audience: {
    "@type": "BusinessAudience",
    name: EDTECH.sector[lang],
    audienceType: "EdTech companies and learning platforms",
  },
  areaServed: [
    { "@type": "Place", name: "Latin America" },
    { "@type": "Country", name: "Spain" },
    { "@type": "Country", name: "United States" },
  ],
  availableLanguage: LANGS,
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: t.capabilities.label,
    itemListElement: t.capabilities.items.map((item) => ({
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: item.title,
        description: item.summary,
      },
    })),
  },
}

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE}/#website`,
  url: SITE,
  name: "Vantalogics",
  inLanguage: lang,
  description: t.meta.description,
  publisher: { "@id": `${SITE}/#organization` },
}

const webPage = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: t.meta.title,
  description: t.meta.description,
  inLanguage: lang,
  isPartOf: { "@id": `${SITE}/#website` },
  about: { "@id": `${SITE}/#organization` },
}

/**
 * Los cuatro casos de uso, como lista enlazada desde la portada.
 *
 * `ItemList` y no cuatro `Service` sueltos: lo que se declara es que la
 * portada es el índice de esas páginas, que es la relación que hace que un
 * motor de respuesta las trate como el contenido canónico de la empresa sobre
 * cada implementación en vez de como cuatro páginas más del sitio.
 */
const useCasesList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${pageUrl}#implementaciones`,
  name: t.solutions.useCasesLabel,
  description: t.solutions.useCasesIntro,
  itemListElement: casesFor(EDTECH).map((useCase, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: useCase.title[lang],
    description: useCase.answer[lang],
    url: new URL(casePath(lang, EDTECH, useCase), SITE).href,
  })),
}

const faqPage = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${pageUrl}#faq`,
  inLanguage: lang,
  mainEntity: t.faq.entries.map((entry) => ({
    "@type": "Question",
    name: entry.question,
    acceptedAnswer: { "@type": "Answer", text: entry.answer },
  })),
}
---

<Layout
  lang={lang}
  jsonLd={[organization, website, webPage, useCasesList, faqPage]}
>
  <SiteHeader lang={lang} />

  <main id="contenido">
    <Hero lang={lang} />
    <Signals lang={lang} />
    <Thesis lang={lang} />
    <Capabilities lang={lang} />
    <Cases lang={lang} />
    <AgentDemo lang={lang} />
    <Process lang={lang} />
    <Principles lang={lang} />
    <Insights lang={lang} />
    <Faq lang={lang} />
    <CallToAction lang={lang} />
  </main>

  <SiteFooter lang={lang} />
</Layout>

<script is:inline define:vars={{ sectorUrl: solutionPath(lang, EDTECH) }}>
  // Prefetch de la página de sector: es el destino más probable después de la
  // portada y pesa poco. Se hace en reposo para no competir con el hero.
  if ("requestIdleCallback" in window) {
    requestIdleCallback(() => {
      const link = document.createElement("link")
      link.rel = "prefetch"
      link.href = sectorUrl
      document.head.appendChild(link)
    })
  }
</script>
