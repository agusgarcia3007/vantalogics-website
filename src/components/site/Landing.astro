---
import Layout from "@/layouts/main.astro"
import SiteHeader from "@/components/site/SiteHeader.astro"
import SiteFooter from "@/components/site/SiteFooter.astro"
import CallToAction from "@/components/site/CallToAction.astro"
import Hero from "@/components/home/Hero.astro"
import Ecosystem from "@/components/home/Ecosystem.astro"
import Cases from "@/components/home/Cases.astro"
import Thesis from "@/components/home/Thesis.astro"
import Capabilities from "@/components/home/Capabilities.astro"
import Difference from "@/components/home/Difference.astro"
import Process from "@/components/home/Process.astro"
import Principles from "@/components/home/Principles.astro"
import Insights from "@/components/home/Insights.astro"
import { CASES } from "@/data/cases"
import {
  PUBLIC_LANGS,
  localizePath,
  ogImage,
  useTranslations,
  type Lang,
} from "@/i18n"
import { CONTACT_EMAIL, GITHUB_URL, INSTAGRAM_URL } from "@/site"

interface Props {
  lang: Lang
}

const SITE = "https://vantalogics.com"
const { lang } = Astro.props
const t = useTranslations(lang)
const pageUrl = new URL(localizePath(lang), SITE).href
const hasCases = CASES.length > 0

const KNOWS_ABOUT: Record<Lang, string[]> = {
  es: [
    "Tecnología educativa",
    "Agentes de IA especializados",
    "Evaluación asistida por IA",
    "Plataformas de aprendizaje",
    "Integraciones LTI 1.3, xAPI y SCORM",
    "Evaluación de modelos de lenguaje",
    "Retrieval Augmented Generation",
  ],
  en: [
    "Education technology",
    "Specialized AI agents",
    "AI-assisted assessment",
    "Learning platforms",
    "LTI 1.3, xAPI and SCORM integrations",
    "Large language model evaluation",
    "Retrieval Augmented Generation",
  ],
  ar: [
    "تقنيات التعليم",
    "وكلاء الذكاء الاصطناعي المتخصصون",
    "التقييم بمساعدة الذكاء الاصطناعي",
    "منصات التعلّم",
    "تكاملات LTI 1.3 وxAPI وSCORM",
    "تقييم النماذج اللغوية الكبيرة",
    "التوليد المعزَّز بالاسترجاع",
  ],
}

/**
 * Datos estructurados. Sólo hechos declarables sobre la empresa y su oferta:
 * nada de Review ni AggregateRating, que exigen reseñas reales y verificables.
 */
const organization = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${SITE}/#organization`,
  name: "Vantalogics",
  url: SITE,
  logo: `${SITE}/logo-va@2x.png`,
  image: `${SITE}${ogImage(lang)}`,
  description: t.footer.tagline,
  email: CONTACT_EMAIL,
  telephone: "+541178296140",
  slogan: t.hero.title,
  sameAs: [GITHUB_URL, INSTAGRAM_URL],
  knowsAbout: KNOWS_ABOUT[lang],
  audience: {
    "@type": "BusinessAudience",
    audienceType: t.hero.eyebrow,
  },
  areaServed: [
    { "@type": "Place", name: "Latin America" },
    { "@type": "Country", name: "Spain" },
    { "@type": "Country", name: "United States" },
  ],
  availableLanguage: PUBLIC_LANGS,
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: t.capabilities.title,
    itemListElement: t.capabilities.items.map((item) => ({
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: item.title,
        description: item.summary,
        serviceType: t.capabilities.eyebrow,
      },
    })),
  },
}

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE}/#website`,
  url: SITE,
  name: "Vantalogics",
  inLanguage: lang,
  description: t.meta.description,
  publisher: { "@id": `${SITE}/#organization` },
}

const webPage = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: t.meta.title,
  description: t.meta.description,
  inLanguage: lang,
  isPartOf: { "@id": `${SITE}/#website` },
  about: { "@id": `${SITE}/#organization` },
}

/** El proceso de trabajo, como pasos ordenados. */
const process = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "@id": `${pageUrl}#proceso`,
  name: t.process.title,
  inLanguage: lang,
  step: t.process.steps.map((step, index) => ({
    "@type": "HowToStep",
    position: index + 1,
    name: step.title,
    text: step.body,
    url: `${pageUrl}#proceso`,
  })),
}
---

<Layout lang={lang} jsonLd={[organization, website, webPage, process]}>
  <SiteHeader lang={lang} />

  <main id="contenido">
    <Hero lang={lang} hasCases={hasCases} />
    <Ecosystem lang={lang} />
    <Cases lang={lang} />
    <Thesis lang={lang} />
    <Capabilities lang={lang} />
    <Difference lang={lang} />
    <Process lang={lang} />
    <Principles lang={lang} />
    <Insights lang={lang} />
    <CallToAction lang={lang} />
  </main>

  <SiteFooter lang={lang} />
</Layout>

<script>
  import "@/scripts/home-motion"
</script>
