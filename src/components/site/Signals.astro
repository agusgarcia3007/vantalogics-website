---
import Frame from "@/components/site/Frame.astro"
import { useTranslations, type Lang } from "@/i18n"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang).signals

// La franja de confianza.
//
// En vez de un muro de logos de clientes —que a esta altura serían prestados—
// dice dónde vive el sistema. Los nombres y estándares del rubro hacen el mismo
// trabajo («esto se enchufa a tu mundo real») y son verificables. Se leen como
// una lista de materiales al pie de un plano, no como tarjetas.
---

<Frame class="bg-canvas">
  <div
    class="grid gap-x-[clamp(32px,5vw,72px)] gap-y-8 lg:grid-cols-[minmax(0,0.62fr)_minmax(0,1fr)]"
  >
    <div data-reveal>
      <h2 class="display-sm max-w-[18ch] text-bone">{t.title}</h2>
      <p class="copy mt-4 max-w-[38ch] text-[15px] text-ash">{t.note}</p>
    </div>

    <ul
      class="grid grid-cols-2 gap-px self-start border border-hairline bg-hairline sm:grid-cols-4"
      data-reveal
      style="--reveal-delay: 120ms;"
    >
      {
        t.items.map((item) => (
          <li class="signal flex min-h-[64px] items-center justify-center bg-canvas px-3 py-4 text-center">
            <span class="label-mono text-bone">{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</Frame>

<style>
  .signal {
    transition: background-color var(--duration-state) var(--ease-paper);
  }

  .signal:hover {
    background-color: var(--color-surface);
  }
</style>
