---
import { HugeiconsIcon } from "@hugeicons/react"
import { Tick02Icon } from "@hugeicons/core-free-icons"

import AgentInline from "@/components/site/AgentInline.astro"
import Frame from "@/components/site/Frame.astro"
import SectionTitle from "@/components/site/SectionTitle.astro"
import { useTranslations, type Lang } from "@/i18n"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang).agentDemo
---

<Frame labelledby="demo">
  <div
    class="grid items-center gap-x-[clamp(32px,5vw,72px)] gap-y-[clamp(36px,5vw,56px)] lg:grid-cols-[minmax(0,1fr)_minmax(0,420px)]"
  >
    <div>
      <SectionTitle
        id="demo"
        label={t.label}
        muted={t.titleMuted}
        bright={t.titleBright}
        class="max-w-[24ch]"
      />

      <p
        class="copy mt-6 max-w-[52ch] text-ash"
        data-reveal
        style="--reveal-delay: 100ms;"
      >
        {t.body}
      </p>

      <ul class="mt-8 flex flex-col gap-[11px]">
        {
          t.points.map((point, i) => (
            <li
              class="flex items-start gap-[10px]"
              data-reveal
              style={`--reveal-delay: ${180 + i * 70}ms;`}
            >
              <HugeiconsIcon
                icon={Tick02Icon}
                size={15}
                strokeWidth={2}
                className="mt-[3px] shrink-0 text-ash"
              />
              <span class="label-untitled text-bone">{point}</span>
            </li>
          ))
        }
      </ul>

    </div>

    {/* El agente, embebido y funcionando. Ya no hay botón que abra un panel:
        la sección dice "probalo ahora" y lo que sigue es el campo donde se
        prueba. Un CTA acá sería un paso de más para llegar al mismo chat. */}
    <div class="w-full" style="--reveal-delay: 200ms;">
      <AgentInline lang={lang} />
    </div>
  </div>
</Frame>
