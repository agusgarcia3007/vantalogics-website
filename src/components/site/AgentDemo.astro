---
import AgentInline from "@/components/site/AgentInline.astro"
import Frame from "@/components/site/Frame.astro"
import SectionTitle from "@/components/site/SectionTitle.astro"
import { useTranslations, type Lang } from "@/i18n"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang).agentDemo
---

<Frame labelledby="demo">
  <div
    class="grid items-center gap-x-[clamp(32px,5vw,80px)] gap-y-[clamp(36px,5vw,56px)] lg:grid-cols-[minmax(0,1fr)_minmax(0,430px)]"
  >
    <div>
      <SectionTitle
        id="demo"
        index="04"
        label={t.label}
        muted={t.titleMuted}
        bright={t.titleBright}
        class="max-w-[22ch]"
      />

      <p
        class="copy mt-7 max-w-[52ch] text-ash"
        data-reveal
        style="--reveal-delay: 100ms;"
      >
        {t.body}
      </p>

      <ul class="mt-9 flex flex-col">
        {
          t.points.map((point, i) => (
            <li
              class="flex items-start gap-3 border-t border-hairline py-[13px]"
              data-reveal
              style={`--reveal-delay: ${180 + i * 70}ms;`}
            >
              <span
                class="mt-[11px] h-px w-3 shrink-0 bg-pen"
                aria-hidden="true"
              />
              <span class="copy text-[15px] text-bone">{point}</span>
            </li>
          ))
        }
      </ul>

      <p class="annotation mt-8 max-w-[30ch]" data-reveal>{t.annotation}</p>
    </div>

    {/* El agente, embebido y funcionando. No hay botón que abra un panel: la
        sección dice «probalo ahora» y lo que sigue es el campo donde se
        prueba. */}
    <div class="w-full" style="--reveal-delay: 200ms;">
      <AgentInline lang={lang} />
    </div>
  </div>
</Frame>
