---
import SectionHeading from "@/components/site/SectionHeading.astro"
import { useTranslations, type Lang } from "@/i18n"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang).proof

// PLACEHOLDER: nombres de ejemplo. Reemplazar por clientes reales (con su
// autorización) antes de publicar el sitio.
const clients = [
  "Norvia Group",
  "Altamar Logística",
  "Cedro Salud",
  "Belfor Retail",
  "Quantia Seguros",
  "Marden Industrial",
]
---

<section id="resultados" aria-labelledby="resultados-titulo" class="rule-b">
  <!-- Franja de clientes -->
  <div class="rule-b page-x py-[clamp(32px,4vw,50px)]" data-reveal>
    <p class="label-untitled text-muted-ash">{t.clientsLabel}</p>
    <ul
      class="mt-[30px] flex flex-wrap items-center gap-x-[50px] gap-y-6"
      aria-label={t.clientsAria}
    >
      {
        clients.map((client) => (
          <li class="font-opx text-subheading text-bone/80 transition-colors duration-(--duration-state) ease-(--ease-opx) hover:text-bone">
            {client}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="band-y">
    <SectionHeading
      id="resultados-titulo"
      label={t.label}
      title={t.title}
      intro={t.intro}
    />

    <ul
      class="page-x mt-[clamp(48px,7vw,100px)] grid gap-x-[50px] gap-y-[clamp(40px,5vw,80px)] lg:grid-cols-3"
    >
      {
        t.results.map((result, i) => (
          <li data-reveal style={`--reveal-delay: ${i * 90}ms;`}>
            <p class="label-untitled text-muted-ash">{result.sector}</p>
            <p class="mt-6 font-opx text-[clamp(2.5rem,5vw,3.125rem)] leading-[1.1] text-bone">
              {result.metric}
            </p>
            <p class="label-untitled mt-3 text-bone">{result.metricLabel}</p>
            <span
              class="mt-[30px] block h-px w-full origin-left bg-hairline"
              aria-hidden="true"
              data-rule-draw
            />
            <p class="copy mt-[30px] text-muted-ash">{result.body}</p>
          </li>
        ))
      }
    </ul>

    <!-- Testimonios -->
    <h3 class="page-x label-untitled mt-[clamp(56px,8vw,150px)] text-muted-ash">
      {t.testimonialsTitle}
    </h3>

    <ul
      class="page-x mt-[30px] grid gap-x-[50px] gap-y-[clamp(40px,5vw,80px)] lg:grid-cols-3"
    >
      {
        t.testimonials.map((testimonial, i) => (
          <li data-reveal style={`--reveal-delay: ${i * 90}ms;`}>
            <figure class="flex h-full flex-col justify-between">
              <blockquote>
                <p class="font-opx text-subheading text-bone lg:text-heading-sm">
                  <span aria-hidden="true">“</span>
                  {testimonial.quote}
                  <span aria-hidden="true">”</span>
                </p>
              </blockquote>

              <figcaption class="mt-[30px] pt-[30px] border-t border-hairline">
                <span class="copy block text-bone">{testimonial.name}</span>
                <span class="label-untitled block text-muted-ash">
                  {testimonial.role} · {testimonial.company}
                </span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>
