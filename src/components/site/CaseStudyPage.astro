---
import Layout from "@/layouts/main.astro"
import Chrome from "@/components/cine/Chrome.astro"
import Foot from "@/components/cine/Foot.astro"
import LinkCard from "@/components/cine/LinkCard.astro"
import { CLIENTS } from "@/data/clients"
import { getPosts, postPath, postSlug } from "@/lib/blog"
import {
  CASES,
  caseStudyPath,
  formatStudents,
  type CaseStudy,
  type Localized,
} from "@/data/cases"
import {
  LANGS,
  localizePath,
  navHref,
  useTranslations,
  type Lang,
} from "@/i18n"
import {
  findPlatformPage,
  platformPath,
  platformsRoot,
} from "@/lib/plataformas"
import { SCHEDULE_URL } from "@/site"

interface Props {
  lang: Lang
  study: CaseStudy
}

const SITE = "https://vantalogics.com"
const { lang, study } = Astro.props
const strings = useTranslations(lang)
const t = strings.cases
const casesHref = navHref(
  lang,
  strings.nav.items.find((item) => item.section === "cases")?.href ?? "#casos"
)
const client = CLIENTS.find((entry) => entry.caseSlug === study.slug)!
const pick = (value: Localized) => value[lang] ?? value.en
const metricValue = (value: string | Localized) =>
  typeof value === "string" ? value : pick(value)
const path = caseStudyPath(lang, study.slug)
const pageUrl = new URL(path, SITE).href
const clientName = pick(study.client)
const title = pick(study.title)
const description = pick(study.built)
const metaTitle = `${clientName}: ${pick(study.kind)} | Vantalogics`
const metaDescription = pick(study.summary)

const platformsHref = platformsRoot(lang)
const platformLinks = platformsHref
  ? [{ href: platformsHref, label: strings.platforms.hubLink }]
  : []

const guides = (
  await Promise.all(
    (study.guides ?? []).map(async (key) => {
      const page = await findPlatformPage(lang, key)
      if (!page && lang !== "ar") {
        throw new Error(
          `El caso «${study.slug}» apunta a la guía «${key}», que no existe en ${lang}.`
        )
      }
      return page
    })
  )
).flatMap((page) =>
  page
    ? [
        {
          href: platformPath(page),
          title: page.data.title,
          description: page.data.description,
          id: `${new URL(platformPath(page), SITE).href}#webpage`,
        },
      ]
    : []
)

const posts = await getPosts(lang)
const notes = (study.reading ?? []).flatMap((slug) => {
  const post = posts.find(
    (entry) => postSlug(entry) === slug || entry.data.translationOf === slug
  )
  if (!post && lang !== "ar") {
    throw new Error(
      `El caso «${study.slug}» apunta a la nota «${slug}», que no existe en ${lang}.`
    )
  }
  return post
    ? [
        {
          href: postPath(post),
          title: post.data.title,
          description: post.data.description,
          id: `${new URL(postPath(post), SITE).href}#article`,
        },
      ]
    : []
})

const learned = [...guides, ...notes]

const others = CASES.filter((entry) => entry.slug !== study.slug).map(
  (entry) => ({
    href: caseStudyPath(lang, entry.slug),
    title: `${pick(entry.client)}: ${pick(entry.kind)}`,
    description: pick(entry.summary),
  })
)

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Vantalogics",
      item: new URL(localizePath(lang), SITE).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: clientName,
      item: pageUrl,
    },
  ],
}

const creativeWork = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "@id": `${pageUrl}#case-study`,
  name: title,
  headline: title,
  description,
  inLanguage: lang,
  url: pageUrl,
  dateModified: new Date(study.updated).toISOString(),
  creator: {
    "@type": "Organization",
    "@id": `${SITE}/#organization`,
    name: "Vantalogics",
    url: SITE,
  },
  about: {
    "@type": "Organization",
    name: clientName,
    url: pick(study.href),
  },
  ...(learned.length > 0
    ? { subjectOf: learned.map(({ id }) => ({ "@id": id })) }
    : {}),
}
---

<Layout
  lang={lang}
  path={path}
  title={metaTitle}
  description={metaDescription}
  alternates={Object.fromEntries(
    LANGS.map((code) => [code, caseStudyPath(code, study.slug)])
  )}
  jsonLd={[breadcrumb, creativeWork]}
  floating={false}
>
  <Chrome lang={lang}>
    <main class="case-page" id="contenido">
      <div class="case-wrap">
        <nav
          class="crumbs appear appear--soft"
          style="--d:0.16s"
          aria-label="Breadcrumb"
        >
          <a href={localizePath(lang)}>Vantalogics</a>
          <span aria-hidden="true">/</span>
          <a href={casesHref}>{t.detail.breadcrumb}</a>
          <span aria-hidden="true">/</span>
          <span>{clientName}</span>
        </nav>

        <div class="case-head">
          <div>
            <h1 class="appear appear--soft" style="--d:0.26s">{title}</h1>
            <p class="case-period appear appear--soft" style="--d:0.38s">
              {pick(study.period)}
            </p>
          </div>
          <div
            class="case-logo appear appear--scale"
            style="--d:0.46s"
            aria-label={clientName}
          >
            <img
              src={client.logo}
              alt={client.logoAlt}
              decoding="async"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </main>

    <div class="below" slot="after">
      <section class="section">
        <div class="case-wrap">
          <div class="section-head">
            <span class="eyebrow">{t.detail.scope}</span>
          </div>
          <div class="metrics">
            <div>
              <div class="metric-v">{formatStudents(lang, study.students)}</div>
              <div class="metric-l">{t.detail.students}</div>
            </div>
            {
              study.metrics.map((metric) => (
                <div>
                  <div class="metric-v">{metricValue(metric.value)}</div>
                  <div class="metric-l">{pick(metric.label)}</div>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section">
        <div class="case-wrap cols">
          <article>
            <h2>{t.detail.challenge}</h2>
            <p>{pick(study.start)}</p>
          </article>
          <article>
            <h2>{t.detail.built}</h2>
            <p>{pick(study.built)}</p>
          </article>
        </div>
      </section>

      <section class="section">
        <div class="case-wrap components">
          <h2>{t.detail.components}</h2>
          <ul>
            {study.integrations.map((item) => <li>{pick(item)}</li>)}
          </ul>

          <div class="case-foot" style="margin-top: 40px">
            <a
              class="btn btn-solid"
              href={pick(study.href)}
              target="_blank"
              rel="noopener noreferrer">{t.detail.visit}</a
            >
            <a
              class="btn btn-ghost"
              href={SCHEDULE_URL}
              target="_blank"
              rel="noopener">{strings.nav.cta}</a
            >
            <a class="case-back" href={casesHref}>{t.detail.back}</a>
          </div>

          {
            platformLinks.map((link) => (
              <p class="section-more">
                <a href={link.href}>{link.label}</a>
              </p>
            ))
          }
        </div>
      </section>

      {
        learned.length > 0 && (
          <section class="section" aria-labelledby="aprendimos">
            <div class="shell">
              <div class="section-head reveal">
                <h2 id="aprendimos">{t.detail.learned}</h2>
              </div>
              <div class="posts">
                {learned.map((item, index) => (
                  <LinkCard
                    href={item.href}
                    title={item.title}
                    description={item.description}
                    featured={learned.length % 2 === 1 && index === 0}
                    index={index}
                  />
                ))}
              </div>
            </div>
          </section>
        )
      }

      <section class="section" aria-labelledby="otros-casos">
        <div class="shell">
          <div class="section-head reveal">
            <h2 id="otros-casos">{t.detail.others}</h2>
          </div>
          <div class="posts">
            {
              others.map((item, index) => (
                <LinkCard
                  href={item.href}
                  title={item.title}
                  description={item.description}
                  featured={others.length % 2 === 1 && index === 0}
                  index={index}
                />
              ))
            }
          </div>
        </div>
      </section>

      <Foot lang={lang} />
    </div>
  </Chrome>
</Layout>
