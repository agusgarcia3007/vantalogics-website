---
import Frame from "@/components/site/Frame.astro"
import MetricChart from "@/components/site/MetricChart.astro"
import SectionTitle from "@/components/site/SectionTitle.astro"
import { useTranslations, type Lang } from "@/i18n"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang).proof
---

<Frame id="resultados" labelledby="resultados-titulo">
  <div
    class="grid gap-x-[clamp(32px,5vw,72px)] gap-y-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1fr)]"
  >
    <SectionTitle
      id="resultados-titulo"
      label={t.label}
      muted={t.titleMuted}
      bright={t.titleBright}
    />
    <p
      class="copy max-w-[54ch] self-end text-ash"
      data-reveal
      style="--reveal-delay: 100ms;"
    >
      {t.intro}
    </p>
  </div>

  <!-- El caso principal, con la cifra en escala grande y la caída dibujada al
       lado. Un número solo es una afirmación; el número más la forma de la
       curva es una demostración. -->
  <div
    class="mt-[clamp(48px,6vw,80px)] grid items-center gap-x-[clamp(32px,5vw,72px)] gap-y-10 rounded-[20px] border border-hairline p-[clamp(24px,3.4vw,44px)] lg:grid-cols-2"
    data-reveal
  >
    <div>
      <p class="flex items-baseline gap-3">
        <span class="display-hero text-bone">{t.headline.value}</span>
        <span class="label-untitled text-ash">{t.headline.unit}</span>
      </p>
      <p class="mt-3 max-w-[22ch] font-untitled text-[20px] leading-snug text-bone">
        {t.headline.title}
      </p>
      <p class="copy mt-5 max-w-[46ch] text-ash">{t.headline.body}</p>
    </div>

    <MetricChart
      label={t.headline.chartLabel}
      from={t.headline.chartFrom}
      to={t.headline.chartTo}
    />
  </div>

  <!-- Los otros dos casos, más la repetición del principal en su forma corta:
       tres métricas comparables una al lado de la otra. -->
  <ul class="mt-[clamp(40px,5vw,64px)] grid gap-x-[clamp(24px,3vw,40px)] gap-y-10 md:grid-cols-3">
    {
      t.results.map((result, i) => (
        <li
          class="border-t border-hairline pt-6"
          data-reveal
          style={`--reveal-delay: ${i * 90}ms;`}
        >
          <p class="font-untitled text-[34px] leading-none tracking-[-0.02em] text-bone">
            {result.metric}
          </p>
          <p class="label-untitled mt-3 text-bone">{result.metricLabel}</p>
          <p class="label-untitled mt-1 text-muted-ash">{result.sector}</p>
          <p class="copy mt-4 text-ash">{result.body}</p>
        </li>
      ))
    }
  </ul>

  <h3 class="label-untitled mt-[clamp(48px,6vw,80px)] text-muted-ash" data-reveal>
    {t.testimonialsTitle}
  </h3>

  <ul class="mt-8 grid gap-x-[clamp(24px,3vw,40px)] gap-y-10 md:grid-cols-3">
    {
      t.testimonials.map((testimonial, i) => (
        <li data-reveal style={`--reveal-delay: ${i * 90}ms;`}>
          <figure>
            <blockquote class="copy text-bone">
              «{testimonial.quote}»
            </blockquote>
            <figcaption class="label-untitled mt-5 text-ash">
              <span class="text-bone">{testimonial.name}</span>
              <span class="mt-1 block text-muted-ash">
                {testimonial.role} · {testimonial.company}
              </span>
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>

  <ul class="mt-[clamp(48px,6vw,80px)] grid grid-cols-2 gap-x-[clamp(24px,3vw,40px)] gap-y-8 lg:grid-cols-4">
    {
      t.stats.map((stat, i) => (
        <li
          class="border-t border-hairline pt-5"
          data-reveal
          style={`--reveal-delay: ${i * 70}ms;`}
        >
          <p class="font-untitled text-[26px] leading-none tracking-[-0.02em] text-bone">
            {stat.value}
          </p>
          <p class="label-untitled mt-3 max-w-[22ch] text-muted-ash">
            {stat.label}
          </p>
        </li>
      ))
    }
  </ul>
</Frame>
