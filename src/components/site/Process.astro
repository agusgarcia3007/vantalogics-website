---
import Frame from "@/components/site/Frame.astro"
import SectionTitle from "@/components/site/SectionTitle.astro"
import { useTranslations, type Lang } from "@/i18n"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang).process
---

<Frame id="proceso" labelledby="como-trabajamos" class="bg-canvas">
  <SectionTitle
    id="como-trabajamos"
    index="05"
    label={t.label}
    muted={t.titleMuted}
    bright={t.titleBright}
    class="max-w-[34ch]"
  />

  <!-- Cuatro fases sobre una sola línea de tiempo. La regla horizontal es una
       sola y cruza las cuatro columnas; cada fase la marca con un punto, como
       las marcas de un cronograma dibujado a mano. -->
  <ol
    class="mt-[clamp(44px,5vw,72px)] grid gap-x-[clamp(24px,3vw,44px)] gap-y-12 md:grid-cols-2 lg:grid-cols-4"
  >
    {
      t.steps.map((step, i) => (
        <li data-reveal style={`--reveal-delay: ${i * 90}ms;`}>
          <div class="flex items-center gap-3">
            <span class="label-mono-sm text-pen-ink" data-numeral>
              {step.step}
            </span>
            <span class="relative h-px flex-1 bg-hairline">
              <span
                class="absolute -top-[2px] left-0 size-[5px] rounded-full bg-pen"
                aria-hidden="true"
              />
            </span>
          </div>

          <h3 class="display-sm mt-6 text-bone">{step.title}</h3>

          <p class="copy mt-4 text-[15px] text-ash">{step.body}</p>

          <p class="label-mono-sm mt-5 text-faint">{step.meta}</p>
        </li>
      ))
    }
  </ol>
</Frame>
