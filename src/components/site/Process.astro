---
import Frame from "@/components/site/Frame.astro"
import SectionTitle from "@/components/site/SectionTitle.astro"
import { useTranslations, type Lang } from "@/i18n"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang).process
---

<Frame id="proceso" labelledby="como-trabajamos">
  <SectionTitle
    id="como-trabajamos"
    label={t.label}
    muted={t.titleMuted}
    bright={t.titleBright}
    class="max-w-[38ch]"
  />

  <!-- Cuatro fases en una sola línea de tiempo horizontal en desktop, con el
       número anclado a una regla: el orden se ve antes de leer nada. -->
  <ol
    class="mt-[clamp(40px,5vw,64px)] grid gap-x-[clamp(24px,3vw,40px)] gap-y-10 md:grid-cols-2 lg:grid-cols-4"
  >
    {
      t.steps.map((step, i) => (
        <li data-reveal style={`--reveal-delay: ${i * 90}ms;`}>
          <div class="flex items-center gap-3">
            <span class="font-untitled text-[15px] font-medium text-bone">
              {step.step}
            </span>
            <span class="h-px flex-1 bg-hairline" />
          </div>

          <h3 class="mt-5 font-untitled text-[19px] leading-tight text-bone">
            {step.title}
          </h3>

          <p class="copy mt-3 text-ash">{step.body}</p>

          <p class="label-untitled mt-4 text-muted-ash">{step.meta}</p>
        </li>
      ))
    }
  </ol>
</Frame>
