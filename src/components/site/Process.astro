---
import SectionHeading from "@/components/site/SectionHeading.astro"
import { useTranslations, type Lang } from "@/i18n"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang).process
---

<section id="proceso" aria-labelledby="proceso-titulo" class="band-y rule-b">
  <SectionHeading id="proceso-titulo" label={t.label} title={t.title} />

  <ol
    class="mt-[clamp(40px,6vw,80px)] grid gap-x-[50px] gap-y-[clamp(32px,4vw,72px)] page-x sm:grid-cols-2 lg:grid-cols-4"
  >
    {
      t.steps.map((item, i) => (
        <li data-reveal style={`--reveal-delay: ${i * 90}ms;`}>
          <p class="label-untitled text-muted-ash">{item.step}</p>

          {/* El numeral grande es decorativo y repite lo que ya dice «Fase 01».
              En una columna cuesta ~70px por paso, así que sólo aparece cuando
              hay cuatro columnas y su escala tiene función compositiva. */}
          <p
            class="mt-[30px] hidden font-opx text-heading-lg text-bone lg:block"
            aria-hidden="true"
          >
            {String(i + 1).padStart(2, "0")}
          </p>

          <span
            class="mt-[15px] block h-px w-full origin-left bg-hairline"
            aria-hidden="true"
            data-rule-draw
          />

          <h3 class="mt-5 font-opx text-subheading text-bone lg:mt-[30px]">
            {item.title}
          </h3>
          <p class="mt-3 copy text-muted-ash lg:mt-4">{item.body}</p>
        </li>
      ))
    }
  </ol>
</section>
