---
interface Props {
  label: string
  from: string
  to: string
}

const { label, from, to } = Astro.props

// La caída, dibujada. Doce barras que van de la altura de la operación manual
// a la altura de hoy: no hace falta leer el número para entender la forma.
// Las últimas cuatro van en positivo porque son las que ya corren solas.
const bars = [96, 92, 99, 90, 94, 88, 71, 52, 33, 22, 18, 16]
const solidFrom = 8
---

<figure class="w-full" aria-hidden="true" data-reveal>
  <figcaption class="label-untitled text-muted-ash">{label}</figcaption>

  <div class="mt-5 flex h-[132px] items-end gap-[6px]">
    {
      bars.map((height, i) => (
        <span
          class:list={[
            "chart-bar block flex-1 rounded-[3px]",
            i >= solidFrom
              ? "bg-bone"
              : "border border-hairline bg-transparent",
          ]}
          style={`--bar-height: ${height}%; --bar-delay: ${140 + i * 55}ms;`}
        />
      ))
    }
  </div>

  <div class="mt-4 flex items-center justify-between">
    <span class="label-untitled text-muted-ash">{from}</span>
    <span class="h-px flex-1 mx-4 bg-hairline"></span>
    <span class="label-untitled text-bone">{to}</span>
  </div>
</figure>

<style>
  .chart-bar {
    height: var(--bar-height);
  }

  @media (prefers-reduced-motion: no-preference) {
    .chart-bar {
      height: 0;
      transition: height var(--duration-geometry) var(--ease-opx);
      transition-delay: var(--bar-delay);
    }

    figure[data-revealed] .chart-bar {
      height: var(--bar-height);
    }
  }
</style>
