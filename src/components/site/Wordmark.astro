---
interface Props {
  class?: string
  alt: string
}

const { class: className = "", alt } = Astro.props
---

<!-- El lockup. `dir="ltr"` fijo: es la marca, no texto de la página, y tiene
     que conservar su orden y su tracking latino en cualquier idioma. -->
<span dir="ltr" class={`flex items-center gap-[10px] ${className}`}>
  <!-- El logo es un PNG negro sobre fondo transparente: en papel va tal cual y
       en modo oscuro se invierte a tinta clara. -->
  <img
    src="/logo-va.png"
    srcset="/logo-va.png 340w, /logo-va@2x.png 681w"
    sizes="26px"
    width="340"
    height="256"
    alt={alt}
    decoding="async"
    class="h-[24px] w-auto [:root[data-theme=dark]_&]:invert"
  />
  <span
    class="font-display text-[19px] leading-none tracking-[-0.012em] text-bone"
  >
    Vantalogics
  </span>
</span>
