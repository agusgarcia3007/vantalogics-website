---
interface Props {
  class?: string
  alt: string
}

const { class: className = "", alt } = Astro.props
---

<span dir="ltr" class={`flex items-center gap-[10px] ${className}`}>
  <img
    src="/logo-va.png"
    srcset="/logo-va.png 340w, /logo-va@2x.png 681w"
    sizes="34px"
    width="340"
    height="256"
    alt={alt}
    decoding="async"
    class="h-[22px] w-auto invert-100"
  />
  <span class="text-[17px] leading-none font-medium tracking-[-0.4px]">
    Vantalogics
  </span>
</span>
