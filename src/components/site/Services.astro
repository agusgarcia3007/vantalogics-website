---
import { HugeiconsIcon } from "@hugeicons/react"
import { Tick02Icon } from "@hugeicons/core-free-icons"

import Frame from "@/components/site/Frame.astro"
import SectionTitle from "@/components/site/SectionTitle.astro"
import { useTranslations, type Lang } from "@/i18n"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang).services
---

<Frame id="que-hacemos" labelledby="servicios">
  <SectionTitle
    id="servicios"
    label={t.label}
    muted={t.titleMuted}
    bright={t.titleBright}
    class="max-w-[38ch]"
  />

  <!-- Cuatro tarjetas en dos filas. Las reglas internas son del contenedor,
       no de cada tarjeta: así la grilla se lee como una sola pieza dividida y
       no como cuatro cajas apoyadas una al lado de la otra. -->
  <div class="mt-[clamp(40px,5vw,64px)] grid gap-px bg-hairline md:grid-cols-2">
    {
      t.items.map((service, i) => (
        <article
          class="service flex flex-col bg-canvas p-[clamp(24px,3vw,36px)]"
          data-reveal
          style={`--reveal-delay: ${i * 90}ms;`}
        >
          <p class="label-untitled text-muted-ash">{service.index}</p>

          <h3 class="mt-4 font-untitled text-[22px] leading-tight text-bone">
            {service.title}
          </h3>

          <p class="copy mt-4 max-w-[44ch] text-ash">{service.summary}</p>

          <ul class="mt-7 flex flex-col gap-[10px]">
            {service.items.map((item) => (
              <li class="flex items-start gap-[10px]">
                <HugeiconsIcon
                  icon={Tick02Icon}
                  size={15}
                  strokeWidth={2}
                  className="mt-[3px] shrink-0 text-ash"
                />
                <span class="label-untitled text-bone">{item}</span>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</Frame>

<style>
  .service {
    transition: background-color var(--duration-state) var(--ease-opx);
  }

  .service:hover {
    background-color: var(--color-surface);
  }
</style>
