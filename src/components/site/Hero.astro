---
import Cta from "@/components/site/Cta.astro"
import HeroTrace from "@/components/site/HeroTrace.astro"
import { useTranslations, type Lang } from "@/i18n"
import { SCHEDULE_URL } from "@/site"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
---

<section id="inicio" class="rule-b">
  <!-- Dos columnas reales: el titular y la traza arrancan en la misma línea
       superior, sin desplazamientos negativos que dependan del alto del texto. -->
  <div
    class="page-x grid items-start gap-x-[50px] gap-y-12 pt-[clamp(40px,5vw,80px)] pb-[clamp(56px,9vw,150px)] lg:grid-cols-[minmax(0,1fr)_minmax(0,480px)]"
  >
    <div>
      <p class="label-untitled text-muted-ash" data-reveal>{t.hero.eyebrow}</p>

      <h1
        class="mt-6 max-w-[13ch] font-opx text-bone"
        style="font-size: clamp(2.75rem, 5.8vw, 5rem); line-height: 1.04; letter-spacing: -0.02em;"
        data-reveal
      >
        {t.hero.title}
      </h1>

      <div class="mt-10" data-reveal style="--reveal-delay: 120ms;">
        <p class="copy max-w-[52ch] text-bone">{t.hero.lead}</p>

        <div class="mt-[30px] flex flex-wrap items-center gap-4">
          <Cta
            href={SCHEDULE_URL}
            size="pill-lg"
            target="_blank"
            rel="noopener noreferrer"
          >
            {t.hero.ctaPrimary}
          </Cta>
          <Cta href="#servicios" variant="pill-quiet" size="pill-lg">
            {t.hero.ctaSecondary}
          </Cta>
        </div>

        <p class="label-untitled mt-[30px] text-muted-ash">{t.hero.note}</p>
      </div>
    </div>

    <div class="w-full" data-reveal style="--reveal-delay: 200ms;">
      <HeroTrace lang={lang} />
    </div>
  </div>

  <ul class="rule-t page-x grid grid-cols-2 lg:grid-cols-4">
    {
      t.hero.stats.map((stat, index) => (
        <li
          class="py-8 lg:py-[50px]"
          data-reveal
          style={`--reveal-delay: ${index * 80}ms;`}
        >
          <p class="font-opx text-heading-sm text-bone lg:text-heading">
            {stat.value}
          </p>
          <p class="label-untitled mt-2 max-w-[24ch] text-muted-ash">
            {stat.label}
          </p>
        </li>
      ))
    }
  </ul>
</section>
