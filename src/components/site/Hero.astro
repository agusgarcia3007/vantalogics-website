---
import Cta from "@/components/site/Cta.astro"
import HeroTrace from "@/components/site/HeroTrace.astro"
import { useTranslations, type Lang } from "@/i18n"
import { SCHEDULE_URL } from "@/site"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
---

<section id="inicio" class="rule-b">
  <!-- Un solo bloque de dos columnas: titular, propuesta, acción y la prueba
       de producto entran juntos en la primera pantalla. El titular se
       dimensiona para llenar su columna en dos líneas, no para comerse el
       viewport. -->
  <div
    class="page-x grid items-start gap-x-[50px] gap-y-[50px] py-[clamp(40px,5vw,72px)] lg:grid-cols-[minmax(0,1fr)_minmax(0,420px)]"
  >
    <div>
      <p class="label-untitled text-muted-ash" data-reveal>{t.hero.eyebrow}</p>

      <h1
        class="mt-6 max-w-[24ch] font-opx text-bone"
        style="font-size: clamp(2.5rem, 4.6vw, 4.5rem); line-height: 1.06; letter-spacing: -0.022em;"
        data-reveal
      >
        {t.hero.title}
      </h1>

      <div class="mt-10" data-reveal style="--reveal-delay: 120ms;">
        <p class="copy max-w-[46ch] text-bone">{t.hero.lead}</p>

        <div class="mt-[30px] flex flex-wrap items-center gap-4">
          <Cta
            href={SCHEDULE_URL}
            size="pill-lg"
            target="_blank"
            rel="noopener noreferrer"
          >
            {t.hero.ctaPrimary}
          </Cta>
          <Cta href="#servicios" variant="pill-quiet" size="pill-lg">
            {t.hero.ctaSecondary}
          </Cta>
        </div>

        <p class="label-untitled mt-[30px] max-w-[52ch] text-muted-ash">
          {t.hero.note}
        </p>
      </div>
    </div>

    <div class="w-full" data-reveal style="--reveal-delay: 200ms;">
      <HeroTrace lang={lang} />
    </div>
  </div>

  <ul class="rule-t page-x grid grid-cols-2 lg:grid-cols-4">
    {
      t.hero.stats.map((stat, index) => (
        <li
          class="py-8 lg:py-[50px]"
          data-reveal
          style={`--reveal-delay: ${index * 80}ms;`}
        >
          <p class="font-opx text-heading-sm text-bone lg:text-heading">
            {stat.value}
          </p>
          <p class="label-untitled mt-2 max-w-[24ch] text-muted-ash">
            {stat.label}
          </p>
        </li>
      ))
    }
  </ul>
</section>
