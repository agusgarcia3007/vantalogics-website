---
import Cta from "@/components/site/Cta.astro"
import Frame from "@/components/site/Frame.astro"
import HeroFlow from "@/components/site/HeroFlow.astro"
import { useTranslations, type Lang } from "@/i18n"
import { SCHEDULE_URL } from "@/site"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
---

<Frame id="inicio" flush>
  <!-- Dos columnas: el argumento a la izquierda, la demostración a la derecha.
       El titular se dimensiona para caer en dos líneas y dejar aire, no para
       comerse la primera pantalla — la ilustración tiene que entrar con él. -->
  <div
    class="grid items-center gap-x-[clamp(32px,5vw,72px)] gap-y-[clamp(40px,6vw,64px)] lg:grid-cols-[minmax(0,1fr)_minmax(0,440px)]"
  >
    <div>
      <p class="label-untitled text-muted-ash" data-reveal>{t.hero.eyebrow}</p>

      <h1
        class="display-hero mt-5 max-w-[15ch] text-balance text-bone"
        data-reveal
        style="--reveal-delay: 60ms;"
      >
        {t.hero.title}
      </h1>

      <p
        class="copy mt-6 max-w-[48ch] text-ash"
        data-reveal
        style="--reveal-delay: 120ms;"
      >
        {t.hero.lead}
      </p>

      <div
        class="mt-9 flex flex-wrap items-center gap-3"
        data-reveal
        style="--reveal-delay: 180ms;"
      >
        <Cta
          href={SCHEDULE_URL}
          variant="pill-solid"
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.hero.ctaPrimary}
        </Cta>

        <!-- Abre el mismo panel que el botón flotante: la segunda acción del
             hero es probar el producto, no leer más sobre él. -->
        <button type="button" class="cta-quiet" data-agent-open-secondary>
          {t.hero.ctaSecondary}
        </button>
      </div>

      <p
        class="label-untitled mt-6 max-w-[46ch] text-muted-ash"
        data-reveal
        style="--reveal-delay: 240ms;"
      >
        {t.hero.note}
      </p>
    </div>

    <div class="w-full">
      <HeroFlow lang={lang} />
    </div>
  </div>
</Frame>

<style>
  .cta-quiet {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 7px 15px;
    border-radius: var(--radius-pill);
    border: var(--hairline-width) solid var(--color-hairline);
    font-family: var(--font-untitled);
    font-weight: var(--font-weight-medium);
    font-size: var(--text-caption);
    color: var(--color-ash);
    transition:
      color var(--duration-state) var(--ease-opx),
      border-color var(--duration-state) var(--ease-opx);
  }

  .cta-quiet:hover {
    color: var(--color-bone);
    border-color: var(--color-bone);
  }
</style>
