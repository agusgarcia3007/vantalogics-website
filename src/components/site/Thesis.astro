---
import Frame from "@/components/site/Frame.astro"
import SectionTitle from "@/components/site/SectionTitle.astro"
import { useTranslations, type Lang } from "@/i18n"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang).thesis
---

<Frame labelledby="problema">
  <div
    class="grid gap-x-[clamp(32px,5vw,80px)] gap-y-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1fr)]"
  >
    <div>
      <SectionTitle
        id="problema"
        index="01"
        label={t.label}
        muted={t.titleMuted}
        bright={t.titleBright}
      />

      <p class="annotation mt-8 max-w-[26ch]" data-reveal>
        {t.annotation}
      </p>
    </div>

    <div>
      {
        t.body.map((paragraph, i) => (
          <p
            class="copy mt-5 max-w-[56ch] text-ash first:mt-0"
            data-reveal
            style={`--reveal-delay: ${100 + i * 80}ms;`}
          >
            {paragraph}
          </p>
        ))
      }

      <!-- Los cuatro síntomas. Cada línea abre con el hecho en tinta plena y
           sigue en gris: se puede barrer leyendo sólo lo primero de cada una,
           que es como se lee una landing en la vida real. El número al margen
           es el que la vuelve una lista de hallazgos y no cuatro frases. -->
      <ul class="mt-10">
        {
          t.items.map((item, i) => (
            <li
              class="flex gap-4 border-t border-hairline py-[18px]"
              data-reveal
              style={`--reveal-delay: ${260 + i * 70}ms;`}
            >
              <span class="label-mono-sm mt-[5px] shrink-0 text-faint" data-numeral>
                {String(i + 1).padStart(2, "0")}
              </span>
              <p class="copy max-w-[52ch] text-ash">
                <span class="text-bone">{item.title}</span> {item.detail}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Frame>
