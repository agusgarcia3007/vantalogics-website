---
import { HugeiconsIcon } from "@hugeicons/react"
import { Github01Icon, InstagramIcon } from "@hugeicons/core-free-icons"

import Wordmark from "@/components/site/Wordmark.astro"
import {
  dictionaries,
  localizePath,
  navHref,
  otherLangs,
  useTranslations,
  type Lang,
} from "@/i18n"
import { CONTACT_EMAIL, GITHUB_URL, INSTAGRAM_URL } from "@/site"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
const alts = otherLangs(lang)
const year = new Date().getFullYear()
const email = CONTACT_EMAIL

const socials = [
  { href: GITHUB_URL, label: "GitHub", icon: Github01Icon },
  { href: INSTAGRAM_URL, label: "Instagram", icon: InstagramIcon },
]
---

<footer
  class="mx-auto w-full max-w-[1180px] border-x border-hairline"
  style="container-type: inline-size;"
>
  <div
    class="grid gap-x-[clamp(32px,5vw,72px)] gap-y-10 border-t border-hairline px-[clamp(20px,4vw,56px)] py-[clamp(48px,6vw,80px)] md:grid-cols-[minmax(0,1.2fr)_repeat(2,minmax(0,0.8fr))]"
  >
    <div>
      <Wordmark alt={t.a11y.logoAlt} />
      <p class="mt-5 max-w-[32ch] copy text-ash">{t.footer.tagline}</p>
      <a
        class="mt-5 inline-block copy text-bone transition-opacity duration-(--duration-state) ease-(--ease-opx) hover:opacity-70"
        href={`mailto:${email}`}
      >
        {email}
      </a>

      <!-- Perfiles públicos. Van con glifo y rótulo: un ícono suelto en un
           sistema monocromo no se distingue de un botón cualquiera. -->
      <ul class="mt-7 flex flex-wrap gap-3">
        {
          socials.map((social) => (
            <li>
              <a
                href={social.href}
                target="_blank"
                rel="me noopener noreferrer"
                class="social flex items-center gap-[9px] rounded-pill border border-hairline px-[13px] py-[8px]"
              >
                <HugeiconsIcon
                  icon={social.icon}
                  size={16}
                  strokeWidth={1.5}
                  className="shrink-0"
                />
                <span class="label-untitled">{social.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {
      t.footer.columns.map((column) => (
        <nav aria-label={column.title}>
          <h2 class="label-untitled text-muted-ash">{column.title}</h2>
          <ul class="mt-5 flex flex-col gap-[10px]">
            {column.links.map((link) => (
              <li>
                <a
                  class="label-untitled text-ash transition-colors duration-(--duration-state) ease-(--ease-opx) hover:text-bone"
                  href={navHref(lang, link.href)}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div
    class="flex flex-wrap items-center justify-between gap-x-[clamp(24px,4vw,56px)] gap-y-3 border-t border-hairline px-[clamp(20px,4vw,56px)] py-[22px]"
  >
    <!-- `dir="ltr"`: el símbolo © es un carácter neutro y en un párrafo RTL el
         algoritmo bidireccional lo manda al final («Vantalogics 2026 ©»). La
         línea de copyright es una fórmula legal latina y se escribe siempre en
         el mismo orden. -->
    <p dir="ltr" class="label-untitled text-muted-ash">© Vantalogics {year}</p>
    <p class="label-untitled text-muted-ash">{t.footer.tags}</p>
    <!-- Acá sí entra el nombre completo del idioma, escrito en ese idioma:
         es la forma en que un lector árabe reconoce su versión sin tener que
         leer español. -->
    <ul class="flex flex-wrap items-center gap-x-4 gap-y-1">
      {
        alts.map((alt) => (
          <li>
            <a
              href={localizePath(alt)}
              hreflang={alt}
              lang={alt}
              class="label-untitled text-ash transition-colors duration-(--duration-state) ease-(--ease-opx) hover:text-bone"
            >
              {dictionaries[alt].language.switchTo}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Marca a sangre: el nombre ocupa el ancho de la columna y se corta por la
       mitad contra el borde inferior. Es decorativo — el nombre accesible ya
       está arriba. La altura es la mitad de la altura de mayúscula de Inter
       (0.727em) y el desplazamiento sube la línea hasta que el tope de las
       letras coincide con el borde: queda partido al medio, sin aire debajo. -->
  <div
    class="overflow-hidden border-t border-hairline select-none"
    style="font-size: 18.6cqw; height: 0.363em;"
    aria-hidden="true"
    data-reveal
  >
    <span
      class="block w-full text-center font-opx whitespace-nowrap text-transparent"
      style="line-height: 1; margin-top: -0.137em; letter-spacing: -0.035em; -webkit-text-stroke: 1.5px var(--bone);"
    >
      Vantalogics
    </span>
  </div>
</footer>

<style>
  .social {
    color: var(--color-ash);
    transition:
      color var(--duration-state) var(--ease-opx),
      border-color var(--duration-state) var(--ease-opx);
  }

  .social:hover {
    color: var(--color-bone);
    border-color: var(--color-bone);
  }
</style>
