---
import { HugeiconsIcon } from "@hugeicons/react"
import { Github01Icon, InstagramIcon } from "@hugeicons/core-free-icons"

import Wordmark from "@/components/site/Wordmark.astro"
import { navHref, useTranslations, type Lang } from "@/i18n"
import { CONTACT_EMAIL, GITHUB_URL, INSTAGRAM_URL } from "@/site"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
const year = new Date().getFullYear()
const email = CONTACT_EMAIL

const socials = [
  { href: GITHUB_URL, label: "GitHub", icon: Github01Icon },
  { href: INSTAGRAM_URL, label: "Instagram", icon: InstagramIcon },
]
---

<footer
  class="mx-auto w-full max-w-[1240px] border-x border-hairline bg-surface"
  style="container-type: inline-size;"
>
  <div
    class="grid gap-x-[clamp(32px,5vw,72px)] gap-y-12 border-t border-hairline px-[clamp(20px,4vw,72px)] py-[clamp(48px,6vw,88px)] md:grid-cols-[minmax(0,1.2fr)_repeat(2,minmax(0,0.8fr))]"
  >
    <div>
      <Wordmark alt={t.a11y.logoAlt} />
      <p class="copy mt-6 max-w-[34ch] text-[15px] text-ash">
        {t.footer.tagline}
      </p>
      <a
        class="mt-6 inline-block font-display text-[clamp(1.125rem,1.5vw,1.3125rem)] text-bone transition-colors duration-(--duration-state) ease-paper hover:text-pen-ink"
        href={`mailto:${email}`}
      >
        {email}
      </a>

      <!-- Perfiles públicos. Van con glifo y rótulo: un ícono suelto no se
           distingue de un botón cualquiera. -->
      <ul class="mt-8 flex flex-wrap gap-3">
        {
          socials.map((social) => (
            <li>
              <a
                href={social.href}
                target="_blank"
                rel="me noopener noreferrer"
                class="social flex items-center gap-[9px] border border-hairline px-[13px] py-[9px]"
              >
                <HugeiconsIcon
                  icon={social.icon}
                  size={15}
                  strokeWidth={1.5}
                  className="shrink-0"
                />
                <span class="label-mono-sm">{social.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {
      t.footer.columns.map((column) => (
        <nav aria-label={column.title}>
          <h2 class="label-mono text-faint">{column.title}</h2>
          <ul class="mt-6 flex flex-col">
            {column.links.map((link) => (
              <li class="border-t border-hairline first:border-t-0">
                <a
                  class="block py-[11px] copy text-[15px] text-ash transition-colors duration-(--duration-state) ease-paper hover:text-bone"
                  href={navHref(lang, link.href)}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div
    class="flex flex-wrap items-center justify-between gap-x-[clamp(24px,4vw,56px)] gap-y-3 border-t border-hairline px-[clamp(20px,4vw,72px)] py-[22px]"
  >
    <p dir="ltr" class="label-mono-sm text-faint">© Vantalogics {year}</p>
    <p class="label-mono-sm text-faint">{t.footer.tags}</p>
  </div>

  <!-- La marca a sangre: el nombre ocupa el ancho de la columna y se corta por
       la mitad contra el borde inferior, como el título impreso en el lomo de
       un apunte. Es decorativo —el nombre accesible ya está arriba—. La altura
       es la mitad de la altura de mayúscula de Newsreader y el desplazamiento
       sube la línea hasta que el tope de las letras coincide con el borde. -->
  <div
    class="overflow-hidden border-t border-hairline select-none"
    style="font-size: 17.4cqw; height: 0.345em;"
    aria-hidden="true"
    data-reveal
  >
    <span
      class="block w-full text-center font-display whitespace-nowrap text-bone"
      style="line-height: 1; margin-top: -0.145em; letter-spacing: -0.03em; opacity: 0.09;"
    >
      Vantalogics
    </span>
  </div>
</footer>

<style>
  .social {
    color: var(--color-ash);
    transition:
      color var(--duration-state) var(--ease-paper),
      border-color var(--duration-state) var(--ease-paper);
  }

  .social:hover {
    color: var(--color-bone);
    border-color: var(--color-bone);
  }
</style>
