---
import Wordmark from "@/components/site/Wordmark.astro"
import { localizePath, otherLang, useTranslations, type Lang } from "@/i18n"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
const alt = otherLang(lang)
const year = new Date().getFullYear()
const email = "hola@vantalogics.com"
---

<footer class="band-y">
  <div class="page-x grid gap-x-[50px] gap-y-[clamp(40px,5vw,80px)] md:grid-cols-3">
    <div>
      <Wordmark alt={t.a11y.logoAlt} />
      <p class="copy mt-[20px] max-w-[34ch] text-muted-ash">
        {t.footer.tagline}
      </p>
      <a
        class="copy mt-[20px] inline-block text-bone transition-opacity duration-(--duration-state) ease-(--ease-opx) hover:opacity-70"
        href={`mailto:${email}`}
      >
        {email}
      </a>
    </div>

    {
      t.footer.columns.map((column) => (
        <nav aria-label={column.title}>
          <h2 class="font-opx text-subheading text-bone">{column.title}</h2>
          <ul class="mt-[20px] flex flex-col gap-3">
            {column.links.map((link) => (
              <li>
                <a
                  class="copy text-ash transition-colors duration-(--duration-state) ease-(--ease-opx) hover:text-bone"
                  href={link.href}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div
    class="rule-t page-x mt-[clamp(48px,7vw,100px)] flex flex-wrap items-center justify-between gap-x-[50px] gap-y-4 pt-[30px]"
  >
    <p class="label-untitled text-muted-ash">© Vantalogics {year}</p>
    <p class="label-untitled text-muted-ash">{t.footer.tags}</p>
    <a
      href={localizePath(alt)}
      hreflang={alt}
      lang={alt}
      class="label-untitled text-ash transition-colors duration-(--duration-state) ease-(--ease-opx) hover:text-bone"
    >
      {t.language.switchTo}
    </a>
  </div>

  <!-- Marca a sangre: el nombre ocupa el ancho completo y se corta por la
       mitad contra el borde inferior de la página. Es decorativo — el nombre
       accesible ya está en el bloque de arriba. -->
  <!-- La altura del contenedor es la mitad de la altura de mayúscula de Inter
       (0.727em), y el desplazamiento sube la línea hasta que el tope de las
       letras coincide con el borde superior: el nombre queda partido al medio
       contra el final de la página, sin espacio sobrante debajo. -->
  <div
    class="mt-[clamp(40px,6vw,80px)] overflow-hidden select-none"
    style="font-size: 19.5vw; height: 0.363em;"
    aria-hidden="true"
    data-reveal
  >
    <span
      class="block w-full text-center font-opx whitespace-nowrap text-bone"
      style="line-height: 1; margin-top: -0.137em; letter-spacing: -0.035em;"
    >
      Vantalogics
    </span>
  </div>
</footer>
