---
import { HugeiconsIcon } from "@hugeicons/react"
import {
  ArrowUpRight01Icon,
  Github01Icon,
  InstagramIcon,
} from "@hugeicons/core-free-icons"

import Wordmark from "@/components/site/Wordmark.astro"
import { navHref, useTranslations, type Lang } from "@/i18n"
import {
  CONTACT_EMAIL,
  GITHUB_URL,
  INSTAGRAM_URL,
  SCHEDULE_URL,
  WHATSAPP_DISPLAY,
  whatsappUrl,
} from "@/site"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
const year = new Date().getFullYear()

const socials = [
  { href: GITHUB_URL, label: "GitHub", icon: Github01Icon },
  { href: INSTAGRAM_URL, label: "Instagram", icon: InstagramIcon },
]

const linkClass =
  "text-[14px] text-bone/80 transition-colors duration-(--duration-state) ease-(--ease-out) hover:text-bone"
---

<!-- Pie (design.md › Footer Link Column): columnas con rótulo en mono, sobre
     el mismo canvas y sin separador del cuerpo más allá de la regla. -->
<footer class="relative overflow-hidden">
  <div class="shell">
    <div
      class="grid gap-12 border-t border-iron py-16 md:grid-cols-12 md:gap-8"
    >
      <div class="md:col-span-5">
        <Wordmark alt={t.a11y.logoAlt} />
        <p class="mt-6 max-w-[44ch] copy text-ash">{t.footer.tagline}</p>
        <ul class="mt-8 flex flex-wrap gap-2">
          {
            socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="me noopener noreferrer"
                  class="flex items-center gap-2 rounded-[8px] border border-iron px-3 py-2 label-untitled text-ash transition-colors duration-(--duration-state) ease-(--ease-out) hover:border-smoke hover:text-bone"
                >
                  <HugeiconsIcon
                    icon={social.icon}
                    size={15}
                    strokeWidth={1.5}
                  />
                  {social.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {
        t.footer.columns.map((column) => (
          <nav aria-label={column.title} class="md:col-span-2">
            <h2 class="eyebrow text-bone">{column.title}</h2>
            <ul class="mt-5 flex flex-col gap-3">
              {column.links.map((link) => (
                <li>
                  <a class={linkClass} href={navHref(lang, link.href)}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div class="md:col-span-3">
        <h2 class="eyebrow text-bone">{t.footer.contactTitle}</h2>
        <ul class="mt-5 flex flex-col gap-3">
          <li>
            <a class={linkClass} href={`mailto:${CONTACT_EMAIL}`}
              >{CONTACT_EMAIL}</a
            >
          </li>
          <li>
            <a
              class={linkClass}
              href={whatsappUrl(t.whatsapp.prefill)}
              target="_blank"
              rel="noopener"
            >
              WhatsApp · <span dir="ltr">{WHATSAPP_DISPLAY}</span>
            </a>
          </li>
          <li>
            <a
              class={`${linkClass} group inline-flex items-center gap-1`}
              href={SCHEDULE_URL}
              target="_blank"
              rel="noopener noreferrer"
            >
              {t.nav.cta}
              <HugeiconsIcon
                icon={ArrowUpRight01Icon}
                size={14}
                strokeWidth={1.6}
                className="text-soft-indigo transition-transform duration-(--duration-state) ease-(--ease-out) group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              />
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-iron py-6"
    >
      <p dir="ltr" class="mono-sm text-mist">© {year} Vantalogics</p>
      <p class="eyebrow text-mist">{t.footer.tags}</p>
    </div>
  </div>

  <!-- Marca a sangre, cortada por el borde inferior. Decorativa: el nombre
       accesible ya está arriba. -->
  <div
    class="footer-mark pointer-events-none select-none"
    aria-hidden="true"
    data-reveal
  >
    <span>Vantalogics</span>
  </div>
</footer>

<style>
  .footer-mark {
    container-type: inline-size;
    height: 11.5vw;
    overflow: hidden;
    mask-image: linear-gradient(180deg, black 20%, transparent 100%);
  }

  .footer-mark span {
    display: block;
    text-align: center;
    white-space: nowrap;
    font-weight: 500;
    font-size: 21.5cqw;
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: transparent;
    background: linear-gradient(180deg, var(--color-iron), var(--color-carbon));
    -webkit-background-clip: text;
    background-clip: text;
  }
</style>
