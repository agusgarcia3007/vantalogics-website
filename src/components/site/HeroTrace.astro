---
import { useTranslations, type Lang } from "@/i18n"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang).hero.trace

// Traza de una ejecución de agente. Deliberadamente NO es una tarjeta con
// borde: en este sistema la tabla enmarcada lee como captura de aplicación y
// pelea con la tipografía monumental. Va como índice editorial —reglas
// horizontales de 1px y nada más— con dos líneas por paso, así ninguna fila
// envuelve por angosta que quede la columna. Es texto real, indexable y
// legible con lector de pantalla.
---

<figure class="w-full" data-reveal>
  <figcaption
    class="label-untitled flex flex-wrap items-center justify-between gap-x-6 gap-y-1 pb-4"
  >
    <span class="text-bone">
      <span class="sr-only">{t.caption}. {t.runLabel} </span>
      {t.agent}
      <span class="mx-1.5 text-ash">·</span>
      <span class="tabular-nums text-ash">{t.runId}</span>
    </span>

    <span class="flex items-center gap-2 text-muted-ash">
      <span class="trace-pulse size-1 shrink-0 rounded-full bg-bone" aria-hidden="true"></span>
      {t.status}
    </span>
  </figcaption>

  <ol>
    {
      t.steps.map((step, i) => (
        <li
          class="trace-row border-t border-hairline py-4"
          style={`--row-delay: ${260 + i * 120}ms;`}
        >
          <p class="label-untitled flex items-baseline justify-between gap-4">
            <span class="text-bone">
              <span class="mr-3 tabular-nums text-ash">{step.time}</span>
              {step.kind}
            </span>
            {step.meta && (
              <span class="tabular-nums text-ash">{step.meta}</span>
            )}
          </p>
          <p class="mt-1 text-caption text-ash">{step.detail}</p>
        </li>
      ))
    }
  </ol>

  <div class="grid grid-cols-3 gap-x-6 border-t border-hairline pt-5">
    {
      t.summary.map((item) => (
        <p>
          <span class="block font-opx text-subheading tabular-nums text-bone">
            {item.value}
          </span>
          <span class="label-untitled mt-1 block text-muted-ash">
            {item.label}
          </span>
        </p>
      ))
    }
  </div>
</figure>

<style>
  @media (prefers-reduced-motion: no-preference) {
    /* Los pasos se encadenan uno tras otro, como una ejecución que avanza. */
    [data-revealed] .trace-row {
      animation: trace-in 400ms cubic-bezier(0.455, 0.03, 0.515, 0.955) both;
      animation-delay: var(--row-delay);
    }

    .trace-pulse {
      animation: trace-pulse 2.4s cubic-bezier(0.455, 0.03, 0.515, 0.955)
        infinite;
    }
  }

  @keyframes trace-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes trace-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.2;
    }
  }
</style>
