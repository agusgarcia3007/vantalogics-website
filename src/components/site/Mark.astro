---
interface Props {
  /** Retardo del trazo, en ms, para encadenarlo con el reveal del bloque. */
  delay?: number
  class?: string
}

const { delay = 260, class: className = "" } = Astro.props

// El trazo de lápiz rojo.
//
// Es la firma del sistema: el remate del titular queda subrayado a mano, como
// una corrección sobre el papel. El trazo se dibuja solo cuando el bloque
// entra en pantalla —`data-pen-draw` lo engancha al observer del layout— y con
// `prefers-reduced-motion` aparece entero, sin animación.
//
// El path va normalizado con `pathLength="1"`, así que una sola regla de CSS
// sirve para cualquier ancho de texto sin recalcular la longitud del trazo. El
// `preserveAspectRatio="none"` estira el gesto al ancho de la palabra; la
// altura queda fija, que es lo que mantiene el grosor del lápiz constante.
---

<span class:list={["pen-underline", className]}>
  <slot />
  <svg
    class="pen-stroke"
    data-pen-draw
    style={`--reveal-delay: ${delay}ms;`}
    viewBox="0 0 200 12"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M1.5 7.4C34 3.1 92 2.2 140 3.6c22 .7 42 2.2 58.5 4.3"
      pathLength="1"
      fill="none"
      stroke="var(--pen)"
      stroke-width="2.2"
      stroke-linecap="round"
    ></path>
  </svg>
</span>

<style>
  .pen-stroke {
    position: absolute;
    inset-inline: -0.06em;
    /* Cuelga del borde inferior de la caja de texto, no de la línea base: así
       no choca con las descendentes de una «g» o una «p». */
    bottom: -0.12em;
    height: 0.26em;
    overflow: visible;
    pointer-events: none;
  }

  /* Sin JavaScript el trazo ya está dibujado: la clase `js` la pone el layout
     en el head, antes del primer pintado. */
  :global(html:not(.js)) .pen-stroke path {
    stroke-dashoffset: 0;
  }
</style>
