---
import { HugeiconsIcon } from "@hugeicons/react"
import { ArrowRight01Icon } from "@hugeicons/core-free-icons"

import Cta from "@/components/site/Cta.astro"
import { useTranslations, type Lang } from "@/i18n"
import { CONTACT_EMAIL, SCHEDULE_URL } from "@/site"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang).cta
const email = CONTACT_EMAIL
---

<!-- El cierre. La luna vuelve como horizonte: el borde de una esfera que
     asoma desde abajo, con la misma luz índigo del hero. Es CSS; la escena
     WebGL vive sólo arriba. -->
<section
  id="contacto"
  aria-labelledby="contacto-titulo"
  class="relative isolate overflow-hidden"
>
  <div
    class="pointer-events-none absolute inset-0 -z-20 blueprint [mask-image:radial-gradient(ellipse_60%_70%_at_50%_100%,black,transparent)]"
    aria-hidden="true"
  >
  </div>
  <div
    class="horizon pointer-events-none absolute inset-x-0 bottom-0 -z-10"
    aria-hidden="true"
  >
  </div>

  <div class="shell">
    <div
      class="flex flex-col items-center border-t border-iron pt-(--spacing-band) pb-[clamp(160px,22vw,280px)] text-center"
    >
      <p class="flex items-center gap-3 eyebrow text-ash" data-reveal>
        <span class="h-px w-6 bg-soft-indigo" aria-hidden="true"></span>
        {t.label}
        <span class="h-px w-6 bg-soft-indigo" aria-hidden="true"></span>
      </p>
      <h2
        id="contacto-titulo"
        class="mt-6 max-w-[18ch] display text-bone"
        data-reveal
        style="--reveal-delay: 60ms;"
      >
        {t.title}
      </h2>
      <p
        class="mt-8 max-w-[60ch] copy-lg text-ash"
        data-reveal
        style="--reveal-delay: 120ms;"
      >
        {t.body}
      </p>

      <div
        class="mt-10 flex flex-wrap items-center justify-center gap-3"
        data-reveal
        style="--reveal-delay: 180ms;"
      >
        <Cta
          href={SCHEDULE_URL}
          variant="pill-solid"
          size="pill-lg"
          target="_blank"
          rel="noopener noreferrer"
          class="group"
        >
          {t.primary}
          <HugeiconsIcon
            icon={ArrowRight01Icon}
            size={16}
            strokeWidth={1.8}
            className="transition-transform duration-(--duration-state) ease-(--ease-out) group-hover:translate-x-0.5"
          />
        </Cta>
        <Cta href={`mailto:${email}`} variant="pill" size="pill-lg">
          {t.secondary}
        </Cta>
      </div>

      <dl
        class="mt-10 flex flex-wrap justify-center gap-x-8 gap-y-2 mono-sm text-mist"
        data-reveal
        style="--reveal-delay: 240ms;"
      >
        <div class="flex gap-2">
          <dt>{t.responseLabel}:</dt>
          <dd class="text-ash">{t.response}</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .horizon {
    height: clamp(180px, 26vw, 340px);
  }

  .horizon::before,
  .horizon::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    width: max(1600px, 150vw);
    aspect-ratio: 1;
    border-radius: 50%;
    transform: translateX(-50%);
  }

  /* El cuerpo: casi negro, apenas más claro que el canvas hacia el borde. */
  .horizon::before {
    background: radial-gradient(
      circle at 50% 0%,
      #101116 0%,
      #0b0b0d 18%,
      var(--color-carbon) 40%
    );
    border-top: 1px solid rgb(103 152 255 / 0.55);
  }

  /* La luz de borde: brilla en la curva y se abre hacia arriba. */
  .horizon::after {
    background: radial-gradient(
      closest-side,
      transparent 96%,
      rgb(103 152 255 / 0.14) 98.6%,
      transparent 100%
    );
    filter: blur(12px);
  }
</style>
