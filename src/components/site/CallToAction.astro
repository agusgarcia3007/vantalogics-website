---
import Cta from "@/components/site/Cta.astro"
import { useTranslations, type Lang } from "@/i18n"
import { CONTACT_EMAIL, SCHEDULE_URL } from "@/site"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang).cta

const email = CONTACT_EMAIL
const scheduleUrl = SCHEDULE_URL
---

<section
  id="contacto"
  aria-labelledby="contacto-titulo"
  class="bg-surface band-y rule-b"
>
  <div class="page-x">
    <p class="label-untitled text-muted-ash" data-reveal>{t.label}</p>

    <h2
      id="contacto-titulo"
      class="mt-5 max-w-[16ch] display-lg text-bone lg:mt-8"
      data-reveal
    >
      {t.title}
    </h2>

    <p class="mt-6 max-w-[54ch] copy text-bone lg:mt-[30px]" data-reveal>
      {t.body}
    </p>

    <div
      class="mt-8 flex flex-wrap items-center gap-3 lg:mt-[50px] lg:gap-4"
      data-reveal
    >
      <Cta
        href={scheduleUrl}
        size="pill-lg"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t.primary}
      </Cta>
      <Cta href={`mailto:${email}`} variant="pill-quiet" size="pill-lg">
        {t.secondary}
      </Cta>
    </div>

    <dl
      class="mt-[clamp(40px,6vw,80px)] grid gap-x-[50px] gap-y-6 sm:grid-cols-2 lg:grid-cols-4 lg:gap-y-[30px]"
    >
      <div data-reveal>
        <dt class="label-untitled text-muted-ash">{t.emailLabel}</dt>
        <dd class="mt-2">
          <a
            class="copy text-bone transition-opacity duration-(--duration-state) ease-(--ease-opx) hover:opacity-70"
            href={`mailto:${email}`}
          >
            {email}
          </a>
        </dd>
      </div>

      <div data-reveal style="--reveal-delay: 80ms;">
        <dt class="label-untitled text-muted-ash">{t.responseLabel}</dt>
        <dd class="mt-2 copy text-bone">{t.response}</dd>
      </div>

      <div data-reveal style="--reveal-delay: 160ms;">
        <dt class="label-untitled text-muted-ash">{t.modeLabel}</dt>
        <dd class="mt-2 copy text-bone">{t.mode}</dd>
      </div>

      <div data-reveal style="--reveal-delay: 240ms;">
        <dt class="label-untitled text-muted-ash">{t.languagesLabel}</dt>
        <dd class="mt-2 copy text-bone">{t.languages}</dd>
      </div>
    </dl>
  </div>
</section>
