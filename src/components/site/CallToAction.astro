---
import Cta from "@/components/site/Cta.astro"
import Frame from "@/components/site/Frame.astro"
import { useTranslations, type Lang } from "@/i18n"
import { CONTACT_EMAIL, SCHEDULE_URL } from "@/site"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang).cta

const email = CONTACT_EMAIL
---

<Frame id="contacto" labelledby="contacto-titulo">
  <!-- El cierre: una sola línea grande y el botón al lado. Nada compite. -->
  <div
    class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between lg:gap-[clamp(32px,5vw,72px)]"
  >
    <div>
      <p class="label-untitled text-muted-ash" data-reveal>{t.label}</p>
      <h2
        id="contacto-titulo"
        class="display-section mt-5 max-w-[18ch] text-balance text-bone"
        data-reveal
        style="--reveal-delay: 60ms;"
      >
        {t.title}
      </h2>
    </div>

    <div
      class="flex flex-wrap items-center gap-3 lg:shrink-0"
      data-reveal
      style="--reveal-delay: 140ms;"
    >
      <Cta
        href={SCHEDULE_URL}
        variant="pill-solid"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t.primary}
      </Cta>
      <Cta href={`mailto:${email}`} variant="pill-quiet">{t.secondary}</Cta>
    </div>
  </div>

  <p class="copy mt-9 max-w-[58ch] text-ash" data-reveal style="--reveal-delay: 200ms;">
    {t.body}
  </p>

  <dl
    class="mt-[clamp(40px,5vw,64px)] grid gap-x-[clamp(24px,3vw,40px)] gap-y-8 sm:grid-cols-2"
  >
    {
      [
        { label: t.emailLabel, value: email, href: `mailto:${email}` },
        { label: t.responseLabel, value: t.response },
      ].map((item, i) => (
        <div
          class="border-t border-hairline pt-5"
          data-reveal
          style={`--reveal-delay: ${i * 70}ms;`}
        >
          <dt class="label-untitled text-muted-ash">{item.label}</dt>
          <dd class="label-untitled mt-2 text-bone">
            {item.href ? (
              <a
                class="transition-opacity duration-(--duration-state) ease-(--ease-opx) hover:opacity-70"
                href={item.href}
              >
                {item.value}
              </a>
            ) : (
              item.value
            )}
          </dd>
        </div>
      ))
    }
  </dl>
</Frame>
