---
/**
 * Chrome compartido del sistema cinemático: grano, header, menú móvil, botón
 * de WhatsApp y el único script de la página.
 *
 * La portada y las páginas de caso montan esto mismo, así que la navegación,
 * los controles y el comportamiento del menú viven en un solo lugar. El
 * `frame` distingue los dos usos: la portada mide un viewport exacto y las
 * páginas de caso fluyen a lo largo.
 *
 * Los enlaces salen de `t.nav.items` vía `navHref`, igual que el header viejo:
 * si cambia un destino, cambia para todo el sitio a la vez.
 */
import "@/styles/cine.css"
import { localizePath, navHref, useTranslations, type Lang } from "@/i18n"
import { SCHEDULE_URL, whatsappUrl } from "@/site"

interface Props {
  lang: Lang
  /** La portada ocupa un viewport exacto; el resto fluye. */
  frame?: boolean
}

const { lang, frame = false } = Astro.props
const t = useTranslations(lang)
const waHref = whatsappUrl(t.whatsapp.prefill)

/** Cada enlace entra con su propio retardo, alternando escala y deslizamiento. */
const ENTRANCE = [
  { modifier: "appear--scale", delay: "0.16s" },
  { modifier: "appear--soft", delay: "0.28s" },
  { modifier: "appear--scale", delay: "0.40s" },
  { modifier: "appear--soft", delay: "0.52s" },
]
---

<div class="grain" aria-hidden="true"></div>

<slot name="backdrop" />

<div class:list={["page", !frame && "page--flow"]}>
  <div class="menu-backdrop" aria-hidden="true"></div>

  <header class="header">
    <a
      class="logo appear appear--scale"
      href={frame ? "#top" : localizePath(lang)}
      aria-label="Vantalogics"
      style="--d:0.08s"
    >
      <img class="logo-mark" src="/logo-va.png" alt="" width="25" height="25" />
      <span>Vantalogics</span>
    </a>

    <nav class="nav" id="site-nav" aria-label={t.nav.menu}>
      {
        t.nav.items.map((item, i) => (
          <a
            class:list={["appear", ENTRANCE[i % ENTRANCE.length].modifier]}
            href={navHref(lang, item.href)}
            style={`--d:${ENTRANCE[i % ENTRANCE.length].delay}`}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      class="btn btn-solid header-cta appear appear--scale"
      href={SCHEDULE_URL}
      target="_blank"
      rel="noopener"
      style="--d:0.34s">{t.nav.cta}</a
    >

    <button
      class="burger"
      type="button"
      id="burger"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span></span><span></span><span></span>
    </button>
  </header>

  <slot />
</div>

<!-- Lo que va después del primer cuadro: queda fuera de `.page` para que la
     altura de un viewport no lo comprima. -->
<slot name="after" />

<a
  class="wa appear appear--btn"
  href={waHref}
  target="_blank"
  rel="noopener"
  aria-label={t.whatsapp.aria}
  style="--d:1.58s"
>
  <svg width="21" height="21" viewBox="0 0 24 24" fill="none" aria-hidden="true"
    ><path
      d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 13.3789 2.27907 14.6926 2.78382 15.8877C3.06278 16.5481 3.20226 16.8784 3.21953 17.128C3.2368 17.3776 3.16334 17.6521 3.01642 18.2012L2 22L5.79877 20.9836C6.34788 20.8367 6.62244 20.7632 6.87202 20.7805C7.12161 20.7977 7.45185 20.9372 8.11235 21.2162C9.30745 21.7209 10.6211 22 12 22Z"
      stroke="currentColor"
      stroke-linejoin="round"
      stroke-width="1.5"></path><path
      d="M8.58815 12.3773L9.45909 11.2956C9.82616 10.8397 10.2799 10.4153 10.3155 9.80826C10.3244 9.65494 10.2166 8.96657 10.0008 7.58986C9.91601 7.04881 9.41086 7 8.97332 7C8.40314 7 8.11805 7 7.83495 7.12931C7.47714 7.29275 7.10979 7.75231 7.02917 8.13733C6.96539 8.44196 7.01279 8.65187 7.10759 9.07169C7.51023 10.8548 8.45481 12.6158 9.91948 14.0805C11.3842 15.5452 13.1452 16.4898 14.9283 16.8924C15.3481 16.9872 15.558 17.0346 15.8627 16.9708C16.2477 16.8902 16.7072 16.5229 16.8707 16.165C17 15.8819 17 15.5969 17 15.0267C17 14.5891 16.9512 14.084 16.4101 13.9992C15.0334 13.7834 14.3451 13.6756 14.1917 13.6845C13.5847 13.7201 13.1603 14.1738 12.7044 14.5409L11.6227 15.4118"
      stroke="currentColor"
      stroke-width="1.5"></path></svg
  >
  <span>{t.whatsapp.label}</span>
</a>

<script is:inline>
  ;(function () {
    var appears = document.querySelectorAll(".appear")

    Array.prototype.forEach.call(appears, function (el) {
      el.addEventListener(
        "animationend",
        function () {
          el.classList.add("is-in")
        },
        { once: true }
      )
    })

    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        var running = false
        Array.prototype.forEach.call(appears, function (el) {
          if (el.getAnimations && el.getAnimations().length) running = true
        })
        if (!running) {
          Array.prototype.forEach.call(appears, function (el) {
            el.classList.add("is-in")
          })
          var photo = document.querySelector(".hero-photo")
          if (photo) photo.classList.add("is-in")
        }
      })
    })

    // Loop sin corte: la copia que está por terminar le cede el paso a la
    // otra, que arranca de cero un segundo antes. El fundido dura lo mismo
    // que la transición de opacidad. Sólo corre en la portada.
    var videos = document.querySelectorAll(".hero-video")
    if (videos.length === 2) {
      var FADE = 1.2
      var live = 0
      var swapping = false

      var swap = function () {
        if (swapping) return
        swapping = true
        var next = videos[1 - live]
        next.currentTime = 0
        var playing = next.play()
        if (playing && playing.catch) playing.catch(function () {})
        next.classList.add("is-live")
        videos[live].classList.remove("is-live")
        live = 1 - live
        setTimeout(function () {
          swapping = false
        }, FADE * 1000)
      }

      videos.forEach(function (video) {
        video.addEventListener("timeupdate", function () {
          if (video !== videos[live] || !video.duration) return
          if (video.duration - video.currentTime <= FADE) swap()
        })
      })
    }

    var burger = document.getElementById("burger")
    var nav = document.getElementById("site-nav")

    function setMenu(open) {
      document.body.classList.toggle("menu-open", open)
      burger.setAttribute("aria-expanded", open ? "true" : "false")
      burger.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú")
    }

    burger.addEventListener("click", function () {
      setMenu(!document.body.classList.contains("menu-open"))
    })

    Array.prototype.forEach.call(nav.querySelectorAll("a"), function (a) {
      a.addEventListener("click", function () {
        setMenu(false)
      })
    })

    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") setMenu(false)
    })

    var wide = window.matchMedia("(min-width: 901px)")
    var onWide = function (e) {
      if (e.matches) setMenu(false)
    }
    if (wide.addEventListener) wide.addEventListener("change", onWide)
    else wide.addListener(onWide)
  })()
</script>
