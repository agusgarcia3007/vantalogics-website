---
import { render } from "astro:content"

import Layout from "@/layouts/main.astro"
import Chrome from "@/components/cine/Chrome.astro"
import Foot from "@/components/cine/Foot.astro"
import PostCard from "@/components/blog/PostCard.astro"
import { localizePath, ogImage, useTranslations } from "@/i18n"
import {
  formatDate,
  getRelated,
  getTranslations,
  postLang,
  postPath,
  readingTime,
  type Post,
} from "@/lib/blog"
import { findSolution, solutionPath } from "@/data/solutions"
import { SCHEDULE_URL } from "@/site"

interface Props {
  post: Post
}

const SITE = "https://vantalogics.com"
const { post } = Astro.props
const lang = postLang(post)
const t = useTranslations(lang)

const { Content, headings } = await render(post)
const related = await getRelated(post)
const translations = await getTranslations(post)

const path = postPath(post)
const pageUrl = new URL(path, SITE).href
const minutes = readingTime(post.body)
const blogPath = localizePath(lang, "/blog/")

/**
 * El sector del que habla la nota, si declara uno.
 *
 * `findSolution` busca por slug español porque es el identificador estable del
 * sector: la nota en inglés y la nota en árabe declaran el mismo valor, y cada
 * una resuelve el enlace a la página de sector de su propio idioma.
 */
const industrySolution = post.data.industry
  ? findSolution("es", post.data.industry)
  : undefined

// Sólo se declara `hreflang` cuando la traducción existe de verdad. Un
// alternate que devuelve 404 hace que Google descarte el par entero.
const alternates = {
  [lang]: path,
  ...Object.fromEntries(
    translations.map((other) => [postLang(other), postPath(other)])
  ),
}

// Índice con los h2. Los h3 quedan afuera a propósito: un índice de dos
// niveles en una nota de mil palabras es más ruido que ayuda.
const toc = headings.filter((heading) => heading.depth === 2)

const article = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${pageUrl}#article`,
  headline: post.data.title,
  description: post.data.description,
  /**
   * `abstract` lleva la respuesta corta y no la bajada. Es el campo que los
   * motores de respuesta usan como resumen citable, y la respuesta de 40–60
   * palabras es exactamente lo que queremos que citen.
   */
  abstract: post.data.answer,
  articleSection: t.blog.clusters[post.data.cluster],
  /**
   * `about` apuntando al servicio del sector.
   *
   * Es la mitad que faltaba del silo: la página de sector lista sus notas y
   * cada nota declara de qué sector habla. Un motor de respuesta que llega a
   * una nota por una consulta de rubro puede seguir el enlace hasta la página
   * canónica de la empresa sobre ese rubro sin depender de la navegación.
   */
  ...(industrySolution
    ? {
        about: {
          "@id": `${new URL(solutionPath(lang, industrySolution), SITE).href}#service`,
        },
      }
    : {}),
  keywords: post.data.tags.join(", "),
  inLanguage: lang,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  url: pageUrl,
  mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
  wordCount: (post.body ?? "").trim().split(/\s+/).filter(Boolean).length,
  isPartOf: { "@id": `${new URL(blogPath, SITE).href}#blog` },
  author: { "@id": `${SITE}/#organization` },
  publisher: { "@id": `${SITE}/#organization` },
  image: new URL(ogImage(lang), SITE).href,
  /**
   * `speakable` marca qué leería en voz alta un asistente. Apunta al titular y
   * al bloque de respuesta corta, que es la unidad que tiene sentido leer
   * suelta.
   */
  speakable: {
    "@type": "SpeakableSpecification",
    cssSelector: ["[data-speakable]"],
  },
}

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Vantalogics",
      item: new URL(localizePath(lang), SITE).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: t.blog.label,
      item: new URL(blogPath, SITE).href,
    },
    { "@type": "ListItem", position: 3, name: post.data.title, item: pageUrl },
  ],
}

const faqPage =
  post.data.faq.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "@id": `${pageUrl}#faq`,
        inLanguage: lang,
        mainEntity: post.data.faq.map((entry) => ({
          "@type": "Question",
          name: entry.question,
          acceptedAnswer: { "@type": "Answer", text: entry.answer },
        })),
      }
    : null

const jsonLd = [article, breadcrumb, faqPage].filter(Boolean)
---

<Layout
  lang={lang}
  path={path}
  title={post.data.seoTitle ?? `${post.data.title} — Vantalogics`}
  description={post.data.description}
  ogType="article"
  alternates={alternates}
  jsonLd={jsonLd}
  floating={false}
>
  <Chrome lang={lang}>
    <main class="doc-page" id="contenido">
      <div class="shell">
        <nav class="crumbs appear appear--soft" aria-label="Breadcrumb">
          <a href={localizePath(lang)}>Vantalogics</a>
          <span aria-hidden="true">/</span>
          <a href={blogPath}>{t.blog.label}</a>
        </nav>

        <header class="doc-head">
          <div class="doc-meta appear appear--soft" style="--d:0.2s">
            {
              industrySolution && (
                <>
                  <a href={solutionPath(lang, industrySolution)}>
                    {industrySolution.sector[lang]}
                  </a>
                  <span aria-hidden="true">·</span>
                </>
              )
            }
            <span>{t.blog.clusters[post.data.cluster]}</span>
            <span aria-hidden="true">·</span>
            <time datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date, lang)}
            </time>
            <span aria-hidden="true">·</span>
            <span>{minutes} {t.blog.readingTime}</span>
          </div>

          <h1 class="appear appear--soft" style="--d:0.32s" data-speakable>
            {post.data.title}
          </h1>

          {
            post.data.updated && (
              <p class="doc-updated appear appear--soft" style="--d:0.44s">
                {t.blog.updatedOn} {formatDate(post.data.updated, lang)}
              </p>
            )
          }
        </header>
      </div>
    </main>

    <div class="below" slot="after">
      <!-- Respuesta corta. Va antes que el cuerpo y encuadrada: es la unidad
           que extraen los motores de respuesta, y el lector que sólo vino a
           saber el número se va con el número sin leer mil palabras. -->
      <section class="section">
        <div class="shell">
          <div class="answer reveal">
            <p class="answer-label">{t.blog.answerLabel}</p>
            <p class="answer-body" data-speakable>{post.data.answer}</p>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="doc-body shell">
          <div class="typeset typeset-nota">
            <Content />
          </div>

          {
            toc.length > 1 && (
              <nav class="toc" aria-labelledby="indice-nota">
                <p id="indice-nota" class="toc-label">
                  {t.blog.tocLabel}
                </p>
                <ol>
                  {toc.map((heading) => (
                    <li>
                      <a href={`#${heading.slug}`}>{heading.text}</a>
                    </li>
                  ))}
                </ol>
              </nav>
            )
          }
        </div>
      </section>

      {
        post.data.faq.length > 0 && (
          <section class="section">
            <div class="shell">
              <div class="section-head reveal">
                <h2 id="faq-nota">{t.blog.faqLabel}</h2>
              </div>
              <dl class="faq">
                {post.data.faq.map((entry, i) => (
                  <div class="faq-item reveal" style={`--i:${i}`}>
                    <dt>{entry.question}</dt>
                    <dd>{entry.answer}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </section>
        )
      }

      <section class="section">
        <div class="shell">
          <div class="author reveal">
            <div>
              <p class="author-label">{t.blog.authorLabel}</p>
              <p class="author-name">{t.blog.author}</p>
              <p class="author-bio">{t.blog.authorBio}</p>
            </div>

            <div class="author-actions">
              <a
                class="btn btn-solid btn-lead"
                href={SCHEDULE_URL}
                target="_blank"
                rel="noopener noreferrer"
              >
                {t.blog.ctaButton}
                <span class="btn-pip" aria-hidden="true">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none">
                    <path
                      d="M7 17L17 7M17 7H9M17 7V15"
                      stroke="currentColor"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"></path>
                  </svg>
                </span>
              </a>
              <a class="btn btn-ghost" href={blogPath}>{t.blog.backToIndex}</a>
            </div>
          </div>
        </div>
      </section>

      {
        related.length > 0 && (
          <section class="section">
            <div class="shell">
              <div class="section-head reveal">
                <h2 id="relacionadas">{t.blog.relatedLabel}</h2>
              </div>
              <div class="posts">
                {related.map((item, i) => (
                  <PostCard post={item} index={i} />
                ))}
              </div>
            </div>
          </section>
        )
      }

      <Foot lang={lang} />
    </div>
  </Chrome>
</Layout>
