---
import Layout from "@/layouts/main.astro"
import Chrome from "@/components/cine/Chrome.astro"
import Foot from "@/components/cine/Foot.astro"
import PostCard from "@/components/blog/PostCard.astro"
import { LANGS, localizePath, useTranslations, type Lang } from "@/i18n"
import { getPosts, postPath } from "@/lib/blog"

interface Props {
  lang: Lang
}

const SITE = "https://vantalogics.com"
const { lang } = Astro.props
const t = useTranslations(lang)

const posts = await getPosts(lang)
const path = localizePath(lang, "/blog/")
const pageUrl = new URL(path, SITE).href

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": `${pageUrl}#blog`,
  url: pageUrl,
  name: t.blog.meta.title,
  description: t.blog.meta.description,
  inLanguage: lang,
  publisher: { "@id": `${SITE}/#organization` },
  blogPost: posts.map((post) => ({
    "@type": "BlogPosting",
    "@id": `${new URL(postPath(post), SITE).href}#article`,
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    url: new URL(postPath(post), SITE).href,
  })),
}

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Vantalogics",
      item: new URL(localizePath(lang), SITE).href,
    },
    { "@type": "ListItem", position: 2, name: t.blog.label, item: pageUrl },
  ],
}
---

<Layout
  lang={lang}
  path={path}
  title={t.blog.meta.title}
  description={t.blog.meta.description}
  alternates={Object.fromEntries(
    LANGS.map((code) => [code, localizePath(code, "/blog/")])
  )}
  jsonLd={[blogSchema, breadcrumb]}
  floating={false}
>
  <Chrome lang={lang}>
    <main class="doc-page" id="contenido">
      <div class="shell">
        <nav class="crumbs appear appear--soft" aria-label="Breadcrumb">
          <a href={localizePath(lang)}>Vantalogics</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{t.blog.label}</span>
        </nav>

        <div class="doc-head">
          <span class="appear appear--scale eyebrow" style="--d:0.2s">
            {t.blog.label}
          </span>
          <h1 class="appear appear--soft" style="--d:0.3s">
            <span class="doc-h1-muted">{t.blog.titleMuted}</span>{" "}
            {t.blog.titleBright}
          </h1>
          <p class="appear appear--soft" style="--d:0.42s">{t.blog.intro}</p>
        </div>
      </div>
    </main>

    <div class="below" slot="after">
      <section class="section">
        <div class="shell">
          {
            posts.length === 0 ? (
              <p class="doc-empty">{t.blog.empty}</p>
            ) : (
              <div class="posts">
                {posts.map((post, index) => (
                  <PostCard post={post} featured={index === 0} index={index} />
                ))}
              </div>
            )
          }
        </div>
      </section>

      <Foot lang={lang} />
    </div>
  </Chrome>
</Layout>
