---
import { useTranslations } from "@/i18n"
import {
  formatDate,
  postLang,
  postPath,
  readingTime,
  type Post,
} from "@/lib/blog"

interface Props {
  post: Post
  featured?: boolean
  index?: number
}

const { post, featured = false, index = 0 } = Astro.props
const lang = postLang(post)
const t = useTranslations(lang)
const minutes = readingTime(post.body)
---

<article
  class:list={["post", "reveal", featured && "post--featured"]}
  style={`--i:${index}`}
>
  <div class="post-core">
    <div class="post-meta">
      <span>{t.blog.clusters[post.data.cluster]}</span>
      <span aria-hidden="true">·</span>
      <time datetime={post.data.date.toISOString()}>
        {formatDate(post.data.date, lang)}
      </time>
      <span aria-hidden="true">·</span>
      <span>{minutes} {t.blog.readingTime}</span>
    </div>

    <h3 class="post-title">
      <a href={postPath(post)}>{post.data.title}</a>
    </h3>

    <p class="post-desc">{post.data.description}</p>

    <span class="post-go" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
        <path
          d="M7 17L17 7M17 7H9M17 7V15"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"></path>
      </svg>
    </span>
  </div>
</article>
