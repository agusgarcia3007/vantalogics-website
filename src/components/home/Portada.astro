---
import Layout from "@/layouts/main.astro"
import Chrome from "@/components/cine/Chrome.astro"
import Foot from "@/components/cine/Foot.astro"
import { PUBLIC_LANGS, localizePath, ogImage, useTranslations } from "@/i18n"
import { CASES, formatTotalStudents } from "@/data/cases"
import CaseCard from "@/components/cine/CaseCard.astro"
import { CONTACT_EMAIL, GITHUB_URL, INSTAGRAM_URL } from "@/site"

const SITE = "https://vantalogics.com"
const HERO_VIDEO =
  "https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260818_072341_50851634-bbc3-4c33-9acc-7647d4db44aa.mp4"
const lang = "es" as const
const t = useTranslations(lang)
const pageUrl = new URL(localizePath(lang), SITE).href

const organization = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${SITE}/#organization`,
  name: "Vantalogics",
  url: SITE,
  logo: `${SITE}/logo-va@2x.png`,
  image: `${SITE}${ogImage(lang)}`,
  description: t.footer.tagline,
  email: CONTACT_EMAIL,
  telephone: "+541178296140",
  slogan: t.hero.title,
  sameAs: [GITHUB_URL, INSTAGRAM_URL],
  audience: {
    "@type": "BusinessAudience",
    audienceType: t.hero.eyebrow,
  },
  areaServed: [
    { "@type": "Place", name: "Latin America" },
    { "@type": "Country", name: "Spain" },
    { "@type": "Country", name: "United States" },
  ],
  availableLanguage: PUBLIC_LANGS,
}

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE}/#website`,
  url: SITE,
  name: "Vantalogics",
  inLanguage: lang,
  description: t.meta.description,
  publisher: { "@id": `${SITE}/#organization` },
}

const webPage = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: "Vantalogics — Producto e ingeniería de IA para educación",
  description: t.meta.description,
  inLanguage: lang,
  isPartOf: { "@id": `${SITE}/#website` },
  about: { "@id": `${SITE}/#organization` },
}
---

<Layout
  lang={lang}
  title="Vantalogics — Producto e ingeniería de IA para educación"
  jsonLd={[organization, website, webPage]}
  floating={false}
>
  <Chrome lang={lang} frame>
    <div class="hero-photo" slot="backdrop" aria-hidden="true">
      <div class="hero-plate">
        <video
          class="hero-video is-live"
          src={HERO_VIDEO}
          autoplay
          muted
          playsinline
          preload="auto"></video>
        <video
          class="hero-video"
          src={HERO_VIDEO}
          muted
          playsinline
          preload="auto"></video>
      </div>
    </div>

    <main class="hero" id="top">
      <span id="contenido" tabindex="-1" class="sr-only"></span>
      <div class="hero-copy">
        <div class="badge appear appear--pop" style="--d:0.22s">
          <svg
            class="badge-star"
            width="15"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
            ><path
              d="M15 2L15.5387 4.39157C15.9957 6.42015 17.5798 8.00431 19.6084 8.46127L22 9L19.6084 9.53873C17.5798 9.99569 15.9957 11.5798 15.5387 13.6084L15 16L14.4613 13.6084C14.0043 11.5798 12.4202 9.99569 10.3916 9.53873L8 9L10.3916 8.46127C12.4201 8.00431 14.0043 6.42015 14.4613 4.39158L15 2Z"
              stroke="currentColor"
              stroke-linejoin="round"
              stroke-width="1.5"></path><path
              d="M7 12L7.38481 13.7083C7.71121 15.1572 8.84275 16.2888 10.2917 16.6152L12 17L10.2917 17.3848C8.84275 17.7112 7.71121 18.8427 7.38481 20.2917L7 22L6.61519 20.2917C6.28879 18.8427 5.15725 17.7112 3.70827 17.3848L2 17L3.70827 16.6152C5.15725 16.2888 6.28879 15.1573 6.61519 13.7083L7 12Z"
              stroke="currentColor"
              stroke-linejoin="round"
              stroke-width="1.5"></path></svg
          >
          Producto · IA aplicada · Ingeniería
        </div>

        <h1>
          <span class="headline-line"
            ><span class="appear appear--mask" style="--d:0.42s"
              >Construimos la inteligencia detrás</span
            ></span
          >
          <span class="headline-line"
            ><span class="appear appear--mask" style="--d:0.62s"
              >de los <em>productos educativos.</em></span
            ></span
          >
        </h1>

        <p
          class="lede appear appear--soft"
          style="--d:0.82s; animation-duration:1.25s"
        >
          Diseñamos agentes especializados, sistemas de evaluación y plataformas
          de aprendizaje completas. Producto, experiencia, IA e ingeniería en un
          mismo equipo.
        </p>

        <div class="hero-actions">
          <a
            class="btn btn-solid btn-lead appear appear--btn"
            href="https://cal.com/vantalogics"
            target="_blank"
            rel="noopener"
            style="--d:0.96s"
          >
            Hablar de tu producto
            <span class="btn-pip" aria-hidden="true">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none">
                <path
                  d="M7 17L17 7M17 7H9M17 7V15"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"></path>
              </svg>
            </span>
          </a>
          <a
            class="btn btn-ghost appear appear--side"
            href="#casos"
            style="--d:1.10s">Ver nuestro trabajo</a
          >
        </div>
      </div>
    </main>

    <footer class="stats">
      <div class="appear appear--stat" style="--d:1.12s">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
          ><path
            d="M13 7C13 9.20914 11.2091 11 9 11C6.79086 11 5 9.20914 5 7C5 4.79086 6.79086 3 9 3C11.2091 3 13 4.79086 13 7Z"
            stroke="currentColor"
            stroke-width="1.5"></path><path
            d="M15 11C17.2091 11 19 9.20914 19 7C19 4.79086 17.2091 3 15 3"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"></path><path
            d="M11 14H7C4.23858 14 2 16.2386 2 19C2 20.1046 2.89543 21 4 21H14C15.1046 21 16 20.1046 16 19C16 16.2386 13.7614 14 11 14Z"
            stroke="currentColor"
            stroke-linejoin="round"
            stroke-width="1.5"></path><path
            d="M17 14C19.7614 14 22 16.2386 22 19C22 20.1046 21.1046 21 20 21H18.5"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"></path></svg
        >
        {formatTotalStudents(lang)} estudiantes
      </div>

      <div class="appear appear--stat" style="--d:1.28s">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
          ><path
            d="M20.1088 20.1088C18.7175 21.5 16.4783 21.5 12 21.5C7.52166 21.5 5.28249 21.5 3.89124 20.1088C2.5 18.7175 2.5 16.4783 2.5 12C2.5 7.52166 2.5 5.28248 3.89124 3.89124C5.28249 2.5 7.52166 2.5 12 2.5C16.4783 2.5 18.7175 2.5 20.1088 3.89124C21.5 5.28249 21.5 7.52166 21.5 12C21.5 16.4783 21.5 18.7175 20.1088 20.1088Z"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"></path><path
            d="M9 21.5L9 2.5"
            stroke="currentColor"
            stroke-width="1.5"></path></svg
        >
        Productos educativos en producción
      </div>

      <div class="appear appear--stat" style="--d:1.44s">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
          ><circle
            cx="12"
            cy="12"
            r="10"
            stroke="currentColor"
            stroke-width="1.5"></circle><path
            d="M12 8V12L14 14"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"></path></svg
        >
        Respuesta en menos de 24 h hábiles
      </div>
    </footer>

    <div class="below below--frame" slot="after">
      <section class="section" id="casos">
        <div class="shell">
          <div class="section-head reveal">
            <span class="eyebrow">{t.cases.eyebrow}</span>
            <h2>{t.cases.title}</h2>
            <p>{t.cases.intro}</p>
          </div>

          <div class="cases">
            {
              CASES.map((item, i) => (
                <CaseCard lang={lang} item={item} index={i} />
              ))
            }
          </div>
          <p class="section-more reveal">
            <a href="/plataformas-educativas/"
              >Cómo desarrollamos plataformas educativas a medida</a
            >
          </p>
        </div>
      </section>

      <section class="section" id="proceso">
        <div class="shell">
          <div class="section-head reveal">
            <span class="eyebrow">{t.process.eyebrow}</span>
            <h2>{t.process.title}</h2>
          </div>

          <div class="steps">
            {
              t.process.steps.map((step, i) => (
                <div class="step reveal" style={`--i:${i}`}>
                  <span class="step-n">{step.step}</span>
                  <div>
                    <h3>{step.title}</h3>
                    <p>{step.body}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <Foot lang={lang} />
    </div>
  </Chrome>
</Layout>
