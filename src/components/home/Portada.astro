---
/**
 * Portada cinemática: un solo viewport, sin scroll en desktop.
 *
 * Trae su propio header y su botón de WhatsApp, así que el layout no monta los
 * flotantes (`floating={false}`): de lo contrario habría dos WhatsApp y el del
 * layout, que depende de `data-floating`, nunca aparecería en una página que
 * no scrollea.
 *
 * Inter sale de `--font-inter` (@fontsource-variable/inter, ya self-hosted).
 * La única fuente nueva es Instrument Serif, en public/fonts.
 */
import Layout from "@/layouts/main.astro"
import { PUBLIC_LANGS, localizePath, ogImage, useTranslations } from "@/i18n"
import { CONTACT_EMAIL, GITHUB_URL, INSTAGRAM_URL, whatsappUrl } from "@/site"

const SITE = "https://vantalogics.com"
const lang = "es" as const
const t = useTranslations(lang)
const pageUrl = new URL(localizePath(lang), SITE).href
const waHref = whatsappUrl(t.whatsapp.prefill)

/**
 * Datos estructurados. Quedan los tres que siguen describiendo lo que la
 * página declara —la empresa, el sitio y esta portada— y se cae el `HowTo` del
 * proceso: sus pasos ya no están en pantalla, y los datos estructurados tienen
 * que reflejar el contenido visible.
 */
const organization = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${SITE}/#organization`,
  name: "Vantalogics",
  url: SITE,
  logo: `${SITE}/logo-va@2x.png`,
  image: `${SITE}${ogImage(lang)}`,
  description: t.footer.tagline,
  email: CONTACT_EMAIL,
  telephone: "+541178296140",
  slogan: t.hero.title,
  sameAs: [GITHUB_URL, INSTAGRAM_URL],
  audience: {
    "@type": "BusinessAudience",
    audienceType: t.hero.eyebrow,
  },
  areaServed: [
    { "@type": "Place", name: "Latin America" },
    { "@type": "Country", name: "Spain" },
    { "@type": "Country", name: "United States" },
  ],
  availableLanguage: PUBLIC_LANGS,
}

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE}/#website`,
  url: SITE,
  name: "Vantalogics",
  inLanguage: lang,
  description: t.meta.description,
  publisher: { "@id": `${SITE}/#organization` },
}

const webPage = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: "Vantalogics — Producto e ingeniería de IA para educación",
  description: t.meta.description,
  inLanguage: lang,
  isPartOf: { "@id": `${SITE}/#website` },
  about: { "@id": `${SITE}/#organization` },
}
---

<Layout
  lang={lang}
  title="Vantalogics — Producto e ingeniería de IA para educación"
  jsonLd={[organization, website, webPage]}
  floating={false}
>
  <style is:global>
    /* ── BLACK FIRST — nunca un flash blanco ───────────────────────── */
    html,
    body {
      background: #000000 !important;
      color: #ffffff;
    }

    /* ── FONTS ─────────────────────────────────────────────────────── */
    /* Inter ya la sirve @fontsource-variable/inter vía --font-inter; acá sólo
   hace falta la itálica del serif, que no existía en el sitio. */
    @font-face {
      font-family: "Instrument Serif";
      font-style: italic;
      font-weight: 400;
      font-display: swap;
      src: url("/fonts/instrument-serif-italic.woff2") format("woff2");
    }

    /* ── RESET ─────────────────────────────────────────────────────── */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    a {
      color: inherit;
      text-decoration: none;
    }
    button {
      font-family: inherit;
    }
    html {
      scroll-behavior: smooth;
    }

    /* ── TOKENS — default ~1440px ──────────────────────────────────── */
    :root {
      --bg: #000000;
      --text: #ffffff;
      --muted: #9a9a9a;
      --stat: #d8d8d8;

      --border: rgba(255, 255, 255, 0.16);
      --border-soft: rgba(255, 255, 255, 0.12);

      --logo: 15.5px;
      --logo-mark: 25px;

      --nav: 14px;
      --nav-h: 40px;
      --nav-px: 18px;

      --btn: 13.5px;
      --btn-h: 40px;
      --hero-btn-h: 42px;

      --h1: 48px;
      --lede: 15.5px;
      --badge: 12.5px;
      --stat-size: 13.5px;

      --header-y: 22px;
      --header-x: 40px;

      --stats-x: 72px;
      --stats-y: 36px;

      --hero-gap: 85px;

      --copy-max: 930px;
      --lede-max: 620px;

      --badge-mb: 22px;
      --lede-mt: 18px;
      --actions-mt: 26px;
    }

    html,
    body {
      background: #000000;
      background: var(--bg, #000000);
      color: #ffffff;
      color: var(--text, #ffffff);
    }

    body {
      font-family: var(--font-inter);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      text-rendering: optimizeLegibility;
      overflow-x: hidden;
      position: relative;
    }

    /* ── HERO BACKGROUND ───────────────────────────────────────────── */
    .hero-photo {
      position: fixed;
      inset: 0;
      z-index: 0;
      overflow: hidden;
      background: #000;
    }
    .hero-photo video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      opacity: 1;
      display: block;
    }
    .hero-photo::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0.12) 0%,
        rgba(0, 0, 0, 0.08) 32%,
        rgba(0, 0, 0, 0.3) 64%,
        rgba(0, 0, 0, 0.62) 100%
      );
      pointer-events: none;
    }

    /* ── GRAIN ─────────────────────────────────────────────────────── */
    .grain {
      position: fixed;
      inset: 0;
      z-index: 100;
      pointer-events: none;
      opacity: 0.035;
      mix-blend-mode: screen;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='160' height='160' filter='url(%23n)'/></svg>");
      background-size: 160px 160px;
    }

    /* ── PAGE ──────────────────────────────────────────────────────── */
    .page {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-rows: auto 1fr auto;
      min-height: 100vh;
      min-height: 100dvh;
    }

    /* ── HEADER ────────────────────────────────────────────────────── */
    .header {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      padding: var(--header-y) var(--header-x) 10px;
      z-index: 50;
      position: relative;
    }

    .logo {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      justify-self: start;
      font-size: var(--logo);
      font-weight: 600;
      letter-spacing: -0.035em;
      color: #fff;
    }
    .logo-mark {
      width: var(--logo-mark);
      height: var(--logo-mark);
      object-fit: contain;
      filter: invert(1) brightness(2);
    }

    /* ── NAV ───────────────────────────────────────────────────────── */
    .nav {
      display: flex;
      align-items: center;
      gap: 8px;
      justify-self: center;
    }
    .nav a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: var(--nav-h);
      padding: 0 var(--nav-px);
      position: relative;
      border: 0;
      background: none;
      color: #cfcfcf;
      font-size: var(--nav);
      font-weight: 400;
      letter-spacing: -0.01em;
      white-space: nowrap;
      transition: color 0.35s ease;
    }
    .nav a:hover,
    .nav a:focus-visible {
      color: #fff;
    }

    /* ── BUTTONS ───────────────────────────────────────────────────── */
    .btn {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: var(--btn-h);
      padding: 0 16px;
      border-radius: 6px;
      font-size: var(--btn);
      font-weight: 500;
      letter-spacing: -0.02em;
      line-height: 1;
      white-space: nowrap;
      cursor: pointer;
      transition:
        background 0.35s ease,
        box-shadow 0.35s ease,
        border-color 0.35s ease;
    }
    .btn-solid {
      background: linear-gradient(
        180deg,
        #ffffff 0%,
        #e7e7e7 48%,
        #cfcfcf 100%
      );
      color: #111;
      border: 1px solid #fff;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.95);
    }
    .btn-solid:hover {
      background: linear-gradient(180deg, #fff 0%, #f3f6ff 42%, #d5def2 100%);
      box-shadow:
        inset 0 1px 0 #fff,
        0 0 22px rgba(186, 208, 255, 0.35),
        0 8px 18px rgba(255, 255, 255, 0.12);
    }
    .btn-ghost {
      background: linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.1),
        rgba(0, 0, 0, 0.45) 50%,
        rgba(160, 175, 200, 0.08)
      );
      color: #fff;
      border: 1px solid rgba(198, 198, 198, 0.45);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12);
    }
    .btn-ghost:hover {
      border-color: rgba(235, 235, 235, 0.85);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.2),
        0 0 18px rgba(200, 210, 230, 0.14);
    }
    .header-cta {
      justify-self: end;
    }

    /* ── BURGER ────────────────────────────────────────────────────── */
    .burger {
      display: none;
      width: 42px;
      height: 42px;
      place-items: center;
      align-content: center;
      border: 0;
      background: none;
      z-index: 60;
      cursor: pointer;
    }
    .burger span {
      display: block;
      width: 16px;
      height: 1.5px;
      border-radius: 1px;
      background: #fff;
      transition:
        transform 0.25s ease,
        opacity 0.25s ease;
    }
    .burger span + span {
      margin-top: 5px;
    }
    body.menu-open .burger span:nth-child(1) {
      transform: translateY(6.5px) rotate(45deg);
    }
    body.menu-open .burger span:nth-child(2) {
      opacity: 0;
    }
    body.menu-open .burger span:nth-child(3) {
      transform: translateY(-6.5px) rotate(-45deg);
    }

    /* ── MENU BACKDROP ─────────────────────────────────────────────── */
    .menu-backdrop {
      display: none;
    }

    /* ── HERO ──────────────────────────────────────────────────────── */
    .hero {
      display: flex;
      align-items: flex-end;
      justify-content: center;
      padding: 8px 24px var(--hero-gap);
      min-height: 0;
    }
    .hero-copy {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      max-width: var(--copy-max);
      width: 100%;
    }

    /* ── BADGE ─────────────────────────────────────────────────────── */
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-bottom: var(--badge-mb);
      padding: 9px 15px;
      border: 0;
      border-radius: 5px;
      background: linear-gradient(90deg, #7d7d7d 0%, #2a2a2a 52%, #0a0a0a 100%);
      color: #f2f2f2;
      font-size: var(--badge);
      font-weight: 400;
      letter-spacing: -0.01em;
    }
    .badge-star {
      flex: none;
      animation: star-pop 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.28s both;
      transform-origin: 50% 50%;
    }

    /* ── HEADLINE ──────────────────────────────────────────────────── */
    .hero h1 {
      font-family: var(--font-inter);
      font-size: var(--h1);
      font-weight: 500;
      letter-spacing: -0.045em;
      line-height: 1.1;
      color: #fff;
      text-align: center;
    }
    .headline-line {
      display: block;
      overflow: hidden;
      padding: 0.06em 0.15em 0.14em;
    }
    .headline-line > span {
      display: inline-block;
    }
    .hero h1 em {
      font-family: "Instrument Serif", "Times New Roman", Times, serif;
      font-style: italic;
      font-weight: 400;
      font-size: 1.08em;
      letter-spacing: -0.03em;
      color: #a6a6a6;
      animation: serif-focus 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.72s both;
    }

    /* ── LEDE ──────────────────────────────────────────────────────── */
    .lede {
      max-width: var(--lede-max);
      margin-top: var(--lede-mt);
      color: #a0a0a0;
      font-size: var(--lede);
      font-weight: 400;
      line-height: 1.55;
      letter-spacing: -0.015em;
    }

    /* ── ACTIONS ───────────────────────────────────────────────────── */
    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px;
      margin-top: var(--actions-mt);
    }
    .hero-actions .btn {
      height: var(--hero-btn-h);
      padding: 0 18px;
    }
    .hero-actions .btn-ghost {
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }

    /* ── WHATSAPP ──────────────────────────────────────────────────── */
    .wa {
      position: fixed;
      z-index: 60;
      right: max(var(--stats-x), env(safe-area-inset-right));
      bottom: calc(max(var(--stats-y), env(safe-area-inset-bottom)) + 56px);
      display: inline-flex;
      align-items: center;
      height: var(--btn-h);
      padding: 0 13px;
      border-radius: 6px;
      border: 1px solid rgba(198, 198, 198, 0.45);
      background: linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.1),
        rgba(0, 0, 0, 0.45) 50%,
        rgba(160, 175, 200, 0.08)
      );
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      color: #fff;
      font-size: var(--btn);
      font-weight: 500;
      letter-spacing: -0.02em;
      line-height: 1;
      white-space: nowrap;
      transition:
        border-color 0.35s ease,
        box-shadow 0.35s ease,
        opacity 0.28s ease,
        visibility 0.28s ease;
    }
    .wa:hover,
    .wa:focus-visible {
      border-color: rgba(235, 235, 235, 0.85);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.2),
        0 0 18px rgba(200, 210, 230, 0.14);
      outline: none;
    }
    .wa svg {
      flex: none;
    }
    .wa span {
      max-width: 0;
      overflow: hidden;
      opacity: 0;
      transition:
        max-width 0.45s cubic-bezier(0.16, 1, 0.3, 1),
        opacity 0.35s ease,
        margin 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .wa:hover span,
    .wa:focus-visible span {
      max-width: 22ch;
      opacity: 1;
      margin-left: 10px;
    }

    /* ── PROOF STRIP ───────────────────────────────────────────────── */
    .stats {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      padding: 0 var(--stats-x) var(--stats-y);
      padding-bottom: max(var(--stats-y), env(safe-area-inset-bottom));
      color: #d8d8d8;
      color: var(--stat, #d8d8d8);
    }
    .stats > div {
      display: inline-flex;
      align-items: center;
      gap: 14px;
      font-size: var(--stat-size);
      letter-spacing: -0.015em;
      white-space: nowrap;
    }
    .stats svg {
      flex: none;
    }

    /* ── ENTRANCE MOTION ───────────────────────────────────────────── */
    .appear {
      opacity: 1;
      animation-duration: 1.05s;
      animation-fill-mode: both;
      animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
      animation-delay: var(--d, 0.08s);
    }
    .appear--scale {
      animation-name: in-scale;
    }
    .appear--soft {
      animation-name: in-soft;
    }
    .appear--mask {
      animation-name: in-mask;
    }
    .appear--pop {
      animation-name: in-pop;
    }
    .appear--btn {
      animation-name: in-btn;
    }
    .appear--side {
      animation-name: in-side;
    }
    .appear--stat {
      animation-name: in-stat;
    }

    .is-in {
      animation: none;
      opacity: 1;
      transform: none;
      clip-path: none;
      filter: none;
    }

    @keyframes in-scale {
      from {
        opacity: 0;
        transform: scale(0.84);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }
    @keyframes in-soft {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    @keyframes in-mask {
      from {
        opacity: 0;
        transform: translateY(40%);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    @keyframes in-pop {
      0% {
        opacity: 0;
        transform: scale(0.9);
      }
      70% {
        opacity: 1;
        transform: scale(1.03);
      }
      100% {
        opacity: 1;
        transform: scale(1);
      }
    }
    @keyframes in-btn {
      from {
        opacity: 0;
        transform: translateY(18px) scale(0.94);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    @keyframes in-side {
      from {
        opacity: 0;
        transform: translateX(22px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    @keyframes in-stat {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    @keyframes star-pop {
      0% {
        opacity: 0;
        transform: scale(0.2) rotate(-50deg);
      }
      65% {
        opacity: 1;
        transform: scale(1.2) rotate(8deg);
      }
      100% {
        opacity: 1;
        transform: scale(1) rotate(0deg);
      }
    }
    @keyframes serif-focus {
      from {
        opacity: 0.35;
        filter: blur(4px);
      }
      to {
        opacity: 1;
        filter: blur(0);
      }
    }

    /* ── DESKTOP LOCK ──────────────────────────────────────────────── */
    @media (min-width: 901px) {
      html,
      body {
        height: 100%;
        overflow: hidden;
      }
      .page {
        height: 100vh;
        height: 100dvh;
        overflow: hidden;
      }
    }

    /* ── RESPONSIVE TOKENS ─────────────────────────────────────────── */
    @media (min-width: 1600px) {
      :root {
        --logo: 17px;
        --logo-mark: 27px;
        --nav: 15px;
        --nav-h: 44px;
        --nav-px: 20px;
        --btn: 15px;
        --btn-h: 44px;
        --hero-btn-h: 48px;
        --h1: 64px;
        --lede: 18px;
        --badge: 13.5px;
        --stat-size: 15px;
        --header-y: 28px;
        --header-x: 64px;
        --stats-x: 96px;
        --stats-y: 44px;
        --copy-max: 1050px;
        --lede-max: 690px;
        --badge-mb: 26px;
        --lede-mt: 22px;
        --actions-mt: 30px;
      }
    }
    @media (min-width: 1920px) {
      :root {
        --logo: 18px;
        --logo-mark: 30px;
        --nav: 16px;
        --nav-h: 48px;
        --btn: 16px;
        --btn-h: 48px;
        --hero-btn-h: 52px;
        --h1: 76px;
        --lede: 20px;
        --badge: 14.5px;
        --stat-size: 16px;
        --header-y: 32px;
        --header-x: 80px;
        --stats-x: 120px;
        --stats-y: 52px;
        --copy-max: 1220px;
        --lede-max: 760px;
      }
    }
    @media (min-width: 2560px) {
      :root {
        --h1: 88px;
        --lede: 22px;
        --header-x: 120px;
        --stats-x: 160px;
        --copy-max: 1380px;
        --lede-max: 820px;
      }
    }
    @media (min-width: 1280px) and (max-width: 1599px) {
      :root {
        --h1: 54px;
        --lede: 16px;
        --header-x: 48px;
        --stats-x: 80px;
        --copy-max: 980px;
        --lede-max: 660px;
      }
    }
    @media (min-width: 901px) and (max-width: 1279px) {
      :root {
        --logo: 15px;
        --logo-mark: 24px;
        --nav: 13px;
        --nav-h: 36px;
        --nav-px: 14px;
        --btn: 13px;
        --btn-h: 38px;
        --hero-btn-h: 40px;
        --h1: 42px;
        --lede: 15px;
        --badge: 12px;
        --stat-size: 12.5px;
        --header-y: 16px;
        --header-x: 28px;
        --stats-x: 28px;
        --stats-y: 36px;
        --hero-gap: 64px;
        --copy-max: 800px;
        --lede-max: 560px;
      }
    }

    /* ── SHORT DESKTOP VIEWPORTS ───────────────────────────────────── */
    @media (min-width: 901px) and (max-height: 850px) {
      :root {
        --header-y: 14px;
        --stats-y: 24px;
        --hero-gap: 48px;
        --h1: 40px;
        --badge-mb: 12px;
        --lede-mt: 12px;
        --actions-mt: 16px;
      }
    }
    @media (min-width: 901px) and (max-height: 720px) {
      :root {
        --h1: 34px;
        --lede: 14px;
        --hero-gap: 32px;
        --stats-y: 18px;
        --nav-h: 30px;
        --btn-h: 34px;
        --hero-btn-h: 36px;
        --badge-mb: 8px;
      }
    }

    /* ── MOBILE ≤900 ───────────────────────────────────────────────── */
    @media (max-width: 900px) {
      html,
      body {
        height: auto;
        overflow-y: auto;
      }

      :root {
        --logo: 16px;
        --logo-mark: 26px;
        --btn: 15px;
        --btn-h: 46px;
        --hero-btn-h: 48px;
        --h1: 36px;
        --lede: 16.5px;
        --badge: 13.5px;
        --stat-size: 15px;
        --header-y: 16px;
        --header-x: 18px;
        --stats-x: 20px;
        --stats-y: 28px;
        --hero-gap: 36px;
      }

      .header {
        grid-template-columns: 1fr auto auto;
        gap: 8px;
        padding-top: max(var(--header-y), env(safe-area-inset-top));
        padding-left: max(var(--header-x), env(safe-area-inset-left));
        padding-right: max(var(--header-x), env(safe-area-inset-right));
      }
      .logo,
      .header-cta,
      .burger {
        z-index: 80;
      }
      .burger {
        display: grid;
      }

      .menu-backdrop {
        display: block;
        position: fixed;
        inset: 0;
        z-index: 40;
        background: rgba(8, 8, 8, 0.42);
        opacity: 0;
        visibility: hidden;
        transition:
          opacity 0.28s ease,
          visibility 0.28s ease;
      }
      body.menu-open .menu-backdrop {
        opacity: 1;
        visibility: visible;
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
      }

      .nav {
        position: fixed;
        inset: 0;
        z-index: 45;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        justify-content: center;
        gap: 12px;
        padding: max(96px, calc(env(safe-area-inset-top) + 88px)) 22px 32px;
        background: transparent;
        opacity: 0;
        visibility: hidden;
        transition:
          opacity 0.28s ease,
          visibility 0.28s ease;
      }
      body.menu-open .nav {
        opacity: 1;
        visibility: visible;
      }
      .nav a {
        width: 100%;
        height: 56px;
        font-size: 19px;
        justify-content: center;
      }

      body.menu-open {
        overflow: hidden;
      }

      .hero {
        padding: 20px 20px var(--hero-gap);
      }
      .hero-copy {
        max-width: 100%;
      }
      .lede {
        max-width: 100%;
      }

      /* El botón flota en una banda reservada bajo la prueba, nunca encima. */
      .wa {
        right: max(16px, env(safe-area-inset-right));
        bottom: max(16px, env(safe-area-inset-bottom));
      }
      body.menu-open .wa {
        opacity: 0;
        visibility: hidden;
      }

      .stats {
        padding-bottom: calc(
          max(var(--stats-y), env(safe-area-inset-bottom)) + 58px
        );
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 16px;
        text-align: center;
      }
    }

    @media (max-width: 560px) {
      :root {
        --h1: 34px;
        --lede: 16px;
        --header-x: 16px;
      }
      .header-cta {
        padding: 0 12px;
        font-size: 13.5px;
      }
      .logo {
        gap: 8px;
      }
      .hero-actions {
        flex-direction: column;
        width: 100%;
      }
      .hero-actions .btn {
        width: 100%;
      }
    }

    /* ── REDUCED MOTION ────────────────────────────────────────────── */
    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        transition: none !important;
        animation: none !important;
      }
      .appear,
      .wa span,
      .hero-photo,
      .hero h1 em,
      .badge-star {
        opacity: 1;
        transform: none;
        clip-path: none;
        filter: none;
      }
      .logo-mark {
        filter: invert(1) brightness(2);
      }
    }
  </style>

