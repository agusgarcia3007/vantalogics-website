---
interface Props {
  title: string
  tag: string
  class?: string
}

const { title, tag, class: className = "" } = Astro.props
---

<!-- Marco común de las interfaces de ejemplo: superficie graphite, barra
     superior con título y etiqueta de estado (design.md › BETA Tag). -->
<div
  class:list={["relative overflow-hidden card", className]}
  aria-hidden="true"
>
  <div
    class="flex items-center justify-between gap-4 border-b border-iron px-4 py-3"
  >
    <p class="text-[13px] font-medium text-bone">{title}</p>
    <span
      class="rounded-[4px] border border-iron px-[6px] py-[2px] eyebrow text-mist"
    >
      {tag}
    </span>
  </div>
  <div class="relative p-4 sm:p-6">
    <slot />
  </div>
</div>
