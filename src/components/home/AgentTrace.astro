---
import { HugeiconsIcon } from "@hugeicons/react"
import {
  BookOpen01Icon,
  CheckmarkCircle02Icon,
  Search01Icon,
  SecurityCheckIcon,
  UserIcon,
  AiChat02Icon,
} from "@hugeicons/core-free-icons"

import { useTranslations, type Lang } from "@/i18n"

interface Props {
  lang: Lang
  class?: string
}

const { lang, class: className = "" } = Astro.props
const t = useTranslations(lang).hero.trace
const stepIcons = [UserIcon, Search01Icon, SecurityCheckIcon, AiChat02Icon]
---

<figure
  class:list={[
    "trace relative overflow-hidden card bg-graphite/80 backdrop-blur-xl",
    className,
  ]}
  data-reveal
  data-trace
  style="--reveal-delay: 420ms;"
>
  <div
    class="flex items-center justify-between gap-4 border-b border-iron px-4 py-3"
  >
    <div class="flex min-w-0 items-center gap-3">
      <span
        class="grid size-7 shrink-0 place-items-center rounded-[6px] border border-slate-edge bg-iron text-soft-indigo"
      >
        <HugeiconsIcon icon={BookOpen01Icon} size={15} strokeWidth={1.5} />
      </span>
      <div class="min-w-0">
        <p class="truncate text-[14px] leading-tight font-medium text-bone">
          {t.title}
        </p>
        <p class="truncate mono-sm text-mist">{t.context}</p>
      </div>
    </div>
    <div
      class="flex shrink-0 items-center gap-1 rounded-[6px] border border-iron p-[3px]"
    >
      {
        t.tabs.map((tab, i) => (
          <span
            class:list={[
              "rounded-[4px] px-2 py-[3px] text-[12px] leading-none",
              i === 0 ? "bg-iron text-bone" : "text-mist",
            ]}
          >
            {tab}
          </span>
        ))
      }
    </div>
  </div>

  <div class="px-4 pt-4 pb-3">
    <div class="flex items-center justify-between">
      <p class="eyebrow text-mist">{t.askLabel}</p>
      <p class="flex items-center gap-2 eyebrow text-ash">
        <span class="live-dot" aria-hidden="true"></span>
        {t.status}
      </p>
    </div>
    <p class="trace-question mt-2 text-[15px] leading-snug text-bone">
      “{t.question}”
    </p>
  </div>

  <ol class="relative px-4 pb-4">
    <span
      class="trace-rail absolute top-2 bottom-6 left-[27px] w-px bg-iron"
      aria-hidden="true"></span>
    {
      t.steps.map((step, i) => {
        const Icon = stepIcons[i]
        return (
          <li
            class="trace-step relative flex items-start gap-3 py-[7px]"
            style={`--i: ${i};`}
          >
            <span class="relative z-10 grid size-6 shrink-0 place-items-center rounded-full border border-slate-edge bg-graphite text-ash">
              <span class="step-spin" aria-hidden="true" />
              <span class="step-icon grid place-items-center">
                <HugeiconsIcon icon={Icon} size={12} strokeWidth={1.6} />
              </span>
            </span>
            <div class="flex min-w-0 flex-1 items-baseline justify-between gap-3 pt-[3px]">
              <span class="text-[13px] leading-snug text-ash">
                <span class="font-medium text-bone">{step.label}</span>
                <span class="text-mist"> · </span>
                {step.detail}
              </span>
              <span
                class="step-check shrink-0 text-soft-indigo"
                aria-hidden="true"
              >
                <HugeiconsIcon
                  icon={CheckmarkCircle02Icon}
                  size={14}
                  strokeWidth={1.6}
                />
              </span>
            </div>
          </li>
        )
      })
    }
  </ol>

  <dl class="trace-metrics grid grid-cols-3 border-t border-iron">
    {
      t.metrics.map((metric, i) => (
        <div class:list={["px-4 py-3", i > 0 && "border-l border-iron"]}>
          <dt class="eyebrow text-mist">{metric.label}</dt>
          <dd class="mt-1 text-[13px] font-medium text-bone">{metric.value}</dd>
        </div>
      ))
    }
  </dl>

  <figcaption class="border-t border-iron px-4 py-2 eyebrow text-mist">
    {t.badge}
  </figcaption>
</figure>

<style>
  .live-dot {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--indigo);
  }

  .live-dot::after {
    content: "";
    position: absolute;
    inset: -4px;
    border-radius: inherit;
    border: 1px solid var(--indigo);
    animation: ping 2.4s var(--ease-out) infinite;
  }

  @keyframes ping {
    from {
      opacity: 0.8;
      transform: scale(0.4);
    }
    to {
      opacity: 0;
      transform: scale(1.6);
    }
  }

  .step-spin {
    position: absolute;
    inset: -1px;
    border-radius: 9999px;
    border: 1px solid transparent;
    border-top-color: var(--indigo);
    opacity: 0;
  }

  :global(.js) .trace-step {
    opacity: 0;
    transform: translate3d(0, 6px, 0);
  }

  :global(.js) .trace-step .step-check {
    opacity: 0;
    transform: scale(0.6);
  }

  :global(.js) .trace-question {
    clip-path: inset(0 100% 0 0);
  }

  [data-revealed] .trace-question {
    animation: type 1.1s steps(28, end) 0.7s forwards;
  }

  [data-revealed] .trace-step {
    --at: calc(1.9s + var(--i) * 0.75s);
    animation: step-in 0.5s var(--ease-out) var(--at) forwards;
  }

  [data-revealed] .trace-step .step-spin {
    animation:
      spin 0.6s linear var(--at) 1,
      fade 0.6s linear var(--at) 1;
  }

  [data-revealed] .trace-step .step-check {
    animation: check 0.4s var(--ease-out) calc(var(--at) + 0.55s) forwards;
  }

  :global(.js) [data-revealed] .trace-step .step-icon {
    animation: tint 0.3s var(--ease-out) calc(var(--at) + 0.55s) forwards;
  }

  @keyframes type {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes step-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes fade {
    0%,
    80% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes check {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes tint {
    to {
      color: var(--bone);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .trace-step,
    :global(.js) .trace-step .step-check {
      opacity: 1;
      transform: none;
    }
    :global(.js) .trace-question {
      clip-path: none;
    }
  }
</style>
