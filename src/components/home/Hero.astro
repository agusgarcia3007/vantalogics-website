---
import { HugeiconsIcon } from "@hugeicons/react"
import { ArrowRight01Icon } from "@hugeicons/core-free-icons"

import Cta from "@/components/site/Cta.astro"
import AgentTrace from "@/components/home/AgentTrace.astro"
import HeroMoon from "@/components/home/HeroMoon.astro"
import { useTranslations, type Lang } from "@/i18n"
import { SCHEDULE_URL } from "@/site"

interface Props {
  lang: Lang
  hasCases: boolean
}

const { lang, hasCases } = Astro.props
const t = useTranslations(lang).hero

// El titular se parte en palabras para la entrada. El texto del h1 sigue
// siendo la frase completa: los espacios quedan entre los spans.
const words = t.title.split(" ")
---

<section
  id="inicio"
  aria-labelledby="hero-title"
  class="hero relative isolate -mt-(--header-h) flex min-h-[max(720px,100svh)] flex-col overflow-hidden"
>
  <div
    class="pointer-events-none absolute inset-0 -z-20 blueprint [mask-image:radial-gradient(ellipse_90%_75%_at_60%_35%,black_30%,transparent_85%)]"
    aria-hidden="true"
  >
  </div>

  <HeroMoon />

  <!-- Oscurece el lado del texto para que la luna nunca le quite contraste. -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(90deg,var(--color-carbon)_0%,rgb(10_10_10/0.7)_38%,transparent_62%)] max-lg:bg-[linear-gradient(180deg,transparent_0%,rgb(10_10_10/0.6)_30%,var(--color-carbon)_60%)]"
    aria-hidden="true"
  >
  </div>

  <div
    class="shell flex flex-1 flex-col pt-[calc(var(--header-h)+clamp(160px,34vw,220px))] sm:pt-[calc(var(--header-h)+clamp(200px,30vw,280px))] lg:pt-[calc(var(--header-h)+96px)]"
  >
    <div
      class="grid flex-1 items-end gap-12 pb-16 lg:grid-cols-12 lg:items-center lg:gap-8 lg:pb-24"
    >
      <div class="lg:col-span-7" data-hero-copy>
        <p class="flex items-center gap-3 eyebrow text-ash" data-reveal>
          <span class="h-px w-6 bg-soft-indigo" aria-hidden="true"></span>
          {t.eyebrow}
        </p>

        <h1
          id="hero-title"
          class="hero-title mt-6 max-w-[14ch] display-xl text-bone"
          data-hero-title
        >
          {
            words.map((word, i) => (
              <>
                <span class="word">
                  <span style={`--w: ${i};`}>{word}</span>
                </span>{" "}
              </>
            ))
          }
        </h1>

        <p
          class="mt-8 max-w-[52ch] copy-lg text-ash"
          data-reveal
          style="--reveal-delay: 520ms;"
        >
          {t.lead}
        </p>

        <div
          class="mt-10 flex flex-wrap items-center gap-3"
          data-reveal
          style="--reveal-delay: 640ms;"
        >
          <Cta
            href={SCHEDULE_URL}
            variant="pill-solid"
            size="pill-lg"
            target="_blank"
            rel="noopener noreferrer"
            class="group"
          >
            {t.ctaPrimary}
            <HugeiconsIcon
              icon={ArrowRight01Icon}
              size={16}
              strokeWidth={1.8}
              className="transition-transform duration-(--duration-state) ease-(--ease-out) group-hover:translate-x-0.5"
            />
          </Cta>
          <Cta
            href={hasCases ? "#casos" : "#capacidades"}
            variant="pill"
            size="pill-lg"
          >
            {hasCases ? t.ctaSecondary : t.ctaSecondaryFallback}
          </Cta>
        </div>

        <p
          class="mt-8 flex items-center gap-3 mono-sm text-mist"
          data-reveal
          style="--reveal-delay: 760ms;"
        >
          <span class="flex gap-1" aria-hidden="true">
            <span class="size-1 rounded-full bg-mist"></span>
            <span class="size-1 rounded-full bg-mist"></span>
            <span class="size-1 rounded-full bg-soft-indigo"></span>
          </span>
          {t.note}
        </p>
      </div>

      <div class="lg:col-span-5 lg:col-start-8 lg:self-end">
        <AgentTrace
          lang={lang}
          class="mx-auto w-full max-w-[440px] lg:ms-auto lg:me-0 lg:translate-y-6"
        />
      </div>
    </div>
  </div>

  <div class="shell" aria-hidden="true">
    <div class="flex items-center justify-between border-t border-iron py-4">
      <span class="flex items-center gap-3 eyebrow text-mist">
        <span class="scroll-cue"></span>
        Scroll
      </span>
      <span class="eyebrow text-mist">EDU · AI · ENG</span>
    </div>
  </div>
</section>

<style>
  .word {
    display: inline-block;
    overflow: clip;
    overflow-clip-margin: 0.12em;
    vertical-align: top;
    padding-bottom: 0.06em;
    margin-bottom: -0.06em;
  }

  .word > span {
    display: inline-block;
  }

  :global(.js) .hero-title .word > span {
    transform: translate3d(0, 105%, 0);
    animation: rise 1.1s var(--ease-out) forwards;
    animation-delay: calc(120ms + var(--w) * 55ms);
  }

  @keyframes rise {
    to {
      transform: none;
    }
  }

  .scroll-cue {
    position: relative;
    width: 32px;
    height: 1px;
    overflow: hidden;
    background: var(--color-iron);
  }

  .scroll-cue::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--color-bone);
    transform: translateX(-100%);
    animation: cue 2.4s var(--ease-in-out) infinite;
  }

  @keyframes cue {
    to {
      transform: translateX(100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .hero-title .word > span {
      transform: none;
      animation: none;
    }
  }
</style>
