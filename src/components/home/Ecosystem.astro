---
import { useTranslations, type Lang } from "@/i18n"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang).ecosystem
---

<!-- Franja de especialización: complementa la prueba social anterior con las
     plataformas, estándares y sistemas sobre los que trabaja el estudio. -->
<section aria-labelledby="ecosistema-titulo" class="relative">
  <div class="shell">
    <div
      class="grid gap-10 border-t border-iron py-[clamp(56px,7vw,88px)] lg:grid-cols-12 lg:gap-8"
    >
      <h2
        id="ecosistema-titulo"
        class="max-w-[18ch] heading text-bone lg:col-span-4"
        data-reveal
      >
        {t.title}
      </h2>
      <p
        class="max-w-[60ch] copy text-ash lg:col-span-7 lg:col-start-6"
        data-reveal
        style="--reveal-delay: 80ms;"
      >
        {t.body}
      </p>
    </div>
  </div>

  <div class="relative border-y border-iron bg-pure-black/40">
    <p class="sr-only">{t.label}: {t.items.join(", ")}</p>
    <div class="shell">
      <p
        class="absolute top-1/2 z-10 hidden -translate-y-1/2 bg-carbon pe-6 eyebrow text-mist md:block"
      >
        {t.label}
      </p>
    </div>
    <div
      class="marquee flex overflow-hidden [mask-image:linear-gradient(90deg,transparent,black_18%,black_82%,transparent)] md:[mask-image:linear-gradient(90deg,transparent_26%,black_40%,black_88%,transparent)]"
      aria-hidden="true"
    >
      <ul class="marquee-track flex shrink-0 animate-marquee items-center">
        {
          [...t.items, ...t.items].map((item) => (
            <li class="flex items-center">
              <span class="px-8 py-6 text-[18px] font-medium tracking-[-0.4px] whitespace-nowrap text-ash">
                {item}
              </span>
              <span class="size-1 rotate-45 bg-smoke" />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-track {
    --marquee-duration: 40s;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      flex-wrap: wrap;
    }
  }
</style>
