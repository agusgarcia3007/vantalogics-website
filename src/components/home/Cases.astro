---
import { HugeiconsIcon } from "@hugeicons/react"
import { ArrowUpRight01Icon } from "@hugeicons/core-free-icons"

import Section from "@/components/home/Section.astro"
import SectionHeading from "@/components/home/SectionHeading.astro"
import { CASES } from "@/data/cases"
import { useTranslations, type Lang } from "@/i18n"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang).cases
const pick = (value: Partial<Record<Lang, string>> & { en: string }) =>
  value[lang] ?? value.en
---

{
  CASES.length > 0 && (
    <Section id="casos" labelledby="casos-titulo">
      <div class="grid gap-8 lg:grid-cols-12">
        <SectionHeading
          id="casos-titulo"
          eyebrow={t.eyebrow}
          title={t.title}
          class="lg:col-span-7"
        />
        <p
          class="max-w-[52ch] self-end copy text-ash lg:col-span-4 lg:col-start-9"
          data-reveal
        >
          {t.intro}
        </p>
      </div>

      <ol class="mt-16 flex flex-col gap-4">
        {CASES.map((study, i) => (
          <li
            class="grid gap-8 card p-6 md:p-8 lg:grid-cols-12"
            data-reveal
            style={`--reveal-delay: ${i * 80}ms;`}
          >
            <div class="lg:col-span-5">
              <p class="eyebrow text-mist">
                {t.labels.client} · {pick(study.client)}
              </p>
              <h3 class="mt-4 heading text-bone">{pick(study.title)}</h3>
              <dl class="mt-6 flex flex-col gap-4">
                <div>
                  <dt class="eyebrow text-mist">{t.labels.start}</dt>
                  <dd class="mt-1 copy text-ash">{pick(study.start)}</dd>
                </div>
                <div>
                  <dt class="eyebrow text-mist">{t.labels.built}</dt>
                  <dd class="mt-1 copy text-ash">{pick(study.built)}</dd>
                </div>
              </dl>
            </div>
            <div class="flex flex-col justify-between gap-8 lg:col-span-6 lg:col-start-7">
              <dl class="grid gap-6 sm:grid-cols-3">
                {study.metrics.map((metric) => (
                  <div class="border-t border-iron pt-4">
                    <dd class="text-[40px] leading-none font-medium tracking-[-0.84px] text-bone">
                      {metric.value}
                    </dd>
                    <dt class="mt-2 copy text-ash">{pick(metric.label)}</dt>
                  </div>
                ))}
              </dl>
              <div class="flex flex-wrap items-center justify-between gap-4">
                <p class="mono-sm text-mist">
                  {t.labels.integrations}: {study.integrations.join(" · ")} ·{" "}
                  {pick(study.period)}
                </p>
                {study.href && (
                  <a
                    href={pick(study.href)}
                    class="inline-flex items-center gap-1 label-untitled text-bone hover:text-soft-indigo"
                  >
                    {t.labels.read}
                    <HugeiconsIcon icon={ArrowUpRight01Icon} size={14} />
                  </a>
                )}
              </div>
            </div>
          </li>
        ))}
      </ol>
    </Section>
  )
}
