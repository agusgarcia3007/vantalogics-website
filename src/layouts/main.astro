---
import "@/styles/global.css"
import WhatsAppButton from "@/components/site/WhatsAppButton.astro"
import AgentButton from "@/components/site/AgentButton.astro"
import { isPublicLang, langDir, localizePath, ogImage, type Lang } from "@/i18n"
import { useTranslations } from "@/i18n"

interface Props {
  lang: Lang
  jsonLd?: unknown[]
  /** Ruta de esta página en su propio idioma. Por defecto, la portada. */
  path?: string
  title?: string
  description?: string
  image?: string
  ogType?: string
  /**
   * Rutas equivalentes por idioma. Sólo se emite `hreflang` para las que
   * existen de verdad: un alternate que devuelve 404 invalida el par entero
   * ante Google, así que un post sin traducir no declara ninguno.
   */
  alternates?: Partial<Record<Lang, string>>
}

const SITE = "https://vantalogics.com"

const {
  lang,
  jsonLd = [],
  path,
  title,
  description,
  image,
  ogType = "website",
  alternates,
} = Astro.props
const t = useTranslations(lang)

const pagePath = path ?? localizePath(lang)
const canonicalUrl = new URL(pagePath, SITE).href
const imageUrl = new URL(image ?? ogImage(lang), SITE).href
const pageTitle = title ?? t.meta.title
const pageDescription = description ?? t.meta.description

// Sólo los idiomas publicados declaran alternates; el árabe queda fuera del
// descubrimiento (ver PUBLIC_LANGS) y sus páginas salen con noindex.
const published = isPublicLang(lang)
const hreflangs = alternates ?? { es: "/", en: "/en/" }
const hreflangEntries = (Object.entries(hreflangs) as [Lang, string][]).filter(
  ([code, href]) => Boolean(href) && isPublicLang(code)
)
const xDefault = hreflangs.es ?? hreflangs.en
---

<!doctype html>
<html lang={t.htmlLang} dir={langDir(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalUrl} />

    {
      published &&
        hreflangEntries.map(([code, href]) => (
          <link
            rel="alternate"
            hreflang={code}
            href={new URL(href, SITE).href}
          />
        ))
    }
    {
      published && xDefault && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(xDefault, SITE).href}
        />
      )
    }
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`Vantalogics — ${t.blog.rssTitle}`}
      href={new URL(localizePath(lang, "/rss.xml"), SITE).href}
    />

    <!-- `js` habilita los estados iniciales de las animaciones: sin script,
         todo se ve desde el primer pintado. -->
    <script is:inline>
      document.documentElement.classList.add("js")
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta
      name="robots"
      content={published
        ? "index, follow, max-image-preview:large"
        : "noindex, follow"}
    />
    <meta name="author" content="Vantalogics" />
    <meta name="theme-color" content="#0a0a0a" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Vantalogics" />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.imageAlt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={t.meta.imageAlt} />

    {
      jsonLd.map((schema) => (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(schema)}
        />
      ))
    }
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only label-untitled focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:z-[100] focus:rounded-[8px] focus:bg-bone focus:px-4 focus:py-2 focus:text-carbon"
    >
      {t.a11y.skip}
    </a>

    <slot />

    <WhatsAppButton lang={lang} />

    <AgentButton lang={lang} />

    <script is:inline>
      // Botones flotantes: visibles después del primer pantallazo.
      ;(() => {
        const sync = () => {
          document.documentElement.toggleAttribute(
            "data-floating",
            window.scrollY > window.innerHeight * 0.7
          )
        }
        sync()
        window.addEventListener("scroll", sync, { passive: true })
      })()
    </script>

    <script is:inline>
      // Reveal al hacer scroll — una sola vez, desactivado con reduced motion.
      ;(() => {
        const nodes = document.querySelectorAll("[data-reveal]")
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)")

        if (reduced.matches || !("IntersectionObserver" in window)) {
          nodes.forEach((n) => n.setAttribute("data-revealed", ""))
          return
        }

        // Lo que ya está en pantalla se revela de entrada, sin esperar al
        // observer: el titular del hero no puede depender de un callback que
        // el navegador difiere cuando la pestaña no está enfocada.
        nodes.forEach((n) => {
          const box = n.getBoundingClientRect()
          if (box.top < window.innerHeight && box.bottom > 0) {
            n.setAttribute("data-revealed", "")
          }
        })

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return
              entry.target.setAttribute("data-revealed", "")
              io.unobserve(entry.target)
            })
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.05 }
        )

        nodes.forEach((n) => {
          if (!n.hasAttribute("data-revealed")) io.observe(n)
        })
      })()
    </script>
  </body>
</html>
