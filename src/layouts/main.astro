---
import "@/styles/global.css"
import WhatsAppButton from "@/components/site/WhatsAppButton.astro"
import AgentButton from "@/components/site/AgentButton.astro"
import { localizePath, type Lang } from "@/i18n"
import { useTranslations } from "@/i18n"

interface Props {
  lang: Lang
  jsonLd?: unknown[]
  /** Ruta de esta página en su propio idioma. Por defecto, la portada. */
  path?: string
  title?: string
  description?: string
  image?: string
  ogType?: string
  /**
   * Rutas equivalentes por idioma. Sólo se emite `hreflang` para las que
   * existen de verdad: un alternate que devuelve 404 invalida el par entero
   * ante Google, así que un post sin traducir no declara ninguno.
   */
  alternates?: Partial<Record<Lang, string>>
}

const SITE = "https://vantalogics.com"

const {
  lang,
  jsonLd = [],
  path,
  title,
  description,
  image,
  ogType = "website",
  alternates,
} = Astro.props
const t = useTranslations(lang)

const pagePath = path ?? localizePath(lang)
const canonicalUrl = new URL(pagePath, SITE).href
const imageUrl = new URL(image ?? `/og-${lang}.png`, SITE).href
const pageTitle = title ?? t.meta.title
const pageDescription = description ?? t.meta.description

const hreflangs = alternates ?? { es: "/", en: "/en/" }
const hreflangEntries = (Object.entries(hreflangs) as [Lang, string][]).filter(
  ([, href]) => Boolean(href)
)
const xDefault = hreflangs.es ?? hreflangs.en
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalUrl} />

    {
      hreflangEntries.map(([code, href]) => (
        <link rel="alternate" hreflang={code} href={new URL(href, SITE).href} />
      ))
    }
    {
      xDefault && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(xDefault, SITE).href}
        />
      )
    }
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`Vantalogics — ${t.blog.rssTitle}`}
      href={new URL(lang === "es" ? "/rss.xml" : "/en/rss.xml", SITE).href}
    />

    <!-- Tema antes del primer pintado: evita el flash de tema equivocado.
         El sistema es oscuro por defecto (design.md). -->
    <script is:inline>
      document.documentElement.classList.add("js")
      try {
        const stored = localStorage.getItem("vl-theme")
        if (stored === "light") {
          document.documentElement.setAttribute("data-theme", "light")
        }
      } catch {
        /* almacenamiento bloqueado: se queda en oscuro */
      }
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content="Vantalogics" />
    <meta name="theme-color" content="#020202" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Vantalogics" />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.imageAlt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={t.meta.imageAlt} />

    {
      jsonLd.map((schema) => (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(schema)}
        />
      ))
    }
  </head>
  <body>
    <a
      href="#contenido"
      class="label-untitled sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-pill focus:border focus:border-bone focus:bg-canvas focus:px-[15px] focus:py-[7px] focus:text-bone"
    >
      {t.a11y.skip}
    </a>

    <slot />

    <WhatsAppButton lang={lang} />

    <AgentButton lang={lang} />

    <script is:inline>
      // Reveal al hacer scroll — una sola vez, desactivado con reduced motion.
      ;(() => {
        const nodes = document.querySelectorAll("[data-reveal]")
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)")

        if (reduced.matches || !("IntersectionObserver" in window)) {
          nodes.forEach((n) => n.setAttribute("data-revealed", ""))
          return
        }

        // Lo que ya está en pantalla se revela de entrada, sin esperar al
        // observer: el titular del hero no puede depender de un callback que
        // el navegador difiere cuando la pestaña no está enfocada.
        nodes.forEach((n) => {
          const box = n.getBoundingClientRect()
          if (box.top < window.innerHeight && box.bottom > 0) {
            n.setAttribute("data-revealed", "")
          }
        })

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return
              entry.target.setAttribute("data-revealed", "")
              io.unobserve(entry.target)
            })
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.05 }
        )

        nodes.forEach((n) => {
          if (!n.hasAttribute("data-revealed")) io.observe(n)
        })
      })()
    </script>
  </body>
</html>
