{
  "name": "vantalogics-film",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "synth": "bun audio/synth.ts",
    "stills": "bun render/render.ts stills",
    "sheet": "bun render/render.ts sheet",
    "render": "bun audio/synth.ts && bun render/render.ts video --workers 3 --out out/vantalogics.mp4"
  },
  "dependencies": {
    "opentype.js": "^2.0.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/opentype.js": "^1.3.10",
    "@types/three": "0.186.0",
    "playwright-core": "1.59",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
